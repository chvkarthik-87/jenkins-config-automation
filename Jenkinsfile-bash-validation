pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        GITHUB_API = 'https://api.github.com'
        FEATURE_BRANCH = 'feature/config-update'
        MAIN_BRANCH = 'main'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'deploy-artifacts'
    }

    stages {
        stage('Checkout Feature Branch') {
            steps {
                dir('source') {
                    deleteDir()
                    git branch: 'feature/config-update',
                        url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
                }

                sh '''
                    set -eu
                    test -f source/deploy.sh
                    echo "Feature branch checkout successful."
                '''
            }
        }

        stage('Sync Main Branch') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        git config user.name "Jenkins Automation"
                        git config user.email "jenkins-automation@users.noreply.github.com"

                        git fetch origin main feature/config-update
                        git checkout feature/config-update
                        git reset --hard origin/feature/config-update

                        if git merge --no-edit origin/main; then
                            echo "Main merged without conflicts."
                        else
                            CONFLICTS=$(git diff --name-only --diff-filter=U)

                            if [ "$CONFLICTS" = "Jenkinsfile-bash-validation" ]; then
                                git checkout --ours -- Jenkinsfile-bash-validation
                                git add Jenkinsfile-bash-validation
                                git commit --no-edit
                            else
                                echo "Unexpected conflict; stopping safely."
                                printf '%s\\n' "$CONFLICTS"
                                git merge --abort || true
                                exit 1
                            fi
                        fi
                    '''
                }

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu
                            AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')

                            git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                                push origin HEAD:feature/config-update
                        '''
                    }
                }
            }
        }

        stage('Bash Syntax Validation') {
            steps {
                sh '''
                    set -eu
                    bash -n source/deploy.sh
                    echo "Bash syntax validation passed."
                '''
            }
        }

        stage('Bash Formatting Validation') {
            steps {
                sh '''
                    set -eu
                    shfmt -d source/deploy.sh
                    echo "Bash formatting validation passed."
                '''
            }
        }

        stage('Package Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p source/artifacts

                    tar -czf "source/artifacts/deploy-script-${BUILD_NUMBER}.tar.gz" \
                        -C source deploy.sh

                    cd source/artifacts
                    sha256sum "deploy-script-${BUILD_NUMBER}.tar.gz" \
                        > "deploy-script-${BUILD_NUMBER}.tar.gz.sha256"

                    ls -lh
                '''

                archiveArtifacts(
                    artifacts: 'source/artifacts/*',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        set -eu

                        ARTIFACT="source/artifacts/deploy-script-${BUILD_NUMBER}.tar.gz"
                        CHECKSUM="${ARTIFACT}.sha256"

                        test -f "$ARTIFACT"
                        test -f "$CHECKSUM"

                        curl --fail --silent --show-error \
                            --user "$NEXUS_USER:$NEXUS_PASS" \
                            --upload-file "$ARTIFACT" \
                            "$NEXUS_URL/repository/$NEXUS_REPOSITORY/deploy-script-${BUILD_NUMBER}.tar.gz"

                        curl --fail --silent --show-error \
                            --user "$NEXUS_USER:$NEXUS_PASS" \
                            --upload-file "$CHECKSUM" \
                            "$NEXUS_URL/repository/$NEXUS_REPOSITORY/deploy-script-${BUILD_NUMBER}.tar.gz.sha256"

                        echo "Artifact and checksum uploaded to Nexus."
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        RESPONSE=$(curl --fail --silent --show-error \
                            -H "Authorization: Bearer $GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            "$GITHUB_API/repos/$GITHUB_REPO/pulls?state=open&head=chvkarthik-87:$FEATURE_BRANCH&base=$MAIN_BRANCH")

                        PR_NUMBER=$(printf '%s' "$RESPONSE" | python3 -c '
import json, sys
items = json.load(sys.stdin)
print(items[0]["number"] if items else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            PAYLOAD=$(python3 -c '
import json, os
print(json.dumps({
    "title": "Bash validation and artifact packaging",
    "head": os.environ["FEATURE_BRANCH"],
    "base": os.environ["MAIN_BRANCH"],
    "body": "Jenkins validates deploy.sh, packages the artifact, and uploads it to Nexus."
}))
')

                            RESPONSE=$(curl --fail --silent --show-error \
                                -X POST \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "Content-Type: application/json" \
                                -d "$PAYLOAD" \
                                "$GITHUB_API/repos/$GITHUB_REPO/pulls")

                            PR_NUMBER=$(printf '%s' "$RESPONSE" | python3 -c '
import json, sys
print(json.load(sys.stdin)["number"])
')
                        fi

                        echo "$PR_NUMBER" > "$WORKSPACE/pr-number.txt"
                        echo "Using PR #$PR_NUMBER"
                    '''
                }
            }
        }

        stage('Merge Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(cat "$WORKSPACE/pr-number.txt")
                        PAYLOAD='{"merge_method":"squash","commit_title":"Bash validation and artifact packaging"}'

                        RESPONSE=$(curl --fail --silent --show-error \
                            -X PUT \
                            -H "Authorization: Bearer $GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            -d "$PAYLOAD" \
                            "$GITHUB_API/repos/$GITHUB_REPO/pulls/$PR_NUMBER/merge")

                        printf '%s' "$RESPONSE" | python3 -c '
import json, sys
data = json.load(sys.stdin)
if not data.get("merged"):
    raise SystemExit("GitHub did not confirm the PR merge.")
print("GitHub confirmed the PR merge.")
'
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Validation, artifact packaging, Nexus upload, and PR merge completed.'
        }

        failure {
            echo 'FAILED: Check Console Output for the failed stage.'
        }

        always {
            echo 'Jenkins pipeline finished.'
        }
    }
}
