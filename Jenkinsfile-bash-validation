pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        REPO_OWNER    = 'chvkarthik-87'
        REPO_NAME     = 'jenkins-config-automation'
        SOURCE_BRANCH = 'feature/config-update'
        TARGET_BRANCH = 'main'
        GITHUB_API    = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
    }

    stages {

        stage('Checkout Feature Branch') {
            steps {
                dir('source') {
                    deleteDir()
                    git branch: 'feature/config-update',
                        url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
                }
            }
        }

        stage('Sync Main and Auto-Resolve Known Conflict') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu

                            git config user.name "Jenkins Automation"
                            git config user.email "jenkins-automation@users.noreply.github.com"

                            echo "Fetching latest main and feature branches..."

                            git fetch origin \
                              "+refs/heads/main:refs/remotes/origin/main" \
                              "+refs/heads/feature/config-update:refs/remotes/origin/feature/config-update"

                            git checkout feature/config-update
                            git reset --hard origin/feature/config-update

                            echo "Merging main into feature branch..."

                            if git merge --no-edit origin/main; then
                                echo "Main merged without conflicts."
                            else
                                CONFLICTS=$(git diff --name-only --diff-filter=U)

                                if [ "$CONFLICTS" = "Jenkinsfile-bash-validation" ]; then
                                    echo "Known conflict detected."
                                    echo "Keeping feature branch version of Jenkinsfile-bash-validation."

                                    git checkout --ours -- Jenkinsfile-bash-validation
                                    git add Jenkinsfile-bash-validation
                                    git commit --no-edit
                                else
                                    echo "ERROR: Unexpected conflict detected:"
                                    printf '%s\\n' "$CONFLICTS"
                                    git merge --abort || true
                                    exit 1
                                fi
                            fi

                            echo "Pushing synchronized feature branch..."

                            AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')

                            git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                                push origin HEAD:feature/config-update

                            echo "Feature branch synchronized successfully."
                        '''
                    }
                }
            }
        }

        stage('Bash Syntax Validation') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        test -f deploy.sh || {
                            echo "ERROR: deploy.sh not found"
                            exit 1
                        }

                        bash -n deploy.sh
                        echo "Bash syntax validation passed."
                    '''
                }
            }
        }

        stage('Bash Formatting Validation') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        command -v shfmt >/dev/null 2>&1 || {
                            echo "ERROR: shfmt is not installed."
                            exit 1
                        }

                        shfmt -d deploy.sh
                        echo "Bash formatting validation passed."
                    '''
                }
            }
        }

        stage('Package and Archive Artifact') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        mkdir -p artifacts

                        ARTIFACT="artifacts/deploy-script-${BUILD_NUMBER}.tar.gz"

                        tar -czf "$ARTIFACT" deploy.sh
                        sha256sum "$ARTIFACT" > "${ARTIFACT}.sha256"

                        echo "Artifact created successfully:"
                        ls -lh artifacts/
                    '''
                }

                archiveArtifacts(
                    artifacts: 'source/artifacts/*',
                    fingerprint: true
                )
            }
        }

        stage('Create or Reuse GitHub PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu

                            curl -fsS \
                                -H "Accept: application/vnd.github+json" \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "$GITHUB_API/pulls?state=open&head=$REPO_OWNER:$SOURCE_BRANCH&base=$TARGET_BRANCH" \
                                -o open_prs.json

                            PR_NUMBER=$(python3 -c \
                                'import json; p=json.load(open("open_prs.json")); print(p[0]["number"] if p else "")')

                            if [ -z "$PR_NUMBER" ]; then
                                cat > pr_payload.json <<'JSON'
{
  "title": "Bash validation and artifact packaging",
  "body": "Jenkins validates Bash syntax and formatting, packages deploy.sh, archives the artifact, and merges the pull request.",
  "head": "feature/config-update",
  "base": "main"
}
JSON

                                HTTP_CODE=$(curl -sS \
                                    -o pr_response.json \
                                    -w '%{http_code}' \
                                    -X POST \
                                    -H "Accept: application/vnd.github+json" \
                                    -H "Authorization: Bearer $GH_TOKEN" \
                                    -H "X-GitHub-Api-Version: 2022-11-28" \
                                    "$GITHUB_API/pulls" \
                                    -d @pr_payload.json)

                                if [ "$HTTP_CODE" != "201" ]; then
                                    echo "ERROR: PR creation failed. HTTP $HTTP_CODE"
                                    cat pr_response.json
                                    exit 1
                                fi

                                PR_NUMBER=$(python3 -c \
                                    'import json; print(json.load(open("pr_response.json"))["number"])')

                                echo "Created PR #$PR_NUMBER"
                            else
                                echo "Reusing existing PR #$PR_NUMBER"
                            fi

                            echo "$PR_NUMBER" > pr_number.txt
                        '''

                        script {
                            env.PR_NUMBER = readFile('pr_number.txt').trim()
                        }
                    }
                }
            }
        }

        stage('Merge PR into Main') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu

                            test -n "${PR_NUMBER:-}" || {
                                echo "ERROR: PR number is missing."
                                exit 1
                            }

                            cat > merge_payload.json <<'JSON'
{
  "merge_method": "squash"
}
JSON

                            HTTP_CODE=$(curl -sS \
                                -o merge_response.json \
                                -w '%{http_code}' \
                                -X PUT \
                                -H "Accept: application/vnd.github+json" \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                                -d @merge_payload.json)

                            if [ "$HTTP_CODE" != "200" ]; then
                                echo "ERROR: GitHub merge failed. HTTP $HTTP_CODE"
                                cat merge_response.json
                                exit 1
                            fi

                            python3 -c '
import json, sys
data = json.load(open("merge_response.json"))
if data.get("merged") is not True:
    print(json.dumps(data, indent=2))
    sys.exit(1)
print("GitHub confirmed the PR merge.")
'

                            echo "PR #$PR_NUMBER merged successfully."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Validation, artifact packaging, and PR merge completed.'
        }

        failure {
            echo 'ERROR: Pipeline failed. Check the stage output.'
        }

        always {
            echo 'Bash validation pipeline finished.'
        }
    }
}
