pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        GITHUB_API = 'https://api.github.com'
        FEATURE_BRANCH = 'feature/config-update'
        MAIN_BRANCH = 'main'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'deploy-artifacts'
    }

    stages {
        stage('Checkout Feature Branch') {
            steps {
                dir('source') {
                    deleteDir()
                    git branch: 'feature/config-update',
                        url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
                }

                sh '''
                    set -eu
                    echo "Checked out feature branch."
                    git -C source status --short
                '''
            }
        }

        stage('Sync Main Branch') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        git config user.name "Jenkins Automation"
                        git config user.email "jenkins-automation@users.noreply.github.com"

                        git fetch origin main feature/config-update
                        git checkout feature/config-update
                        git reset --hard origin/feature/config-update

                        if git merge --no-edit origin/main; then
                            echo "Main branch sync successful."
                        else
                            CONFLICTS=$(git diff --name-only --diff-filter=U)

                            if [ "$CONFLICTS" = "Jenkinsfile-bash-validation" ]; then
                                git checkout --ours -- Jenkinsfile-bash-validation
                                git add Jenkinsfile-bash-validation
                                git commit --no-edit
                            else
                                echo "Unexpected merge conflict:"
                                printf '%s\\n' "$CONFLICTS"
                                git merge --abort || true
                                exit 1
                            fi
                        fi
                    '''
                }

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu
                            AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" |
                                base64 | tr -d '\\n')

                            git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                                push origin HEAD:feature/config-update
                        '''
                    }
                }
            }
        }

        stage('Identify Changed Files') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        git fetch origin main feature/config-update

                        BASE=$(git merge-base origin/main HEAD)

                        git diff --name-only "$BASE" HEAD \
                            > "$WORKSPACE/changed-files.txt"

                        echo "Changed files:"
                        cat "$WORKSPACE/changed-files.txt"
                    '''
                }
            }
        }

        stage('Validate Changed Files') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        if [ ! -s "$WORKSPACE/changed-files.txt" ]; then
                            echo "No changed files to validate."
                            exit 0
                        fi

                        FAILED=0
                        CHECKED=0

                        while IFS= read -r FILE; do
                            [ -n "$FILE" ] || continue

                            # Ignore deleted files
                            [ -f "$FILE" ] || {
                                echo "Skipping deleted/missing file: $FILE"
                                continue
                            }

                            echo "Checking: $FILE"
                            CHECKED=$((CHECKED + 1))

                            case "$FILE" in
                                *.sh)
                                    if bash -n "$FILE"; then
                                        echo "Bash syntax OK: $FILE"
                                    else
                                        echo "Bash syntax FAILED: $FILE"
                                        FAILED=1
                                    fi
                                    ;;

                                Jenkinsfile|Jenkinsfile-*|jenkinsfile)
                                    echo "Pipeline file detected: $FILE"
                                    echo "Groovy syntax validation requires a configured Groovy/Jenkins validator."
                                    ;;

                                *.json)
                                    if python3 -m json.tool "$FILE" >/dev/null; then
                                        echo "JSON syntax OK: $FILE"
                                    else
                                        echo "JSON syntax FAILED: $FILE"
                                        FAILED=1
                                    fi
                                    ;;

                                *.yaml|*.yml)
                                    if python3 -c 'import yaml' >/dev/null 2>&1; then
                                        if python3 -c 'import sys,yaml; yaml.safe_load(open(sys.argv[1]))' "$FILE"; then
                                            echo "YAML syntax OK: $FILE"
                                        else
                                            echo "YAML syntax FAILED: $FILE"
                                            FAILED=1
                                        fi
                                    else
                                        echo "ERROR: PyYAML is not installed; cannot validate $FILE"
                                        FAILED=1
                                    fi
                                    ;;

                                *.xml)
                                    if python3 -c 'import sys,xml.etree.ElementTree as E; E.parse(sys.argv[1])' "$FILE"; then
                                        echo "XML syntax OK: $FILE"
                                    else
                                        echo "XML syntax FAILED: $FILE"
                                        FAILED=1
                                    fi
                                    ;;

                                *)
                                    echo "No syntax validator configured for: $FILE"
                                    ;;
                            esac
                        done < "$WORKSPACE/changed-files.txt"

                        echo "Files inspected: $CHECKED"

                        if [ "$FAILED" -ne 0 ]; then
                            echo "One or more validations failed."
                            exit 1
                        fi

                        echo "Changed-file validation completed."
                    '''
                }
            }
        }

        stage('Package Artifact') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$WORKSPACE/artifacts"

                    tar -czf "$WORKSPACE/artifacts/changed-files-${BUILD_NUMBER}.tar.gz" \
                        -C "$WORKSPACE" changed-files.txt

                    cd "$WORKSPACE/artifacts"

                    sha256sum "changed-files-${BUILD_NUMBER}.tar.gz" \
                        > "changed-files-${BUILD_NUMBER}.tar.gz.sha256"

                    ls -lh
                '''

                archiveArtifacts(
                    artifacts: 'artifacts/*',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        set -eu

                        ARTIFACT="$WORKSPACE/artifacts/changed-files-${BUILD_NUMBER}.tar.gz"
                        CHECKSUM="${ARTIFACT}.sha256"

                        curl --fail --silent --show-error \
                            --user "$NEXUS_USER:$NEXUS_PASS" \
                            --upload-file "$ARTIFACT" \
                            "$NEXUS_URL/repository/$NEXUS_REPOSITORY/changed-files-${BUILD_NUMBER}.tar.gz"

                        curl --fail --silent --show-error \
                            --user "$NEXUS_USER:$NEXUS_PASS" \
                            --upload-file "$CHECKSUM" \
                            "$NEXUS_URL/repository/$NEXUS_REPOSITORY/changed-files-${BUILD_NUMBER}.tar.gz.sha256"

                        echo "Artifact uploaded to Nexus."
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        RESPONSE=$(curl --fail --silent --show-error \
                            -H "Authorization: Bearer $GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            "$GITHUB_API/repos/$GITHUB_REPO/pulls?state=open&head=chvkarthik-87:$FEATURE_BRANCH&base=$MAIN_BRANCH")

                        PR_NUMBER=$(printf '%s' "$RESPONSE" | python3 -c '
import json,sys
items=json.load(sys.stdin)
print(items[0]["number"] if items else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            PAYLOAD=$(python3 -c '
import json,os
print(json.dumps({
  "title":"Automated changed-file validation",
  "head":os.environ["FEATURE_BRANCH"],
  "base":os.environ["MAIN_BRANCH"],
  "body":"Created by Jenkins after changed-file validation and artifact packaging."
}))
')

                            RESPONSE=$(curl --fail --silent --show-error \
                                -X POST \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "Content-Type: application/json" \
                                -d "$PAYLOAD" \
                                "$GITHUB_API/repos/$GITHUB_REPO/pulls")

                            PR_NUMBER=$(printf '%s' "$RESPONSE" | python3 -c '
import json,sys
print(json.load(sys.stdin)["number"])
')
                        fi

                        echo "$PR_NUMBER" > "$WORKSPACE/pr-number.txt"
                        echo "Pull request: #$PR_NUMBER"
                    '''
                }
            }
        }

        stage('Merge Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(cat "$WORKSPACE/pr-number.txt")
                        PAYLOAD='{"merge_method":"squash","commit_title":"Automated validation and artifact packaging"}'

                        RESPONSE=$(curl --fail --silent --show-error \
                            -X PUT \
                            -H "Authorization: Bearer $GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            -d "$PAYLOAD" \
                            "$GITHUB_API/repos/$GITHUB_REPO/pulls/$PR_NUMBER/merge")

                        printf '%s' "$RESPONSE" | python3 -c '
import json,sys
data=json.load(sys.stdin)
if not data.get("merged"):
    raise SystemExit("GitHub did not confirm the merge.")
print("Pull request merged successfully.")
'
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Changed files validated and artifact uploaded.'
        }

        failure {
            echo 'FAILED: Check Console Output for the failing stage.'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}
