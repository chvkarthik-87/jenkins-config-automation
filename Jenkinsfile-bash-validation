pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'SOURCE_BRANCH',
            defaultValue: 'feature/config-update',
            description: 'Branch containing the changes to validate'
        )
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        MAIN_BRANCH = 'main'
        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'deploy-artifacts'
    }

    stages {

        stage('Checkout Feature Branch') {
            steps {
                deleteDir()

                git branch: "${params.SOURCE_BRANCH}",
                    credentialsId: 'github-jenkins-token',
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'

                sh '''
                    set -eu
                    git fetch origin main
                    echo "Source branch: $(git branch --show-current)"
                    echo "Latest commit: $(git rev-parse --short HEAD)"
                '''
            }
        }

        stage('Identify Changed Files') {
            steps {
                sh '''
                    set -eu

                    BASE=$(git merge-base origin/main HEAD)

                    git diff \
                        --name-only \
                        --diff-filter=ACMR \
                        "$BASE" HEAD > changed-files.txt

                    echo "Files changed compared with main:"
                    cat changed-files.txt || true

                    if [ ! -s changed-files.txt ]; then
                        echo "No changed files found."
                        echo "Nothing to validate or merge."
                        exit 1
                    fi
                '''

                archiveArtifacts(
                    artifacts: 'changed-files.txt',
                    fingerprint: true
                )
            }
        }

        stage('Validate Changed Files') {
            steps {
                sh '''
                    set -eu

                    FAILED=0
                    CHECKED=0

                    while IFS= read -r file || [ -n "$file" ]; do
                        [ -n "$file" ] || continue

                        # Deleted or unavailable files are not validated.
                        if [ ! -f "$file" ]; then
                            echo "SKIPPED (file not present): $file"
                            continue
                        fi

                        CHECKED=$((CHECKED + 1))
                        echo ""
                        echo "===================================="
                        echo "Checking: $file"
                        echo "===================================="

                        case "$file" in

                            *.sh)
                                if bash -n "$file"; then
                                    echo "VALID: Bash syntax passed: $file"
                                else
                                    echo "INVALID: Bash syntax failed: $file"
                                    FAILED=1
                                fi
                                ;;

                            Jenkinsfile|Jenkinsfile-*)
                                # Jenkins has already parsed the Jenkinsfile
                                # used to start this pipeline.
                                if [ "$file" = "Jenkinsfile-bash-validation" ]; then
                                    echo "VALID: Jenkins loaded this pipeline file."
                                elif command -v groovy >/dev/null 2>&1; then
                                    if groovy -e '
                                        new GroovyShell().parse(new File(args[0]))
                                    ' "$file"; then
                                        echo "VALID: Groovy syntax passed: $file"
                                    else
                                        echo "INVALID: Groovy syntax failed: $file"
                                        FAILED=1
                                    fi
                                else
                                    echo "INVALID: Cannot validate $file."
                                    echo "Install Groovy or configure a Jenkinsfile linter."
                                    FAILED=1
                                fi
                                ;;

                            *.groovy)
                                if command -v groovy >/dev/null 2>&1; then
                                    if groovy -e '
                                        new GroovyShell().parse(new File(args[0]))
                                    ' "$file"; then
                                        echo "VALID: Groovy syntax passed: $file"
                                    else
                                        echo "INVALID: Groovy syntax failed: $file"
                                        FAILED=1
                                    fi
                                else
                                    echo "INVALID: Groovy validator is not installed."
                                    FAILED=1
                                fi
                                ;;

                            *.json)
                                if python3 -m json.tool "$file" >/dev/null; then
                                    echo "VALID: JSON syntax passed: $file"
                                else
                                    echo "INVALID: JSON syntax failed: $file"
                                    FAILED=1
                                fi
                                ;;

                            *.yaml|*.yml)
                                if python3 -c \
                                    'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' \
                                    "$file"; then
                                    echo "VALID: YAML syntax passed: $file"
                                else
                                    echo "INVALID: YAML syntax failed, or PyYAML is missing: $file"
                                    echo "Install PyYAML on the Jenkins agent."
                                    FAILED=1
                                fi
                                ;;

                            *.xml)
                                if python3 -c \
                                    'import xml.etree.ElementTree as E,sys; E.parse(sys.argv[1])' \
                                    "$file"; then
                                    echo "VALID: XML syntax passed: $file"
                                else
                                    echo "INVALID: XML syntax failed: $file"
                                    FAILED=1
                                fi
                                ;;

                            *)
                                echo "INFO: No syntax validator configured for: $file"
                                echo "File detected; type-specific validation was not performed."
                                ;;
                        esac

                    done < changed-files.txt

                    echo ""
                    echo "Files inspected: $CHECKED"

                    if [ "$FAILED" -ne 0 ]; then
                        echo "INVALID FILES FOUND."
                        echo "ERROR: Validation failed. PR merge is blocked."
                        exit 1
                    fi

                    echo "All configured validations passed."
                '''
            }
        }

        stage('Package Artifact') {
            steps {
                sh '''
                    set -eu

                    mkdir -p artifacts

                    # Package the changed files that still exist.
                    tar -czf artifacts/changed-files.tar.gz \
                        --files-from=changed-files.txt \
                        --ignore-failed-read

                    test -s artifacts/changed-files.tar.gz
                    echo "Artifact packaged successfully."
                '''

                archiveArtifacts(
                    artifacts: 'artifacts/changed-files.tar.gz',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        ARTIFACT="artifacts/changed-files.tar.gz"
                        DEST="$NEXUS_URL/repository/$NEXUS_REPOSITORY/changed-files-${BUILD_NUMBER}.tar.gz"

                        curl --fail --show-error --silent \
                            --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                            --upload-file "$ARTIFACT" \
                            "$DEST"

                        echo "Artifact uploaded to Nexus."
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        BRANCH=$(git branch --show-current)

                        # Reuse an open PR for this source branch if present.
                        PRS=$(curl --fail --silent --show-error \
                            --user "$GH_USER:$GH_TOKEN" \
                            "https://api.github.com/repos/$GITHUB_REPO/pulls?state=open&head=$GH_USER:$BRANCH&base=$MAIN_BRANCH")

                        PR_NUMBER=$(printf '%s' "$PRS" | python3 -c '
import json,sys
items=json.load(sys.stdin)
print(items[0]["number"] if items else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            PAYLOAD=$(python3 -c '
import json,os
print(json.dumps({
    "title": "Automated validated changes - build " + os.environ["BUILD_NUMBER"],
    "head": os.environ["BRANCH"],
    "base": os.environ["MAIN_BRANCH"],
    "body": "Created automatically by Jenkins after changed-file validation."
}))
' )

                            RESPONSE=$(curl --fail --silent --show-error \
                                --user "$GH_USER:$GH_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                -H "Content-Type: application/json" \
                                -X POST \
                                -d "$PAYLOAD" \
                                "https://api.github.com/repos/$GITHUB_REPO/pulls")

                            PR_NUMBER=$(printf '%s' "$RESPONSE" | python3 -c '
import json,sys
print(json.load(sys.stdin)["number"])
')

                            echo "Created pull request #$PR_NUMBER"
                        else
                            echo "Reusing open pull request #$PR_NUMBER"
                        fi

                        echo "$PR_NUMBER" > pr-number.txt
                    '''
                }
            }
        }

        stage('Merge Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(cat pr-number.txt)

                        # Re-check the source branch after validation.
                        git fetch origin "$SOURCE_BRANCH"

                        PR_DATA=$(curl --fail --silent --show-error \
                            --user "$GH_USER:$GH_TOKEN" \
                            "https://api.github.com/repos/$GITHUB_REPO/pulls/$PR_NUMBER")

                        PR_STATE=$(printf '%s' "$PR_DATA" | python3 -c '
import json,sys
print(json.load(sys.stdin)["state"])
')

                        PR_MERGED=$(printf '%s' "$PR_DATA" | python3 -c '
import json,sys
print(str(json.load(sys.stdin)["merged"]).lower())
')

                        if [ "$PR_STATE" != "open" ]; then
                            echo "ERROR: Pull request is not open."
                            exit 1
                        fi

                        if [ "$PR_MERGED" = "true" ]; then
                            echo "Pull request is already merged."
                            exit 0
                        fi

                        PAYLOAD='{"merge_method":"squash"}'

                        RESULT=$(curl --fail --silent --show-error \
                            --user "$GH_USER:$GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "X-GitHub-Api-Version: 2022-11-28" \
                            -H "Content-Type: application/json" \
                            -X PUT \
                            -d "$PAYLOAD" \
                            "https://api.github.com/repos/$GITHUB_REPO/pulls/$PR_NUMBER/merge")

                        MERGED=$(printf '%s' "$RESULT" | python3 -c '
import json,sys
print(str(json.load(sys.stdin).get("merged",False)).lower())
')

                        if [ "$MERGED" != "true" ]; then
                            echo "ERROR: GitHub did not confirm the merge."
                            exit 1
                        fi

                        echo "SUCCESS: Pull request #$PR_NUMBER merged."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Validation, artifact upload, and PR merge stages completed.'
        }

        failure {
            echo 'FAILURE: Check Console Output. Invalid files stop the pipeline before PR creation and merge.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
