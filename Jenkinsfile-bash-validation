pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        REPO_OWNER   = 'chvkarthik-87'
        REPO_NAME    = 'jenkins-config-automation'
        SOURCE_BRANCH = 'feature/config-update'
        TARGET_BRANCH = 'main'
        GITHUB_API   = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
    }

    stages {

        stage('Checkout Feature Branch') {
            steps {
                dir('source') {
                    deleteDir()

                    git branch: 'feature/config-update',
                        url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
                }
            }
        }

        stage('Bash Syntax Validation') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        echo "Checking deploy.sh..."

                        if [ ! -f deploy.sh ]; then
                            echo "ERROR: deploy.sh not found"
                            exit 1
                        fi

                        bash -n deploy.sh

                        echo "Bash syntax validation passed."
                    '''
                }
            }
        }

        stage('Bash Formatting Validation') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        if ! command -v shfmt >/dev/null 2>&1; then
                            echo "ERROR: shfmt is not installed."
                            exit 1
                        fi

                        echo "Checking deploy.sh formatting..."

                        shfmt -d deploy.sh

                        echo "Bash formatting validation passed."
                    '''
                }
            }
        }

        stage('Package and Archive Artifact') {
            steps {
                dir('source') {
                    sh '''
                        set -eu

                        mkdir -p artifacts

                        ARTIFACT="artifacts/deploy-script-${BUILD_NUMBER}.tar.gz"

                        tar -czf "$ARTIFACT" deploy.sh

                        sha256sum "$ARTIFACT" > "${ARTIFACT}.sha256"

                        echo "Artifact created successfully:"
                        ls -lh artifacts/
                    '''
                }

                archiveArtifacts(
                    artifacts: 'source/artifacts/*',
                    fingerprint: true
                )
            }
        }

        stage('Create or Reuse GitHub PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu

                            echo "Searching for an open PR..."

                            curl -fsS \
                                -H "Accept: application/vnd.github+json" \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "$GITHUB_API/pulls?state=open&head=$REPO_OWNER:$SOURCE_BRANCH&base=$TARGET_BRANCH" \
                                -o open_prs.json

                            PR_NUMBER=$(python3 -c \
                                'import json; p=json.load(open("open_prs.json")); print(p[0]["number"] if p else "")')

                            if [ -z "$PR_NUMBER" ]; then
                                echo "Creating a new PR..."

                                cat > pr_payload.json <<'JSON'
{
  "title": "Bash validation and artifact packaging",
  "body": "Jenkins validates Bash syntax and formatting, packages deploy.sh, archives the artifact, and then merges the pull request.",
  "head": "feature/config-update",
  "base": "main"
}
JSON

                                HTTP_CODE=$(curl -sS \
                                    -o pr_response.json \
                                    -w '%{http_code}' \
                                    -X POST \
                                    -H "Accept: application/vnd.github+json" \
                                    -H "Authorization: Bearer $GH_TOKEN" \
                                    -H "X-GitHub-Api-Version: 2022-11-28" \
                                    "$GITHUB_API/pulls" \
                                    -d @pr_payload.json)

                                if [ "$HTTP_CODE" != "201" ]; then
                                    echo "ERROR: PR creation failed. HTTP $HTTP_CODE"
                                    cat pr_response.json
                                    exit 1
                                fi

                                PR_NUMBER=$(python3 -c \
                                    'import json; print(json.load(open("pr_response.json"))["number"])')

                                echo "Created PR #$PR_NUMBER"
                            else
                                echo "Reusing existing PR #$PR_NUMBER"
                            fi

                            echo "$PR_NUMBER" > pr_number.txt
                        '''

                        script {
                            env.PR_NUMBER = readFile('pr_number.txt').trim()
                        }
                    }
                }
            }
        }

        stage('Merge PR into Main') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    dir('source') {
                        sh '''
                            set -eu

                            if [ -z "${PR_NUMBER:-}" ]; then
                                echo "ERROR: PR number is missing."
                                exit 1
                            fi

                            echo "Merging PR #$PR_NUMBER..."

                            cat > merge_payload.json <<'JSON'
{
  "merge_method": "squash"
}
JSON

                            HTTP_CODE=$(curl -sS \
                                -o merge_response.json \
                                -w '%{http_code}' \
                                -X PUT \
                                -H "Accept: application/vnd.github+json" \
                                -H "Authorization: Bearer $GH_TOKEN" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                                -d @merge_payload.json)

                            if [ "$HTTP_CODE" != "200" ]; then
                                echo "ERROR: GitHub merge failed. HTTP $HTTP_CODE"
                                cat merge_response.json
                                exit 1
                            fi

                            python3 -c '
import json, sys
data = json.load(open("merge_response.json"))
if data.get("merged") is not True:
    print("GitHub did not confirm the merge.")
    print(json.dumps(data, indent=2))
    sys.exit(1)
print("GitHub confirmed the PR merge.")
'

                            echo "PR #$PR_NUMBER merged successfully."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Bash validation, artifact packaging, and PR merge completed.'
        }

        failure {
            echo 'ERROR: Pipeline failed. Check the stage output.'
        }

        always {
            echo 'Bash validation pipeline finished.'
        }
    }
}
