pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'ENVIRONMENT',
               choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Select environment')

        choice(name: 'NODE',
               choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Select node configuration')

        string(name: 'ENV_APPNAME', defaultValue: '',
               description: 'Blank = keep existing appName')

        string(name: 'ENV_VERSION', defaultValue: '',
               description: 'Blank = keep existing version; example 2.0.1')

        string(name: 'ENV_REPLICAS', defaultValue: '',
               description: 'Blank = keep existing replicas')

        choice(name: 'ENV_LOGLEVEL',
               choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
               description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: '',
               description: 'Blank = keep existing node name')

        choice(name: 'NODE_TYPE',
               choices: ['worker', 'master'],
               description: 'Node type')

        string(name: 'NODE_REGION', defaultValue: '',
               description: 'Blank = keep existing region')

        string(name: 'NODE_AZ', defaultValue: '',
               description: 'Blank = keep existing availability zone')
    }

    environment {
        GIT_REPO = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'

        GITHUB_CREDENTIALS = 'github-jenkins-token'

        SONAR_SERVER = 'SonarQube-Server'
        SONAR_SCANNER = 'SonarQube-Scanner'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        NEXUS_CREDENTIALS = 'nexus-admin-new'

        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'

        NO_CHANGES = 'false'
    }

    stages {

        stage('Checkout Main') {
            steps {
                deleteDir()

                git branch: 'main',
                    credentialsId: "${GITHUB_CREDENTIALS}",
                    url: "${GIT_REPO}"

                sh '''
                    set -eu
                    git fetch origin main
                    git checkout -B main origin/main
                    git status --short
                '''
            }
        }

        stage('Read Current Configuration') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT
                    env.SELECTED_NODE = params.NODE

                    def envFile = "environment/${params.ENVIRONMENT}.json"
                    def nodeFile = "node/${params.NODE}.json"

                    def envText = sh(
                        script: "git show origin/main:${envFile}",
                        returnStdout: true
                    ).trim()

                    def nodeText = sh(
                        script: "git show origin/main:${nodeFile}",
                        returnStdout: true
                    ).trim()

                    def currentEnv = readJSON(text: envText)
                    def currentNode = readJSON(text: nodeText)

                    env.OLD_APPNAME = currentEnv.appName.toString()
                    env.OLD_VERSION = currentEnv.version.toString()
                    env.OLD_REPLICAS = currentEnv.replicas.toString()
                    env.OLD_LOGLEVEL = currentEnv.logLevel.toString()

                    env.OLD_NODE_NAME = currentNode.name.toString()
                    env.OLD_NODE_TYPE = currentNode.type.toString()
                    env.OLD_NODE_REGION = currentNode.region.toString()
                    env.OLD_NODE_AZ = currentNode.availabilityZone.toString()

                    env.NEW_APPNAME = params.ENV_APPNAME?.trim()
                        ? params.ENV_APPNAME.trim() : env.OLD_APPNAME

                    env.NEW_VERSION = params.ENV_VERSION?.trim()
                        ? params.ENV_VERSION.trim() : env.OLD_VERSION

                    env.NEW_REPLICAS = params.ENV_REPLICAS?.trim()
                        ? params.ENV_REPLICAS.trim() : env.OLD_REPLICAS

                    // These are choice parameters, so their selected values are applied.
                    env.NEW_LOGLEVEL = params.ENV_LOGLEVEL

                    env.NEW_NODE_NAME = params.NODE_NAME?.trim()
                        ? params.NODE_NAME.trim() : env.OLD_NODE_NAME

                    env.NEW_NODE_TYPE = params.NODE_TYPE
                    env.NEW_NODE_REGION = params.NODE_REGION?.trim()
                        ? params.NODE_REGION.trim() : env.OLD_NODE_REGION

                    env.NEW_NODE_AZ = params.NODE_AZ?.trim()
                        ? params.NODE_AZ.trim() : env.OLD_NODE_AZ

                    if (!(env.NEW_VERSION ==~ /^[0-9]+\.[0-9]+\.[0-9]+$/)) {
                        error("Invalid version '${env.NEW_VERSION}'. Use format like 2.0.1")
                    }

                    if (!(env.NEW_REPLICAS ==~ /^[1-9][0-9]*$/)) {
                        error("Replicas must be a positive integer.")
                    }

                    if (!(env.NEW_LOGLEVEL in ['INFO', 'DEBUG', 'WARN', 'ERROR'])) {
                        error('Invalid log level.')
                    }

                    if (!(env.NEW_NODE_TYPE in ['worker', 'master'])) {
                        error('Invalid node type.')
                    }

                    if (!env.NEW_APPNAME?.trim() ||
                        !env.NEW_NODE_NAME?.trim() ||
                        !env.NEW_NODE_REGION?.trim() ||
                        !env.NEW_NODE_AZ?.trim()) {
                        error('App name, node name, region and availability zone cannot be empty.')
                    }

                    echo '----- CURRENT CONFIGURATION -----'
                    echo "App: ${env.OLD_APPNAME}"
                    echo "Version: ${env.OLD_VERSION}"
                    echo "Replicas: ${env.OLD_REPLICAS}"
                    echo "Log level: ${env.OLD_LOGLEVEL}"
                    echo "Node: ${env.OLD_NODE_NAME}"
                    echo "Node type: ${env.OLD_NODE_TYPE}"
                    echo "Region: ${env.OLD_NODE_REGION}"
                    echo "AZ: ${env.OLD_NODE_AZ}"

                    echo '----- CONFIGURATION TO APPLY -----'
                    echo "App: ${env.NEW_APPNAME}"
                    echo "Version: ${env.NEW_VERSION}"
                    echo "Replicas: ${env.NEW_REPLICAS}"
                    echo "Log level: ${env.NEW_LOGLEVEL}"
                    echo "Node: ${env.NEW_NODE_NAME}"
                    echo "Node type: ${env.NEW_NODE_TYPE}"
                    echo "Region: ${env.NEW_NODE_REGION}"
                    echo "AZ: ${env.NEW_NODE_AZ}"
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${env.SELECTED_ENV}-${env.SELECTED_NODE}-${env.BUILD_NUMBER}"

                    sh '''
                        set -eu
                        git checkout -b "$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "ENV_FILE=environment/${params.ENVIRONMENT}.json",
                    "NODE_FILE=node/${params.NODE}.json"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os

env_file = os.environ["ENV_FILE"]
node_file = os.environ["NODE_FILE"]

with open(env_file, "r", encoding="utf-8") as f:
    env_data = json.load(f)

with open(node_file, "r", encoding="utf-8") as f:
    node_data = json.load(f)

env_data["appName"] = os.environ["NEW_APPNAME"]
env_data["version"] = os.environ["NEW_VERSION"]
env_data["replicas"] = int(os.environ["NEW_REPLICAS"])
env_data["logLevel"] = os.environ["NEW_LOGLEVEL"]

node_data["name"] = os.environ["NEW_NODE_NAME"]
node_data["type"] = os.environ["NEW_NODE_TYPE"]
node_data["region"] = os.environ["NEW_NODE_REGION"]
node_data["availabilityZone"] = os.environ["NEW_NODE_AZ"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Environment JSON updated:", env_file)
print("Node JSON updated:", node_file)
PY

                        python3 -m json.tool "$ENV_FILE" >/dev/null
                        python3 -m json.tool "$NODE_FILE" >/dev/null

                        cat "$ENV_FILE"
                        cat "$NODE_FILE"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        withMaven(maven: 'Maven-3') {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'No pom.xml found. Maven build skipped because this repository contains JSON configuration files.'
                    }
                }
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    set -eu
                    git diff --check
                    git diff --stat
                    git diff
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    sh '''
                        set -eu
                        git add "environment/${SELECTED_ENV}.json"
                        git add "node/${SELECTED_NODE}.json"
                    '''

                    def staged = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (staged == 0) {
                        env.NO_CHANGES = 'true'
                        echo 'No JSON changes detected. PR creation and Nexus upload will be skipped.'
                    } else {
                        env.NO_CHANGES = 'false'

                        sh '''
                            set -eu
                            git config user.name "Jenkins Automation"
                            git config user.email "jenkins-automation@users.noreply.github.com"
                            git commit -m "Update ${SELECTED_ENV}/${SELECTED_NODE} configuration [build ${BUILD_NUMBER}]"
                        '''
                    }
                }
            }
        }

        stage('Push Feature Branch') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        BASIC_AUTH=$(printf '%s:%s' "$GIT_USER" "$GIT_TOKEN" | base64 | tr -d '\\n')
                        git -c http.extraheader="AUTHORIZATION: basic $BASIC_AUTH" \
                            push origin "$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Find Pull Request') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        export PR_TITLE="Config update: ${SELECTED_ENV}/${SELECTED_NODE} build ${BUILD_NUMBER}"
                        export PR_BODY="Automated configuration update from Jenkins build ${BUILD_NUMBER}."

                        python3 - <<'PY'
import json
import os
import urllib.request
import urllib.error

api = os.environ["GITHUB_API"]
token = os.environ["GITHUB_TOKEN"]
branch = os.environ["FEATURE_BRANCH"]

def request(url, method="GET", data=None):
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
    }
    body = None if data is None else json.dumps(data).encode("utf-8")
    if body is not None:
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            content = response.read().decode("utf-8")
            return response.status, json.loads(content) if content else {}
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"GitHub API error {exc.code}: {detail}")

status, prs = request(api + "/pulls?state=open&head=" +
                      os.environ.get("GITHUB_REPOSITORY_OWNER", "chvkarthik-87") +
                      ":" + branch + "&base=main")

if prs:
    pr = prs[0]
    print("Existing pull request:", pr["html_url"])
else:
    payload = {
        "title": os.environ["PR_TITLE"],
        "head": branch,
        "base": "main",
        "body": os.environ["PR_BODY"]
    }
    status, pr = request(api + "/pulls", method="POST", data=payload)
    print("Created pull request:", pr["html_url"])

with open("pr-number.txt", "w", encoding="utf-8") as f:
    f.write(str(pr["number"]))
PY
                    '''
                }

                script {
                    env.PR_NUMBER = readFile('pr-number.txt').trim()
                    echo "Pull request number: ${env.PR_NUMBER}"
                }
            }
        }

        stage('Auto Merge Pull Request') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os
import time
import urllib.request
import urllib.error

api = os.environ["GITHUB_API"]
token = os.environ["GITHUB_TOKEN"]
pr_number = os.environ["PR_NUMBER"]

def request(url, method="GET", data=None):
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
    }
    body = None if data is None else json.dumps(data).encode("utf-8")
    if body is not None:
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            content = response.read().decode("utf-8")
            return response.status, json.loads(content) if content else {}
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"GitHub API error {exc.code}: {detail}")

pr_url = api + "/pulls/" + pr_number

# Wait briefly for GitHub to calculate mergeability.
pr = {}
for attempt in range(6):
    _, pr = request(pr_url)
    if pr.get("mergeable") is not None:
        break
    time.sleep(5)

if pr.get("state") == "closed" and pr.get("merged"):
    print("Pull request is already merged.")
else:
    payload = {
        "commit_title": "Merge automated configuration update",
        "commit_message": "Merged by Jenkins build " + os.environ["BUILD_NUMBER"],
        "merge_method": "squash"
    }
    _, result = request(api + "/pulls/" + pr_number + "/merge",
                        method="PUT", data=payload)

    if not result.get("merged"):
        raise RuntimeError("GitHub did not confirm that the pull request was merged.")

    print("Pull request merged successfully.")
PY
                    '''
                }
            }
        }

        stage('Verify Main') {
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    git checkout -B main origin/main

                    echo "Verified environment configuration:"
                    git show "origin/main:environment/${SELECTED_ENV}.json"

                    echo "Verified node configuration:"
                    git show "origin/main:node/${SELECTED_NODE}.json"
                '''
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p dist

                    git show "origin/main:environment/${SELECTED_ENV}.json" \
                        > "dist/${SELECTED_ENV}.json"

                    git show "origin/main:node/${SELECTED_NODE}.json" \
                        > "dist/${SELECTED_NODE}-node.json"

                    ZIP_NAME="${ARTIFACT_ID}-${SELECTED_ENV}-${SELECTED_NODE}-${NEW_VERSION}.zip"

                    cd dist
                    zip -q "../${ZIP_NAME}" \
                        "${SELECTED_ENV}.json" \
                        "${SELECTED_NODE}-node.json"
                    cd ..

                    echo "$ZIP_NAME" > artifact-name.txt
                    ls -lh "$ZIP_NAME"
                '''
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: '*.zip',
                                 fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        ZIP_NAME=$(cat artifact-name.txt)

                        curl --fail --show-error --silent \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --request POST \
                          "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                          --form "raw.directory=${ARTIFACT_ID}/${SELECTED_ENV}" \
                          --form "raw.asset1=@${ZIP_NAME}" \
                          --form "raw.asset1.filename=${ZIP_NAME}"

                        echo "Artifact uploaded to Nexus: $ZIP_NAME"
