pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node configuration')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Application version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replica count')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        GITHUB_OWNER = 'chvkarthik-87'
        REPO_NAME = 'jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'

        SONAR_PROJECT_KEY = 'jenkins-config-automation'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        ARTIFACT_GROUP = 'com.chvkarthik.config'
        ARTIFACT_NAME = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
                sh 'git status --short'
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" fetch origin main

                        git checkout -B "$FEATURE_BRANCH" origin/main

                        git config user.name "$GH_USER"
                        git config user.email "$GH_USER@users.noreply.github.com"
                    '''
                }
            }
        }

        stage('Update Selected JSON Files') {
            steps {
                withEnv([
                    "TARGET_ENV=${params.ENVIRONMENT}",
                    "TARGET_NODE=${params.NODE}",
                    "APP_NAME_VALUE=${params.ENV_APPNAME}",
                    "APP_VERSION_VALUE=${params.ENV_VERSION}",
                    "REPLICA_VALUE=${params.ENV_REPLICAS}",
                    "LOG_LEVEL_VALUE=${params.ENV_LOGLEVEL}",
                    "NODE_NAME_VALUE=${params.NODE_NAME}",
                    "NODE_TYPE_VALUE=${params.NODE_TYPE}",
                    "NODE_REGION_VALUE=${params.NODE_REGION}",
                    "NODE_AZ_VALUE=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os
from pathlib import Path

env_name = os.environ["TARGET_ENV"]
node_name = os.environ["TARGET_NODE"]

env_file = Path("environment") / (env_name + ".json")
node_file = Path("node") / (node_name + ".json")

if not env_file.is_file():
    raise SystemExit("Missing environment file: " + str(env_file))

if not node_file.is_file():
    raise SystemExit("Missing node file: " + str(node_file))

def read_json(path):
    with path.open("r", encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict):
        raise ValueError(str(path) + " must contain a JSON object")
    return data

env_data = read_json(env_file)
node_data = read_json(node_file)

env_data["appName"] = os.environ["APP_NAME_VALUE"]
env_data["version"] = os.environ["APP_VERSION_VALUE"]
env_data["replicas"] = int(os.environ["REPLICA_VALUE"])
env_data["logLevel"] = os.environ["LOG_LEVEL_VALUE"]

node_data["name"] = os.environ["NODE_NAME_VALUE"]
node_data["type"] = os.environ["NODE_TYPE_VALUE"]
node_data["region"] = os.environ["NODE_REGION_VALUE"]
node_data["availabilityZone"] = os.environ["NODE_AZ_VALUE"]

with env_file.open("w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with node_file.open("w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
PY
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh '''
                            set -eu

                            if [ -d environment ] && [ -d node ]; then
                                '''
                        '''
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mavenHome = tool 'Maven-3'
                        withEnv(["PATH+MAVEN=${mavenHome}/bin"]) {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'No pom.xml found. Maven compilation is skipped for this JSON configuration repository.'
                    }
                }
            }
        }

        stage('Validate JSON') {
            steps {
                sh '''
                    set -eu

                    python3 - <<'PY'
import json
from pathlib import Path

files = list(Path("environment").glob("*.json"))
files += list(Path("node").glob("*.json"))

if not files:
    raise SystemExit("No JSON files found")

for path in files:
    with path.open("r", encoding="utf-8") as f:
        json.load(f)
    print("Valid JSON:", path)
PY
                '''
            }
        }

        stage('Commit and Push Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                        if ! git diff --cached --quiet; then
                            git commit -m "Update ${ENVIRONMENT} environment and ${NODE} node configuration"
                        else
                            echo "No configuration changes to commit."
                        fi

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin "HEAD:$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        API="https://api.github.com/repos/$GITHUB_OWNER/$REPO_NAME"

                        curl -fsS \
                            -u "$GH_USER:$GH_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            "$API/pulls?state=open&head=$GITHUB_OWNER:$FEATURE_BRANCH&base=main" \
                            -o pr-list.json

                        PR_NUMBER="$(python3 -c 'import json; d=json.load(open("pr-list.json")); print(d[0]["number"] if d else "")')"

                        if [ -z "$PR_NUMBER" ]; then
                            python3 - <<'PY'
import json
import os

with open("pr-create.json", "w", encoding="utf-8") as f:
    json.dump({
        "title": "Automated configuration update",
        "head": os.environ["FEATURE_BRANCH"],
        "base": "main",
        "body": "Created automatically by the Jenkins configuration pipeline."
    }, f)
PY

                            curl -fsS \
                                -u "$GH_USER:$GH_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "Content-Type: application/json" \
                                -X POST "$API/pulls" \
                                --data @pr-create.json \
                                -o pr-created.json

                            PR_NUMBER="$(python3 -c 'import json; print(json.load(open("pr-created.json"))["number"])')"
                        fi

                        echo "$PR_NUMBER" > pr-number.txt
                        echo "Pull request number: $PR_NUMBER"
                    '''
                }
            }
        }

        stage('Automatically Merge Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        API="https://api.github.com/repos/$GITHUB_OWNER/$REPO_NAME"
                        PR_NUMBER="$(cat pr-number.txt)"

                        ATTEMPT=1
                        MERGED=false

                        while [ "$ATTEMPT" -le 10 ]; do
                            curl -fsS \
                                -u "$GH_USER:$GH_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                "$API/pulls/$PR_NUMBER" \
                                -o pr-status.json

                            STATE="$(python3 -c 'import json; print(json.load(open("pr-status.json"))["state"])')"
                            ALREADY_MERGED="$(python3 -c 'import json; print(str(json.load(open("pr-status.json"))["merged"]).lower())')"
                            MERGEABLE="$(python3 -c 'import json; print(json.load(open("pr-status.json"))["mergeable"])')"

                            if [ "$ALREADY_MERGED" = "true" ]; then
                                echo "Pull request is already merged."
                                MERGED=true
                                break
                            fi

                            if [ "$STATE" != "open" ]; then
                                echo "Pull request is not open. State: $STATE"
                                exit 1
                            fi

                            if [ "$MERGEABLE" = "false" ]; then
                                echo "GitHub reports merge conflicts. Resolve them before merging."
                                exit 1
                            fi

                            if [ "$MERGEABLE" = "true" ]; then
                                HTTP_CODE="$(curl -sS \
                                    -u "$GH_USER:$GH_TOKEN" \
                                    -H "Accept: application/vnd.github+json" \
                                    -H "Content-Type: application/json" \
                                    -X PUT "$API/pulls/$PR_NUMBER/merge" \
                                    --data '{"merge_method":"squash"}' \
                                    -o merge-response.json \
                                    -w '%{http_code}')"

                                if [ "$HTTP_CODE" = "200" ]; then
                                    MERGED="$(python3 -c 'import json; print(str(json.load(open("merge-response.json")).get("merged", False)).lower())')"
                                    if [ "$MERGED" = "true" ]; then
                                        echo "Pull request merged successfully."
                                        break
                                    fi
                                fi

                                echo "Merge API HTTP status: $HTTP_CODE"
                                cat merge-response.json
                            else
                                echo "GitHub is still calculating mergeability. Attempt $ATTEMPT/10"
                            fi

                            ATTEMPT=$((ATTEMPT + 1))
                            sleep 5
                        done

                        if [ "$MERGED" != "true" ]; then
                            echo "Automatic merge did not complete."
                            echo "Check branch protection, required checks, permissions, and PR conflicts."
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Checkout Updated Main') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" fetch origin main
                        git checkout -B main origin/main

                        echo "Current main commit:"
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Package Configuration Artifact') {
            steps {
                withEnv([
                    "TARGET_ENV=${params.ENVIRONMENT}",
                    "TARGET_NODE=${params.NODE}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import os
import zipfile
from pathlib import Path

env_file = Path("environment") / (os.environ["TARGET_ENV"] + ".json")
node_file = Path("node") / (os.environ["TARGET_NODE"] + ".json")

for path in (env_file, node_file):
    if not path.is_file():
        raise SystemExit("Required file missing from main: " + str(path))

with zipfile.ZipFile("config-artifact.zip", "w", zipfile.ZIP_DEFLATED) as archive:
    archive.write(env_file, str(env_file))
    archive.write(node_file, str(node_file))

print("Created config-artifact.zip")
PY
                    '''

                    archiveArtifacts artifacts: 'config-artifact.zip', fingerprint: true
                }
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    withEnv(["UPLOAD_VERSION=${params.ENV_VERSION}-${env.BUILD_NUMBER}"]) {
                        sh '''
                            set -eu

                            curl -fsS \
                                -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                                -X POST "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                                -F "maven2.groupId=$ARTIFACT_GROUP" \
                                -F "maven2.artifactId=$ARTIFACT_NAME" \
                                -F "maven2.version=$UPLOAD_VERSION" \
                                -F "maven2.asset1=@config-artifact.zip" \
                                -F "maven2.asset1.extension=zip"

                            echo "Artifact uploaded to Nexus."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the first failed stage in Console Output.'
        }
        always {
            echo 'Jenkins pipeline finished.'
        }
    }
}
