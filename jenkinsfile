pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Application version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replica count')
        string(name: 'ENV_LOGLEVEL', defaultValue: 'INFO', description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        string(name: 'NODE_TYPE', defaultValue: 'worker', description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        REPO_URL = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'
        SONAR_PROJECT_KEY = 'jenkins-config-automation'
        NEXUS_URL = 'http://98.83.162.0:8081'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                checkout scm

                sh '''
                    set -eu
                    git branch --show-current
                    git status --short
                '''
            }
        }

        stage('Checkout Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            fetch origin main "$FEATURE_BRANCH"

                        git checkout -B "$FEATURE_BRANCH" "origin/$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Validate Parameters') {
            steps {
                sh '''
                    set -eu

                    case "$ENVIRONMENT" in
                        dev|stage|uat|prod) ;;
                        *) echo "Invalid environment"; exit 1 ;;
                    esac

                    case "$NODE" in
                        dev|stage|uat|prod) ;;
                        *) echo "Invalid node"; exit 1 ;;
                    esac

                    case "$ENV_REPLICAS" in
                        ''|*[!0-9]*)
                            echo "ENV_REPLICAS must be a number"
                            exit 1
                            ;;
                    esac

                    if [ "$ENV_REPLICAS" -lt 1 ]; then
                        echo "ENV_REPLICAS must be at least 1"
                        exit 1
                    fi

                    echo "Environment: $ENVIRONMENT"
                    echo "Node: $NODE"
                '''
            }
        }

        stage('Update Selected JSON Files') {
            steps {
                withEnv([
                    "SELECTED_ENV=${params.ENVIRONMENT}",
                    "SELECTED_NODE=${params.NODE}",
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_NODE_REGION=${params.NODE_REGION}",
                    "CONFIG_NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os
from pathlib import Path

env_name = os.environ["SELECTED_ENV"]
node_name = os.environ["SELECTED_NODE"]

env_file = Path("environment") / f"{env_name}.json"
node_file = Path("node") / f"{node_name}.json"

def update_json(path, updates):
    if not path.is_file():
        raise SystemExit(f"Required file not found: {path}")

    with path.open("r", encoding="utf-8") as f:
        data = json.load(f)

    if not isinstance(data, dict):
        raise SystemExit(f"Expected a JSON object in {path}")

    data.update(updates)

    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\\n")

update_json(env_file, {
    "appName": os.environ["APP_NAME"],
    "version": os.environ["APP_VERSION"],
    "replicas": int(os.environ["APP_REPLICAS"]),
    "logLevel": os.environ["APP_LOGLEVEL"]
})

update_json(node_file, {
    "name": os.environ["CONFIG_NODE_NAME"],
    "type": os.environ["CONFIG_NODE_TYPE"],
    "region": os.environ["CONFIG_NODE_REGION"],
    "availabilityZone": os.environ["CONFIG_NODE_AZ"]
})

print(f"Updated {env_file}")
print(f"Updated {node_file}")
PY

                        git diff -- "environment/$SELECTED_ENV.json" "node/$SELECTED_NODE.json"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        withEnv(["SONAR_SCANNER_HOME=${scannerHome}"]) {
                            sh '''
                                set -eu

                                "$SONAR_SCANNER_HOME/bin/sonar-scanner" \
                                  -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                  -Dsonar.projectName=jenkins-config-automation \
                                  -Dsonar.sources=environment,node
                            '''
                        }
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mavenHome = tool 'Maven-3'

                        withEnv(["MAVEN_HOME=${mavenHome}"]) {
                            sh '''
                                set -eu
                                "$MAVEN_HOME/bin/mvn" -B clean package -DskipTests
                            '''
                        }
                    } else {
                        echo 'No pom.xml found. Skipping Maven compilation for this configuration-only repository.'
                    }
                }
            }
        }

        stage('Validate JSON and Prepare Commit') {
            steps {
                sh '''
                    set -eu

                    python3 - <<'PY'
import json
import os
from pathlib import Path

for path in (
    Path("environment") / (os.environ["ENVIRONMENT"] + ".json"),
    Path("node") / (os.environ["NODE"] + ".json")
):
    with path.open("r", encoding="utf-8") as f:
        json.load(f)
    print(f"Valid JSON: {path}")
PY

                    git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                    if git diff --cached --quiet; then
                        echo "No configuration changes to commit."
                    else
                        git config user.name "Jenkins Automation"
                        git config user.email "jenkins-automation@users.noreply.github.com"
                        git commit -m "Update $ENVIRONMENT environment and $NODE node configuration"
                    fi
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin "HEAD:refs/heads/$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        curl -fsS \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          "$GITHUB_API/pulls?state=open&head=chvkarthik-87:$FEATURE_BRANCH&base=main" \
                          -o open_prs.json

                        python3 - <<'PY'
import json

with open("open_prs.json", encoding="utf-8") as f:
    prs = json.load(f)

if prs:
    pr = prs[0]
    with open("pr_number.txt", "w", encoding="utf-8") as f:
        f.write(str(pr["number"]))
    print(f"Reusing existing PR #{pr['number']}")
else:
    print("No open PR found. A new PR will be created.")
PY

                        if [ -s pr_number.txt ]; then
                            echo "Using existing pull request #$(cat pr_number.txt)"
                        else
                            curl -fsS \
                              -H "Authorization: Bearer $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "Content-Type: application/json" \
                              -X POST \
                              "$GITHUB_API/pulls" \
                              -d '{"title":"Automated configuration update","head":"feature/config-update","base":"main","body":"Configuration changes generated by Jenkins."}' \
                              -o pr_response.json

                            python3 - <<'PY'
import json

with open("pr_response.json", encoding="utf-8") as f:
    pr = json.load(f)

if "number" not in pr:
    raise SystemExit(f"GitHub did not return a PR number: {pr}")

with open("pr_number.txt", "w", encoding="utf-8") as f:
    f.write(str(pr["number"]))

print(f"Created PR #{pr['number']}")
PY
                        fi

                        echo "Pull request number: $(cat pr_number.txt)"
                    '''
                }
            }
        }

        stage('Automatically Merge Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(cat pr_number.txt)

                        attempt=1
                        while [ "$attempt" -le 12 ]; do
                            echo "Checking mergeability: attempt $attempt"

                            curl -fsS \
                              -H "Authorization: Bearer $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              "$GITHUB_API/pulls/$PR_NUMBER" \
                              -o pr_details.json

                            MERGEABLE=$(python3 -c 'import json; d=json.load(open("pr_details.json")); print(d.get("mergeable"))')
                            PR_STATE=$(python3 -c 'import json; d=json.load(open("pr_details.json")); print(d.get("state", ""))')
                            IS_MERGED=$(python3 -c 'import json; d=json.load(open("pr_details.json")); print(d.get("merged", False))')

                            if [ "$IS_MERGED" = "True" ] || [ "$IS_MERGED" = "true" ]; then
                                echo "PR #$PR_NUMBER is already merged."
                                exit 0
                            fi

                            if [ "$PR_STATE" != "open" ]; then
                                echo "PR #$PR_NUMBER is not open. State: $PR_STATE"
                                exit 1
                            fi

                            if [ "$MERGEABLE" != "null" ]; then
                                break
                            fi

                            sleep 5
                            attempt=$((attempt + 1))
                        done

                        curl -sS \
                          -o merge_response.json \
                          -w '%{http_code}' \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          -X PUT \
                          "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                          -d '{"merge_method":"squash"}' \
                          > merge_http_status.txt

                        HTTP_STATUS=$(cat merge_http_status.txt)

                        if [ "$HTTP_STATUS" != "200" ]; then
                            echo "GitHub merge API returned HTTP $HTTP_STATUS"
                            cat merge_response.json
                            exit 1
                        fi

                        python3 - <<'PY'
import json

with open("merge_response.json", encoding="utf-8") as f:
    result = json.load(f)

if result.get("merged") is not True:
    raise SystemExit(f"GitHub did not confirm the merge: {result}")

print("Pull request merged successfully.")
print(result.get("message", ""))
PY
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            fetch origin main

                        git checkout main
                        git reset --hard origin/main

                        echo "Latest main commit:"
                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Create and Archive Artifact') {
            steps {
                sh '''
                    set -eu

                    ARTIFACT="jenkins-config-automation-${BUILD_NUMBER}.zip"

                    if command -v zip >/dev/null 2>&1; then
                        zip -r "$ARTIFACT" environment node
                    else
                        python3 - "$ARTIFACT" <<'PY'
import os
import sys
import zipfile
from pathlib import Path

output = sys.argv[1]

with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as archive:
    for folder in ("environment", "node"):
        for path in Path(folder).rglob("*"):
            if path.is_file():
                archive.write(path, path.as_posix())

print(f"Created {output}")
PY
                    fi

                    test -s "$ARTIFACT"
                    ls -lh "$ARTIFACT"
                '''

                archiveArtifacts artifacts: 'jenkins-config-automation-*.zip', fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        ARTIFACT="jenkins-config-automation-${BUILD_NUMBER}.zip"

                        HTTP_STATUS=$(curl -sS \
                          -o nexus_response.txt \
                          -w '%{http_code}' \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -F "maven2.groupId=com.chvkarthik.config" \
                          -F "maven2.artifactId=jenkins-config-automation" \
                          -F "maven2.version=1.0.${BUILD_NUMBER}" \
                          -F "maven2.asset1=@${ARTIFACT}" \
                          -F "maven2.asset1.extension=zip" \
                          "$NEXUS_URL/service/rest/v1/components?repository=maven-releases")

                        if [ "$HTTP_STATUS" != "204" ]; then
                            echo "Nexus upload failed with HTTP $HTTP_STATUS"
                            cat nexus_response.txt
                            exit 1
                        fi

                        echo "Artifact uploaded to Nexus successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output for the first failing stage.'
        }

        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
