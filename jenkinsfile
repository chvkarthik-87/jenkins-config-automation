pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node configuration')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '', description: 'Leave blank to keep the version in the selected JSON')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Number of replicas')

        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Application log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    tools {
        maven 'Maven-3'
    }

    environment {
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        GITHUB_REPO_URL = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        FEATURE_BRANCH = 'feature/config-update'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'

        HAS_CHANGES = 'false'
    }

    stages {
        stage('Checkout Main') {
            steps {
                checkout scm

                sh '''
                    set -eu
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"
                    git fetch origin main
                    git checkout -B main origin/main
                '''
            }
        }

        stage('Read Current Version') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT
                    env.SELECTED_NODE = params.NODE

                    env.OLD_VERSION = sh(
                        script: """
                            set -eu
                            git show origin/main:environment/${params.ENVIRONMENT}.json |
                            python3 -c "import json,sys; print(json.load(sys.stdin)['version'])"
                        """,
                        returnStdout: true
                    ).trim()

                    env.NEW_VERSION = params.ENV_VERSION?.trim()
                    if (!env.NEW_VERSION) {
                        env.NEW_VERSION = env.OLD_VERSION
                    }

                    if (!(env.NEW_VERSION ==~ /[0-9A-Za-z][0-9A-Za-z._+-]*/)) {
                        error('Invalid version. Enter a valid version such as 2.3.2.')
                    }

                    if (!(params.ENV_REPLICAS ==~ /[1-9][0-9]*/)) {
                        error('ENV_REPLICAS must be a positive integer.')
                    }

                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo "Current version: ${env.OLD_VERSION}"
                    echo "Selected version: ${env.NEW_VERSION}"
                }
            }
        }

        stage('Prepare Existing Feature Branch') {
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    git fetch origin feature/config-update || true

                    if git show-ref --verify --quiet refs/remotes/origin/feature/config-update; then
                        git checkout -B feature/config-update origin/feature/config-update
                        git merge origin/main --no-edit
                    else
                        git checkout -B feature/config-update origin/main
                    fi

                    echo "Using existing branch: feature/config-update"
                '''
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${env.NEW_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_NODE_REGION=${params.NODE_REGION}",
                    "CONFIG_NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os

env_name = os.environ["SELECTED_ENV"]
node_name = os.environ["SELECTED_NODE"]

env_file = f"environment/{env_name}.json"
node_file = f"node/{node_name}.json"

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["APP_VERSION"]
env_data["replicas"] = int(os.environ["APP_REPLICAS"])
env_data["logLevel"] = os.environ["APP_LOGLEVEL"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

node_name_value = os.environ["CONFIG_NODE_NAME"]
node_type_value = os.environ["CONFIG_NODE_TYPE"]
region_value = os.environ["CONFIG_NODE_REGION"]
az_value = os.environ["CONFIG_NODE_AZ"]

node_data["nodeName"] = node_name_value
node_data["nodeType"] = node_type_value
node_data["region"] = region_value
node_data["availabilityZone"] = az_value

# Keep existing legacy aliases consistent.
node_data["name"] = node_name_value
node_data["type"] = node_type_value

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
PY

                        python3 -m json.tool "environment/$SELECTED_ENV.json" >/dev/null
                        python3 -m json.tool "node/$SELECTED_NODE.json" >/dev/null
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                sh '''
                    set -eu

                    if [ -f pom.xml ]; then
                        mvn -B clean package
                    else
                        echo "No pom.xml found; skipping Maven compilation."
                    fi
                '''
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    set -eu
                    git diff --check
                    git diff -- environment node
                '''
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    sh 'git add "environment/${SELECTED_ENV}.json" "node/${SELECTED_NODE}.json"'

                    env.HAS_CHANGES = sh(
                        script: 'git diff --cached --quiet && echo false || echo true',
                        returnStdout: true
                    ).trim()

                    echo "Configuration changes detected: ${env.HAS_CHANGES}"
                }
            }
        }

        stage('Commit Changes') {
            when {
                expression { env.HAS_CHANGES == 'true' }
            }
            steps {
                sh '''
                    set -eu
                    git commit -m "Update ${SELECTED_ENV}/${SELECTED_NODE} to ${NEW_VERSION}"
                '''
            }
        }

        stage('Push Existing Feature Branch') {
            when {
                expression { env.HAS_CHANGES == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin HEAD:refs/heads/feature/config-update

                        unset AUTH_HEADER
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            when {
                expression { env.HAS_CHANGES == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: '''
                                set +x
                                set -eu

                                curl --fail-with-body -sS \
                                  -H "Authorization: Bearer $GITHUB_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "$GITHUB_API/pulls?state=open&head=chvkarthik-87:feature/config-update&base=main" |
                                python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['number'] if d else '')"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.PR_NUMBER) {
                            writeFile(
                                file: 'pr-payload.json',
                                text: groovy.json.JsonOutput.toJson([
                                    title: "Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}",
                                    head: 'feature/config-update',
                                    base: 'main',
                                    body: "Automated configuration update from Jenkins build ${env.BUILD_NUMBER}."
                                ])
                            )

                            env.PR_NUMBER = sh(
                                script: '''
                                    set +x
                                    set -eu

                                    curl --fail-with-body -sS -X POST \
                                      -H "Authorization: Bearer $GITHUB_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "Content-Type: application/json" \
                                      "$GITHUB_API/pulls" \
                                      --data-binary @pr-payload.json |
                                    python3 -c "import json,sys; d=json.load(sys.stdin); print(d['number'])"
                                ''',
                                returnStdout: true
                            ).trim()

                            echo "Created PR #${env.PR_NUMBER}"
                        } else {
                            echo "Reusing existing PR #${env.PR_NUMBER}"
                        }
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            when {
                expression { env.HAS_CHANGES == 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        curl --fail-with-body -sS -X PUT \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                          -d '{"merge_method":"squash"}'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                sh '''
                    set -eu
                    git fetch origin main

                    git show "origin/main:environment/${SELECTED_ENV}.json"
                    git show "origin/main:node/${SELECTED_NODE}.json"
                '''
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                sh '''
                    set -eu

                    rm -rf artifact config-artifact.zip
                    mkdir -p artifact/environment artifact/node

                    git fetch origin main

                    git show "origin/main:environment/${SELECTED_ENV}.json" \
                      > "artifact/environment/${SELECTED_ENV}.json"

                    git show "origin/main:node/${SELECTED_NODE}.json" \
                      > "artifact/node/${SELECTED_NODE}.json"

                    cd artifact
                    zip -r ../config-artifact.zip .
                '''

                archiveArtifacts artifacts: 'config-artifact.zip', fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        curl --fail-with-body -sS \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                          -F "maven2.groupId=$GROUP_ID" \
                          -F "maven2.artifactId=$ARTIFACT_ID" \
                          -F "maven2.version=$NEW_VERSION" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@config-artifact.zip" \
                          -F "maven2.asset1.extension=zip"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${env.OLD_VERSION} -> ${env.NEW_VERSION}"
            echo "Branch used: ${env.FEATURE_BRANCH}"
            echo "Configuration processing completed."
        }

        failure {
            echo 'Pipeline failed. Check the first error in Console Output.'
        }

        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
