pipeline {
    agent any

    tools {
        maven 'Maven-3'
    }

    environment {
        GITHUB_REPO = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'

        SONAR_SERVER = 'SonarQube-Server'
        SONAR_SCANNER = 'SonarQube-Scanner'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"
                    git fetch origin main
                    git checkout -B main origin/main
                '''
            }
        }

        stage('Read Current Version') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT.toString()
                    env.SELECTED_NODE = params.NODE.toString()
                    env.NEW_VERSION = params.ENV_VERSION.toString()

                    def envFile = "environment/${env.SELECTED_ENV}.json"

                    def jsonText = sh(
                        script: "git show origin/main:${envFile}",
                        returnStdout: true
                    ).trim()

                    def config = new groovy.json.JsonSlurperClassic()
                        .parseText(jsonText)

                    env.OLD_VERSION = config.version.toString()

                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo "Current version: ${env.OLD_VERSION}"
                    echo "New version: ${env.NEW_VERSION}"

                    if (!env.NEW_VERSION?.trim()) {
                        error('ENV_VERSION cannot be empty.')
                    }

                    if (params.CURRENT_VERSION &&
                        params.CURRENT_VERSION.toString() != env.OLD_VERSION) {
                        error('Current version changed. Refresh Build with Parameters and try again.')
                    }
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${env.SELECTED_ENV}-${env.SELECTED_NODE}-${env.BUILD_NUMBER}"

                    sh 'git checkout -B "$FEATURE_BRANCH" origin/main'
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {
                    def envFile = "environment/${env.SELECTED_ENV}.json"
                    def nodeFile = "node/${env.SELECTED_NODE}.json"

                    def envConfig = new groovy.json.JsonSlurperClassic()
                        .parseText(readFile(envFile))

                    envConfig.appName = params.ENV_APPNAME
                    envConfig.version = env.NEW_VERSION
                    envConfig.replicas = params.ENV_REPLICAS.toInteger()
                    envConfig.logLevel = params.ENV_LOGLEVEL

                    writeFile(
                        file: envFile,
                        text: groovy.json.JsonOutput.prettyPrint(
                            groovy.json.JsonOutput.toJson(envConfig)
                        ) + '\n'
                    )

                    def nodeConfig = new groovy.json.JsonSlurperClassic()
                        .parseText(readFile(nodeFile))

                    nodeConfig.name = params.NODE_NAME
                    nodeConfig.type = params.NODE_TYPE
                    nodeConfig.region = params.NODE_REGION
                    nodeConfig.availabilityZone = params.NODE_AZ

                    writeFile(
                        file: nodeFile,
                        text: groovy.json.JsonOutput.prettyPrint(
                            groovy.json.JsonOutput.toJson(nodeConfig)
                        ) + '\n'
                    )

                    echo "Updated ${envFile}"
                    echo "Updated ${nodeFile}"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            "\${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                sh '''
                    if [ -f pom.xml ]; then
                        mvn -B clean package
                    else
                        echo "No pom.xml found; Maven compilation skipped."
                    fi
                '''
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    git diff --check
                    git diff -- environment node
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    git add "environment/${SELECTED_ENV}.json"
                    git add "node/${SELECTED_NODE}.json"

                    git commit -m "Update ${SELECTED_ENV}/${SELECTED_NODE} to ${NEW_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        git push \
                          "https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/chvkarthik-87/jenkins-config-automation.git" \
                          "$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    script {
                        def existingPr = sh(
                            script: '''
                                set +x
                                curl -fsS \
                                  -H "Authorization: Bearer $GITHUB_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "$GITHUB_API/pulls?state=open&head=chvkarthik-87:$FEATURE_BRANCH&base=main" \
                                | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['number'] if d else '')"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (existingPr) {
                            env.PR_NUMBER = existingPr
                        } else {
                            def payload = [
                                title: "Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}",
                                head: env.FEATURE_BRANCH,
                                base: 'main',
                                body: "Automated configuration update from Jenkins build ${env.BUILD_NUMBER}."
                            ]

                            writeFile(
                                file: 'pr-payload.json',
                                text: groovy.json.JsonOutput.toJson(payload)
                            )

                            env.PR_NUMBER = sh(
                                script: '''
                                    set +x
                                    curl -fsS -X POST \
                                      -H "Authorization: Bearer $GITHUB_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "Content-Type: application/json" \
                                      "$GITHUB_API/pulls" \
                                      --data-binary @pr-payload.json \
                                    | python3 -c "import json,sys; print(json.load(sys.stdin)['number'])"
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        echo "Pull request: #${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        curl -fsS -X PUT \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                          -d '{"merge_method":"squash"}'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                sh '''
                    git fetch origin main
                    git checkout -B verify-main origin/main

                    echo "Updated environment configuration:"
                    git show "origin/main:environment/${SELECTED_ENV}.json"

                    echo "Updated node configuration:"
                    git show "origin/main:node/${SELECTED_NODE}.json"
                '''
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                sh '''
                    rm -rf artifact
                    mkdir -p artifact/environment artifact/node

                    git show "origin/main:environment/${SELECTED_ENV}.json" \
                      > "artifact/environment/${SELECTED_ENV}.json"

                    git show "origin/main:node/${SELECTED_NODE}.json" \
                      > "artifact/node/${SELECTED_NODE}.json"

                    cd artifact
                    zip -r ../config-artifact.zip .
                    cd ..
                '''

                archiveArtifacts(
                    artifacts: 'config-artifact.zip',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        curl -fsS \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                          -F "maven2.groupId=$GROUP_ID" \
                          -F "maven2.artifactId=$ARTIFACT_ID" \
                          -F "maven2.version=$NEW_VERSION" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@config-artifact.zip" \
                          -F "maven2.asset1.extension=zip"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${env.OLD_VERSION} -> ${env.NEW_VERSION}"
            echo "Environment: ${env.SELECTED_ENV}"
            echo "Node: ${env.SELECTED_NODE}"
            echo 'GitHub merge, configuration artifact and Nexus upload completed.'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output for the exact failing stage.'
        }

        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
