pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Select node configuration')
        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '1.1.0', description: 'Version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replicas')
        string(name: 'ENV_LOGLEVEL', defaultValue: 'INFO', description: 'Log level')
        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        string(name: 'NODE_TYPE', defaultValue: 'worker', description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'Node region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        GITHUB_OWNER = 'chvkarthik-87'
        REPO_NAME = 'jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'

        SONARQUBE_SERVER = 'SonarQube-Server'
        SONAR_SCANNER = 'SonarQube-Scanner'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'

                sh 'git status --short --branch'
            }
        }

        stage('Update and Validate JSON') {
            steps {
                withEnv([
                    "APP_ENV=${params.ENVIRONMENT}",
                    "APP_NODE=${params.NODE}",
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_NODE_REGION=${params.NODE_REGION}",
                    "CONFIG_NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os

env_file = f"environment/{os.environ['APP_ENV']}.json"
node_file = f"node/{os.environ['APP_NODE']}.json"

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["APP_VERSION"]
env_data["replicas"] = int(os.environ["APP_REPLICAS"])
env_data["logLevel"] = os.environ["APP_LOGLEVEL"]

node_data["name"] = os.environ["CONFIG_NODE_NAME"]
node_data["type"] = os.environ["CONFIG_NODE_TYPE"]
node_data["region"] = os.environ["CONFIG_NODE_REGION"]
node_data["availabilityZone"] = os.environ["CONFIG_NODE_AZ"]

for path, data in ((env_file, env_data), (node_file, node_data)):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\\n")

    with open(path, encoding="utf-8") as f:
        json.load(f)

    print("Validated:", path)

print("Requested version:", env_data["version"])
PY
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: "${SONAR_SCANNER}",
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv("${SONARQUBE_SERVER}") {
                        sh """
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node
                        """
                    }
                }
            }
        }

        stage('Maven Build') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mvnHome = tool 'Maven-3'
                        sh "\"${mvnHome}/bin/mvn\" -B clean package"
                    } else {
                        echo 'No pom.xml found. Maven build skipped.'
                    }
                }
            }
        }

        stage('Update Existing Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@example.com"

                        # Save the updated files before changing branches.
                        TMP_DIR="$(mktemp -d)"
                        trap 'rm -rf "$TMP_DIR"' EXIT

                        cp "environment/$ENVIRONMENT.json" "$TMP_DIR/environment.json"
                        cp "node/$NODE.json" "$TMP_DIR/node.json"

                        # Remove local edits that were made on main.
                        git restore -- "environment/$ENVIRONMENT.json" "node/$NODE.json"

                        # Require the existing remote feature branch.
                        git fetch origin main
                        git fetch origin \
                          "+refs/heads/$FEATURE_BRANCH:refs/remotes/origin/$FEATURE_BRANCH"

                        # Remember the remote SHA for safe force-push.
                        OLD_FEATURE_SHA="$(git rev-parse "refs/remotes/origin/$FEATURE_BRANCH")"

                        # Reuse the same branch name, based on current main.
                        git checkout -B "$FEATURE_BRANCH" origin/main

                        cp "$TMP_DIR/environment.json" "environment/$ENVIRONMENT.json"
                        cp "$TMP_DIR/node.json" "node/$NODE.json"

                        git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                        if git diff --cached --quiet; then
                            echo "No configuration changes required."
                            echo false > .config-changes
                        else
                            git commit -m "Update $ENVIRONMENT/$NODE configuration to $ENV_VERSION"
                            echo true > .config-changes

                            AUTH="$(printf '%s:%s' "$GIT_USER" "$GIT_TOKEN" | base64 | tr -d '\\n')"

                            # Update the existing remote branch, not a new branch.
                            git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                              push "--force-with-lease=refs/heads/$FEATURE_BRANCH:$OLD_FEATURE_SHA" \
                              origin "HEAD:refs/heads/$FEATURE_BRANCH"
                        fi
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            when {
                expression {
                    fileExists('.config-changes') &&
                    readFile('.config-changes').trim() == 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        export GH_OWNER="$GITHUB_OWNER"
                        export GH_REPO="$REPO_NAME"
                        export GH_BRANCH="$FEATURE_BRANCH"

                        python3 - <<'PY'
import json
import os
import urllib.request
import urllib.error
import urllib.parse

owner = os.environ["GH_OWNER"]
repo = os.environ["GH_REPO"]
branch = os.environ["GH_BRANCH"]
token = os.environ["GH_TOKEN"]
api = f"https://api.github.com/repos/{owner}/{repo}"

def request(path, method="GET", payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        api + path,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            body = response.read().decode()
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        raise RuntimeError(
            f"GitHub API {method} failed: {e.code} {e.read().decode()}"
        )

query = urllib.parse.urlencode({
    "state": "open",
    "head": f"{owner}:{branch}",
    "base": "main"
})
prs = request(f"/pulls?{query}")

if prs:
    pr = prs[0]
    print("Using existing open PR:", pr["html_url"])
else:
    pr = request("/pulls", "POST", {
        "title": f"Update configuration from {branch}",
        "head": branch,
        "base": "main",
        "body": "Automatically created by Jenkins."
    })
    print("Created PR:", pr["html_url"])

with open("pr-number.txt", "w") as f:
    f.write(str(pr["number"]))

print("PR number:", pr["number"])
PY
                    '''
                }
            }
        }

        stage('Automatically Merge PR') {
            when {
                expression {
                    fileExists('.config-changes') &&
                    readFile('.config-changes').trim() == 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        export GH_OWNER="$GITHUB_OWNER"
                        export GH_REPO="$REPO_NAME"

                        python3 - <<'PY'
import json
import os
import time
import urllib.request
import urllib.error

owner = os.environ["GH_OWNER"]
repo = os.environ["GH_REPO"]
token = os.environ["GH_TOKEN"]
api = f"https://api.github.com/repos/{owner}/{repo}"

with open("pr-number.txt") as f:
    number = f.read().strip()

def request(path, method="GET", payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        api + path,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            body = response.read().decode()
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        raise RuntimeError(
            f"GitHub API {method} failed: {e.code} {e.read().decode()}"
        )

pr = {}
for attempt in range(12):
    pr = request(f"/pulls/{number}")

    if pr.get("state") == "closed" and pr.get("merged"):
        print("PR was already merged.")
        break

    if pr.get("mergeable") is not None:
        break

    time.sleep(5)
else:
    raise RuntimeError("GitHub did not finish calculating PR mergeability.")

if pr.get("state") == "closed" and pr.get("merged"):
    pass
elif pr.get("mergeable") is False:
    raise RuntimeError("PR has merge conflicts. Automatic merge stopped.")
else:
    result = request(
        f"/pulls/{number}/merge",
        "PUT",
        {
            "commit_title": f"Merge {pr['head']['ref']} into main",
            "commit_message": "Automatically merged by Jenkins",
            "merge_method": "squash"
        }
    )

    if result.get("merged") is not True:
        raise RuntimeError(f"GitHub did not confirm merge: {result}")

    print("PR successfully merged:", number)
PY
                    '''
                }
            }
        }

        stage('Verify Main Version') {
            steps {
                deleteDir()
                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'

                withEnv([
                    "VERIFY_ENV=${params.ENVIRONMENT}",
                    "EXPECTED_VERSION=${params.ENV_VERSION}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os

path = f"environment/{os.environ['VERIFY_ENV']}.json"

with open(path, encoding="utf-8") as f:
    data = json.load(f)

actual = str(data.get("version", ""))
expected = os.environ["EXPECTED_VERSION"]

print("Main branch version:", actual)
print("Expected version:", expected)

if actual != expected:
    raise SystemExit(
        f"VERSION MISMATCH: expected {expected}, found {actual}"
    )

print("SUCCESS: main has the requested version.")
PY
                    '''
                }
            }
        }

        stage('Package Artifact') {
            steps {
                withEnv(["ARTIFACT_VERSION=${params.ENV_VERSION}"]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import os
import zipfile

version = os.environ["ARTIFACT_VERSION"]
artifact = f"config-artifact-{version}.zip"

with zipfile.ZipFile(artifact, "w", zipfile.ZIP_DEFLATED) as z:
    for folder in ("environment", "node"):
        for name in sorted(os.listdir(folder)):
            if name.endswith(".json"):
                path = os.path.join(folder, name)
                z.write(path, path)

print("Created:", artifact)
PY
                    '''
                }

                archiveArtifacts(
                    artifacts: "config-artifact-${params.ENV_VERSION}.zip",
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withEnv(["ARTIFACT_VERSION=${params.ENV_VERSION}"]) {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        sh '''
                            set -eu

                            ARTIFACT="config-artifact-${ARTIFACT_VERSION}.zip"
                            test -f "$ARTIFACT"

                            curl --fail --show-error --silent \
                              -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                              --upload-file "$ARTIFACT" \
                              "$NEXUS_URL/repository/$NEXUS_REPOSITORY/com/chvkarthik/config-artifact/$ARTIFACT_VERSION/$ARTIFACT"

                            echo "Artifact uploaded to Nexus."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Pipeline completed and main version was verified.'
        }
        failure {
            echo 'FAILED: Read the first ERROR in Console Output. Do not assume the merge succeeded.'
        }
        always {
            echo "Finished build ${env.BUILD_NUMBER}"
        }
    }
}
