pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node configuration')

        string(name: 'ENV_APPNAME', defaultValue: '', description: 'New app name; blank = current value')
        string(name: 'ENV_VERSION', defaultValue: '', description: 'New version; blank = current version')
        string(name: 'ENV_REPLICAS', defaultValue: '', description: 'New replicas; blank = current value')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Application log level')

        string(name: 'NODE_NAME', defaultValue: '', description: 'New node name; blank = current value')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: '', description: 'New region; blank = current value')
        string(name: 'NODE_AZ', defaultValue: '', description: 'New availability zone; blank = current value')
    }

    tools {
        maven 'Maven-3'
    }

    environment {
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'
        NO_CHANGES = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"
                    git fetch origin main
                    git checkout -B main origin/main
                '''
            }
        }

        stage('Read Current Configuration') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT.toString().trim()
                    env.SELECTED_NODE = params.NODE.toString().trim()

                    if (!(env.SELECTED_ENV in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid environment selected')
                    }
                    if (!(env.SELECTED_NODE in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid node selected')
                    }

                    def envJson = readJSON text: sh(
                        script: "git show origin/main:environment/${env.SELECTED_ENV}.json",
                        returnStdout: true
                    ).trim()

                    def nodeJson = readJSON text: sh(
                        script: "git show origin/main:node/${env.SELECTED_NODE}.json",
                        returnStdout: true
                    ).trim()

                    env.OLD_APPNAME = envJson.appName.toString()
                    env.OLD_VERSION = envJson.version.toString().trim()
                    env.OLD_REPLICAS = envJson.replicas.toString()
                    env.OLD_LOGLEVEL = envJson.logLevel.toString()

                    env.OLD_NODE_NAME = nodeJson.name.toString()
                    env.OLD_NODE_TYPE = nodeJson.type.toString()
                    env.OLD_NODE_REGION = nodeJson.region.toString()
                    env.OLD_NODE_AZ = nodeJson.availabilityZone.toString()

                    // Blank text parameters use the current JSON values.
                    env.NEW_APPNAME = params.ENV_APPNAME?.trim() ?
                        params.ENV_APPNAME.trim() : env.OLD_APPNAME

                    env.NEW_VERSION = params.ENV_VERSION?.trim() ?
                        params.ENV_VERSION.trim() : env.OLD_VERSION

                    env.NEW_REPLICAS = params.ENV_REPLICAS?.trim() ?
                        params.ENV_REPLICAS.trim() : env.OLD_REPLICAS

                    env.NEW_NODE_NAME = params.NODE_NAME?.trim() ?
                        params.NODE_NAME.trim() : env.OLD_NODE_NAME

                    env.NEW_NODE_REGION = params.NODE_REGION?.trim() ?
                        params.NODE_REGION.trim() : env.OLD_NODE_REGION

                    env.NEW_NODE_AZ = params.NODE_AZ?.trim() ?
                        params.NODE_AZ.trim() : env.OLD_NODE_AZ

                    // Choice parameters always have a selected value.
                    env.NEW_LOGLEVEL = params.ENV_LOGLEVEL.toString().trim()
                    env.NEW_NODE_TYPE = params.NODE_TYPE.toString().trim()

                    // Final version fallback and validation.
                    env.NEW_VERSION = (env.NEW_VERSION ?: '').trim()
                    if (!env.NEW_VERSION) {
                        env.NEW_VERSION = env.OLD_VERSION
                    }

                    if (!(env.NEW_VERSION ==~ /^\d+\.\d+\.\d+$/)) {
                        error("Invalid version '${env.NEW_VERSION}'. Current version is '${env.OLD_VERSION}'. Use X.Y.Z format, e.g. 2.1.0.")
                    }

                    if (!(env.NEW_REPLICAS ==~ /^\d+$/) ||
                        env.NEW_REPLICAS.toInteger() < 1) {
                        error('Replicas must be a whole number greater than zero')
                    }

                    if (!(env.NEW_LOGLEVEL in ['INFO', 'DEBUG', 'WARN', 'ERROR'])) {
                        error('Invalid log level')
                    }
                    if (!(env.NEW_NODE_TYPE in ['worker', 'master'])) {
                        error('Invalid node type')
                    }

                    echo '========== CURRENT CONFIGURATION =========='
                    echo "Application: ${env.OLD_APPNAME}"
                    echo "Version: ${env.OLD_VERSION}"
                    echo "Replicas: ${env.OLD_REPLICAS}"
                    echo "Log level: ${env.OLD_LOGLEVEL}"
                    echo "Node name: ${env.OLD_NODE_NAME}"
                    echo "Node type: ${env.OLD_NODE_TYPE}"
                    echo "Region: ${env.OLD_NODE_REGION}"
                    echo "Availability zone: ${env.OLD_NODE_AZ}"

                    echo '========== CONFIGURATION TO APPLY =========='
                    echo "Application: ${env.NEW_APPNAME}"
                    echo "Version: ${env.NEW_VERSION}"
                    echo "Replicas: ${env.NEW_REPLICAS}"
                    echo "Log level: ${env.NEW_LOGLEVEL}"
                    echo "Node name: ${env.NEW_NODE_NAME}"
                    echo "Node type: ${env.NEW_NODE_TYPE}"
                    echo "Region: ${env.NEW_NODE_REGION}"
                    echo "Availability zone: ${env.NEW_NODE_AZ}"
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${env.SELECTED_ENV}-${env.SELECTED_NODE}-${env.BUILD_NUMBER}"
                }
                sh 'git checkout -B "$FEATURE_BRANCH" origin/main'
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "APP_NAME=${env.NEW_APPNAME}",
                    "APP_VERSION=${env.NEW_VERSION}",
                    "APP_REPLICAS=${env.NEW_REPLICAS}",
                    "APP_LOGLEVEL=${env.NEW_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${env.NEW_NODE_NAME}",
                    "CONFIG_NODE_TYPE=${env.NEW_NODE_TYPE}",
                    "CONFIG_NODE_REGION=${env.NEW_NODE_REGION}",
                    "CONFIG_NODE_AZ=${env.NEW_NODE_AZ}"
                ]) {
                    sh '''
                        set -eu
                        python3 - <<'PY'
import json, os

env_name = os.environ["SELECTED_ENV"]
node_name = os.environ["SELECTED_NODE"]

env_file = f"environment/{env_name}.json"
node_file = f"node/{node_name}.json"

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["APP_VERSION"]
env_data["replicas"] = int(os.environ["APP_REPLICAS"])
env_data["logLevel"] = os.environ["APP_LOGLEVEL"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

node_data["name"] = os.environ["CONFIG_NODE_NAME"]
node_data["type"] = os.environ["CONFIG_NODE_TYPE"]
node_data["region"] = os.environ["CONFIG_NODE_REGION"]
node_data["availabilityZone"] = os.environ["CONFIG_NODE_AZ"]

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
PY
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'
                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "\${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                sh '''
                    set -eu
                    if [ -f pom.xml ]; then
                        mvn -B clean package
                    else
                        echo "No pom.xml found; Maven compilation skipped."
                    fi
                '''
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    set -eu
                    git diff --check
                    git diff -- environment node
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    sh '''
                        set -eu
                        git add "environment/${SELECTED_ENV}.json"
                        git add "node/${SELECTED_NODE}.json"
                    '''

                    int diffStatus = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (diffStatus == 0) {
                        env.NO_CHANGES = 'true'
                        echo 'No configuration changes detected. Existing configuration will remain unchanged.'
                    } else if (diffStatus == 1) {
                        sh "git commit -m 'Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}'"
                    } else {
                        error('Unable to check staged changes')
                    }
                }
            }
        }

        stage('Push Feature Branch') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GITHUB_USER',
                    passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        git push "https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/chvkarthik-87/jenkins-config-automation.git" "$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GITHUB_USER',
                    passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: '''
                                set -eu
                                set +x
                                curl -fsS \
                                  -H "Authorization: Bearer $GITHUB_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "$GITHUB_API/pulls?state=open&head=chvkarthik-87:$FEATURE_BRANCH&base=main" |
                                python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['number'] if d else '')"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.PR_NUMBER) {
                            withEnv([
                                "PR_TITLE=Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}",
                                "PR_BRANCH=${env.FEATURE_BRANCH}",
                                "PR_BUILD=${env.BUILD_NUMBER}"
                            ]) {
                                sh '''
                                    set -eu
                                    python3 - <<'PY'
import json, os

payload = {
    "title": os.environ["PR_TITLE"],
    "head": os.environ["PR_BRANCH"],
    "base": "main",
    "body": "Automated configuration update from Jenkins build " + os.environ["PR_BUILD"]
}

with open("pr-payload.json", "w", encoding="utf-8") as f:
    json.dump(payload, f)
PY
                                '''

                                env.PR_NUMBER = sh(
                                    script: '''
                                        set -eu
                                        set +x
                                        curl -fsS -X POST \
                                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                                          -H "Accept: application/vnd.github+json" \
                                          -H "Content-Type: application/json" \
                                          "$GITHUB_API/pulls" \
                                          --data-binary @pr-payload.json |
                                        python3 -c "import json,sys; print(json.load(sys.stdin)['number'])"
                                    ''',
                                    returnStdout: true
                                ).trim()
                            }
                        }

                        echo "Pull request number: ${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GITHUB_USER',
                    passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        curl -fsS -X PUT \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                          -d '{"merge_method":"squash"}'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    git show "origin/main:environment/${SELECTED_ENV}.json"
                    git show "origin/main:node/${SELECTED_NODE}.json"
                '''
            }
        }

        stage('Create ZIP Artifact') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    rm -rf artifact config-artifact.zip
                    mkdir -p artifact/environment artifact/node

                    git show "origin/main:environment/${SELECTED_ENV}.json" \
                      > "artifact/environment/${SELECTED_ENV}.json"

                    git show "origin/main:node/${SELECTED_NODE}.json" \
                      > "artifact/node/${SELECTED_NODE}.json"

                    cd artifact
                    zip -r ../config-artifact.zip .
                '''
                archiveArtifacts artifacts: 'config-artifact.zip', fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        curl -fsS \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                          -F "maven2.groupId=$GROUP_ID" \
                          -F "maven2.artifactId=$ARTIFACT_ID" \
                          -F "maven2.version=$NEW_VERSION" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@config-artifact.zip" \
                          -F "maven2.asset1.extension=zip"
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.NO_CHANGES == 'true') {
                    echo 'SUCCESS: No configuration changes. Existing GitHub configuration remains unchanged.'
                } else {
                    echo "SUCCESS: ${env.OLD_VERSION} -> ${env.NEW_VERSION}"
                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo 'Configuration merged and artifact uploaded.'
                }
            }
        }

        failure {
            echo 'Pipeline failed. Check the first ERROR in Console Output.'
        }

        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
