pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Environment JSON to update')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Node JSON to update')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Application version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Number of replicas')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        REPO_URL       = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API     = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        GITHUB_OWNER   = 'chvkarthik-87'
        FEATURE_BRANCH = 'feature/config-update'

        SONAR_PROJECT_KEY = 'jenkins-config-automation'
        SONAR_SERVER      = 'SonarQube-Server'
        SONAR_SCANNER     = 'SonarQube-Scanner'

        NEXUS_URL       = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        ARTIFACT_GROUP   = 'com.chvkarthik.config'
        ARTIFACT_ID      = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main', url: "${env.REPO_URL}"

                sh '''
                    set -eu
                    echo "Repository checked out."
                    git log -1 --oneline
                '''
            }
        }

        stage('Checkout Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c "http.extraheader=AUTHORIZATION: basic $AUTH_HEADER" \
                            fetch origin main "$FEATURE_BRANCH"

                        git checkout -B "$FEATURE_BRANCH" "origin/$FEATURE_BRANCH"

                        echo "Working branch:"
                        git branch --show-current
                    '''
                }
            }
        }

        stage('Validate Parameters') {
            steps {
                sh '''
                    set -eu

                    case "$ENVIRONMENT" in
                        dev|stage|uat|prod) ;;
                        *) echo "Invalid environment"; exit 1 ;;
                    esac

                    case "$NODE" in
                        dev|stage|uat|prod) ;;
                        *) echo "Invalid node"; exit 1 ;;
                    esac

                    case "$ENV_LOGLEVEL" in
                        INFO|DEBUG|WARN|ERROR) ;;
                        *) echo "Invalid log level"; exit 1 ;;
                    esac

                    case "$NODE_TYPE" in
                        worker|master) ;;
                        *) echo "Invalid node type"; exit 1 ;;
                    esac

                    case "$ENV_REPLICAS" in
                        ''|*[!0-9]*) echo "Replicas must be a positive integer"; exit 1 ;;
                    esac

                    if [ "$ENV_REPLICAS" -lt 1 ]; then
                        echo "Replicas must be at least 1"
                        exit 1
                    fi

                    echo "Environment: $ENVIRONMENT"
                    echo "Node: $NODE"
                '''
            }
        }

        stage('Update Selected JSON Files') {
            steps {
                withEnv([
                    "ENV_APPNAME=${params.ENV_APPNAME}",
                    "ENV_VERSION=${params.ENV_VERSION}",
                    "ENV_REPLICAS=${params.ENV_REPLICAS}",
                    "ENV_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "NODE_NAME=${params.NODE_NAME}",
                    "NODE_TYPE=${params.NODE_TYPE}",
                    "NODE_REGION=${params.NODE_REGION}",
                    "NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os
from pathlib import Path

env_name = os.environ["ENVIRONMENT"]
node_name = os.environ["NODE"]

env_path = Path("environment") / f"{env_name}.json"
node_path = Path("node") / f"{node_name}.json"

if not env_path.is_file():
    raise SystemExit(f"Missing file: {env_path}")

if not node_path.is_file():
    raise SystemExit(f"Missing file: {node_path}")

with env_path.open(encoding="utf-8") as f:
    env_data = json.load(f)

env_data["environment"] = env_name
env_data["appName"] = os.environ["ENV_APPNAME"]
env_data["version"] = os.environ["ENV_VERSION"]
env_data["replicas"] = int(os.environ["ENV_REPLICAS"])
env_data["logLevel"] = os.environ["ENV_LOGLEVEL"]

with env_path.open("w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with node_path.open(encoding="utf-8") as f:
    node_data = json.load(f)

node_data["environment"] = node_name
node_data["nodeName"] = os.environ["NODE_NAME"]
node_data["nodeType"] = os.environ["NODE_TYPE"]
node_data["region"] = os.environ["NODE_REGION"]
node_data["availabilityZone"] = os.environ["NODE_AZ"]

# Keep the existing node configuration and update related fields.
node_data["name"] = os.environ["NODE_NAME"]
node_data["type"] = os.environ["NODE_TYPE"]

if isinstance(node_data.get("labels"), dict):
    node_data["labels"]["environment"] = node_name

if isinstance(node_data.get("kubernetes"), dict):
    node_data["kubernetes"]["role"] = os.environ["NODE_TYPE"]

with node_path.open("w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print(f"Updated {env_path}")
print(f"Updated {node_path}")
PY

                        echo "Selected configuration changes:"
                        git diff -- "environment/$ENVIRONMENT.json" "node/$NODE.json"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool name: env.SONAR_SCANNER,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'

                    withSonarQubeEnv(env.SONAR_SERVER) {
                        withEnv(["SCANNER_HOME=${scannerHome}"]) {
                            sh '''
                                set -eu

                                "$SCANNER_HOME/bin/sonar-scanner" \
                                  "-Dsonar.projectKey=$SONAR_PROJECT_KEY" \
                                  "-Dsonar.projectName=$SONAR_PROJECT_KEY" \
                                  "-Dsonar.sources=environment,node"
                            '''
                        }
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mavenHome = tool name: 'Maven-3', type: 'hudson.tasks.Maven$MavenInstallation'

                        withEnv(["PATH+MAVEN=${mavenHome}/bin"]) {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'No pom.xml found. Skipping Maven for this JSON configuration repository.'
                    }
                }
            }
        }

        stage('Validate JSON and Commit') {
            steps {
                sh '''
                    set -eu

                    python3 - <<'PY'
import json
import os
from pathlib import Path

files = [
    Path("environment") / f'{os.environ["ENVIRONMENT"]}.json',
    Path("node") / f'{os.environ["NODE"]}.json'
]

for path in files:
    with path.open(encoding="utf-8") as f:
        json.load(f)
    print(f"Valid JSON: {path}")
PY

                    git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                    if git diff --cached --quiet; then
                        echo "No changes to commit."
                    else
                        git config user.name "Jenkins Automation"
                        git config user.email "jenkins-automation@users.noreply.github.com"

                        git commit -m "Update $ENVIRONMENT environment and $NODE node configuration"
                    fi
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        AUTH_HEADER=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 | tr -d '\\n')

                        git -c "http.extraheader=AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin "HEAD:refs/heads/$FEATURE_BRANCH"

                        echo "Feature branch push completed."
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        curl -fsS -G \
                          -H "Authorization: Bearer $GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          --data-urlencode "state=open" \
                          --data-urlencode "head=$GITHUB_OWNER:$FEATURE_BRANCH" \
                          --data-urlencode "base=main" \
                          "$GITHUB_API/pulls" \
                          -o open_prs.json

                        python3 - <<'PY'
import json

with open("open_prs.json", encoding="utf-8") as f:
    prs = json.load(f)

if prs:
    with open("pr_number.txt", "w", encoding="utf-8") as f:
        f.write(str(prs[0]["number"]))
    print(f"Reusing existing PR #{prs[0]['number']}")
else:
    with open("pr_number.txt", "w", encoding="utf-8") as f:
        f.write("NEW")
    print("No open PR found; a new one will be created.")
PY

                        if [ "$(cat pr_number.txt)" = "NEW" ]; then
                            python3 - <<'PY'
import json
import os

body = {
    "title": "Automated configuration update",
    "head": os.environ["FEATURE_BRANCH"],
    "base": "main",
    "body": "Configuration changes generated and validated by Jenkins."
}

with open("create_pr.json", "w", encoding="utf-8") as f:
    json.dump(body, f)
PY

                            curl -fsS \
                              -H "Authorization: Bearer $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "Content-Type: application/json" \
                              -X POST \
                              "$GITHUB_API/pulls" \
                              -d @create_pr.json \
                              -o created_pr.json

                            python3 - <<'PY'
import json

with open("created_pr.json", encoding="utf-8") as f:
    pr = json.load(f)

if "number" not in pr:
    raise SystemExit(f"GitHub did not return a PR number: {pr}")

with open("pr_number.txt", "w", encoding="utf-8") as f:
    f.write(str(pr["number"]))

print(f"Created PR #{pr['number']}")
PY
                        fi

                        echo "Using PR #$(cat pr_number.txt)"
                    '''
                }
            }
        }

        stage('Automatically Merge Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(cat pr_number.txt)
                        attempt=1
                        merged=false

                        while [ "$attempt" -le 8 ]; do
                            echo "Checking PR #$PR_NUMBER, attempt $attempt"

                            curl -fsS \
                              -H "Authorization: Bearer $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              "$GITHUB_API/pulls/$PR_NUMBER" \
                              -o pr_details.json

                            PR_STATE=$(python3 -c 'import json; print(json.load(open("pr_details.json")).get("state", ""))')
                            IS_MERGED=$(python3 -c 'import json; print(str(json.load(open("pr_details.json")).get("merged", False)).lower())')
                            MERGEABLE=$(python3 -c 'import json; d=json.load(open("pr_details.json")); v=d.get("mergeable"); print("none" if v is None else str(v).lower())')
                            MERGE_STATE=$(python3 -c 'import json; print(json.load(open("pr_details.json")).get("mergeable_state", ""))')

                            if [ "$IS_MERGED" = "true" ]; then
                                echo "PR #$PR_NUMBER is already merged."
                                merged=true
                                break
                            fi

                            if [ "$PR_STATE" != "open" ]; then
                                echo "ERROR: PR is not open. State: $PR_STATE"
                                cat pr_details.json
                                exit 1
                            fi

                            if [ "$MERGEABLE" = "false" ]; then
                                echo "ERROR: GitHub reports that this PR is not mergeable."
                                echo "Mergeable state: $MERGE_STATE"
                                echo "Check for conflicts or repository branch protection rules."
                                exit 1
                            fi

                            HTTP_STATUS=$(curl -sS \
                              -o merge_response.json \
                              -w '%{http_code}' \
                              -H "Authorization: Bearer $GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "Content-Type: application/json" \
                              -X PUT \
                              "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                              -d '{"merge_method":"squash"}')

                            echo "Merge API HTTP status: $HTTP_STATUS"

                            if [ "$HTTP_STATUS" = "200" ]; then
                                MERGE_RESULT=$(python3 -c 'import json; print(str(json.load(open("merge_response.json")).get("merged", False)).lower())')

                                if [ "$MERGE_RESULT" = "true" ]; then
                                    echo "PR #$PR_NUMBER merged successfully."
                                    merged=true
                                    break
                                fi
                            fi

                            echo "GitHub merge response:"
                            cat merge_response.json
                            echo

                            if [ "$HTTP_STATUS" != "405" ] &&
                               [ "$HTTP_STATUS" != "409" ] &&
                               [ "$HTTP_STATUS" != "422" ]; then
                                echo "ERROR: Unexpected GitHub API response."
                                exit 1
                            fi

                            if [ "$attempt" -lt 8 ]; then
                                echo "Retrying after 5 seconds..."
                                sleep 5
                            fi

                            attempt=$((attempt + 1))
                        done

                        if [ "$merged" != "true" ]; then
                            echo "ERROR: GitHub did not confirm the merge after retries."
                            echo "Review the response above for the actual reason."
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                sh '''
                    set -eu

                    git fetch origin main
                    git checkout -B main origin/main

                    echo "Latest main commit:"
                    git log -1 --oneline
                '''
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                withEnv([
                    "ARTIFACT_VERSION=${params.ENV_VERSION}-${env.BUILD_NUMBER}"
                ]) {
                    sh '''
                        set -eu

                        mkdir -p dist

                        python3 - <<'PY'
import os
import zipfile
from pathlib import Path

env_name = os.environ["ENVIRONMENT"]
node_name = os.environ["NODE"]
version = os.environ["ARTIFACT_VERSION"]

files = [
    Path("environment") / f"{env_name}.json",
    Path("node") / f"{node_name}.json"
]

for path in files:
    if not path.is_file():
        raise SystemExit(f"Required artifact file is missing: {path}")

artifact = Path("dist") / (
    f"jenkins-config-automation-{env_name}-{node_name}-{version}.zip"
)

with zipfile.ZipFile(artifact, "w", zipfile.ZIP_DEFLATED) as zf:
    for path in files:
        zf.write(path, arcname=str(path))

print(f"Created artifact: {artifact}")
PY
                    '''

                    archiveArtifacts artifacts: 'dist/*.zip', fingerprint: true
                }
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    withEnv([
                        "ARTIFACT_VERSION=${params.ENV_VERSION}-${env.BUILD_NUMBER}"
                    ]) {
                        sh '''
                            set -eu

                            ARTIFACT_FILE=$(find dist -maxdepth 1 -type f -name '*.zip' -print -quit)

                            if [ -z "$ARTIFACT_FILE" ]; then
                                echo "ERROR: ZIP artifact not found."
                                exit 1
                            fi

                            echo "Uploading artifact to Nexus..."

                            curl --fail-with-body -sS \
                              -u "$NEXUS_USER:$NEXUS_PASSWO
