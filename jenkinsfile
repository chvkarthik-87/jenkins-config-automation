pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Environment JSON to update')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'],
               description: 'Node JSON to update')
        string(name: 'ENV_APPNAME', defaultValue: '',
               description: 'Blank keeps current appName')
        string(name: 'ENV_VERSION', defaultValue: '',
               description: 'Blank keeps current version; example 2.0.2')
        string(name: 'ENV_REPLICAS', defaultValue: '',
               description: 'Blank keeps current replicas')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
               description: 'Log level to apply')
        string(name: 'NODE_NAME', defaultValue: '',
               description: 'Blank keeps current node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'],
               description: 'Node type to apply')
        string(name: 'NODE_REGION', defaultValue: '',
               description: 'Blank keeps current region')
        string(name: 'NODE_AZ', defaultValue: '',
               description: 'Blank keeps current availability zone')
    }

    environment {
        GIT_REPO = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        ARTIFACT_ID = 'jenkins-config-automation'
        NO_CHANGES = 'false'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: "${GIT_REPO}"

                sh '''
                    set -eu
                    git fetch origin main
                    git checkout -B main origin/main
                '''
            }
        }

        stage('Read Current Configuration') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT
                    env.SELECTED_NODE = params.NODE

                    def envFile = "environment/${params.ENVIRONMENT}.json"
                    def nodeFile = "node/${params.NODE}.json"

                    def envJson = readJSON text: sh(
                        script: "git show origin/main:${envFile}",
                        returnStdout: true
                    ).trim()

                    def nodeJson = readJSON text: sh(
                        script: "git show origin/main:${nodeFile}",
                        returnStdout: true
                    ).trim()

                    env.OLD_APPNAME = envJson.appName.toString()
                    env.OLD_VERSION = envJson.version.toString()
                    env.OLD_REPLICAS = envJson.replicas.toString()
                    env.OLD_LOGLEVEL = envJson.logLevel.toString()

                    // Support both the existing node schema and aliases.
                    env.OLD_NODE_NAME = (nodeJson.nodeName ?: nodeJson.name).toString()
                    env.OLD_NODE_TYPE = (nodeJson.nodeType ?: nodeJson.type).toString()
                    env.OLD_NODE_REGION = nodeJson.region.toString()
                    env.OLD_NODE_AZ = nodeJson.availabilityZone.toString()

                    env.NEW_APPNAME = params.ENV_APPNAME?.trim()
                        ? params.ENV_APPNAME.trim() : env.OLD_APPNAME
                    env.NEW_VERSION = params.ENV_VERSION?.trim()
                        ? params.ENV_VERSION.trim() : env.OLD_VERSION
                    env.NEW_REPLICAS = params.ENV_REPLICAS?.trim()
                        ? params.ENV_REPLICAS.trim() : env.OLD_REPLICAS
                    env.NEW_LOGLEVEL = params.ENV_LOGLEVEL
                    env.NEW_NODE_NAME = params.NODE_NAME?.trim()
                        ? params.NODE_NAME.trim() : env.OLD_NODE_NAME
                    env.NEW_NODE_TYPE = params.NODE_TYPE
                    env.NEW_NODE_REGION = params.NODE_REGION?.trim()
                        ? params.NODE_REGION.trim() : env.OLD_NODE_REGION
                    env.NEW_NODE_AZ = params.NODE_AZ?.trim()
                        ? params.NODE_AZ.trim() : env.OLD_NODE_AZ

                    if (!(env.NEW_VERSION ==~ /^[0-9]+\.[0-9]+\.[0-9]+$/)) {
                        error('Version must follow format 1.2.3')
                    }
                    if (!(env.NEW_REPLICAS ==~ /^[1-9][0-9]*$/)) {
                        error('Replicas must be a positive integer')
                    }
                    if (!(env.NEW_LOGLEVEL in ['INFO', 'DEBUG', 'WARN', 'ERROR'])) {
                        error('Invalid log level')
                    }
                    if (!(env.NEW_NODE_TYPE in ['worker', 'master'])) {
                        error('Invalid node type')
                    }
                    if (!env.NEW_APPNAME?.trim() ||
                        !env.NEW_NODE_NAME?.trim() ||
                        !env.NEW_NODE_REGION?.trim() ||
                        !env.NEW_NODE_AZ?.trim()) {
                        error('App name, node name, region and AZ cannot be empty')
                    }

                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo "Version: ${env.NEW_VERSION}"
                    echo "Replicas: ${env.NEW_REPLICAS}"
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${env.SELECTED_ENV}-${env.SELECTED_NODE}-${env.BUILD_NUMBER}"
                }
                sh 'git checkout -b "$FEATURE_BRANCH"'
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "ENV_FILE=environment/${params.ENVIRONMENT}.json",
                    "NODE_FILE=node/${params.NODE}.json"
                ]) {
                    sh '''
                        set -eu
                        python3 - <<'PY'
import json
import os

env_file = os.environ["ENV_FILE"]
node_file = os.environ["NODE_FILE"]

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)
with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

env_data["appName"] = os.environ["NEW_APPNAME"]
env_data["version"] = os.environ["NEW_VERSION"]
env_data["replicas"] = int(os.environ["NEW_REPLICAS"])
env_data["logLevel"] = os.environ["NEW_LOGLEVEL"]

# Preserve the repository's existing field names.
if "nodeName" in node_data:
    node_data["nodeName"] = os.environ["NEW_NODE_NAME"]
if "nodeType" in node_data:
    node_data["nodeType"] = os.environ["NEW_NODE_TYPE"]
if "name" in node_data:
    node_data["name"] = os.environ["NEW_NODE_NAME"]
if "type" in node_data:
    node_data["type"] = os.environ["NEW_NODE_TYPE"]

node_data["region"] = os.environ["NEW_NODE_REGION"]
node_data["availabilityZone"] = os.environ["NEW_NODE_AZ"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")
with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("JSON files updated successfully")
PY
                        python3 -m json.tool "$ENV_FILE" >/dev/null
                        python3 -m json.tool "$NODE_FILE" >/dev/null
                        git diff --check
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'
                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        withMaven(maven: 'Maven-3') {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'pom.xml not found; Maven compilation skipped.'
                    }
                }
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    set -eu
                    git diff --check
                    git diff --stat
                    git diff
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    sh '''
                        set -eu
                        git add "environment/${SELECTED_ENV}.json"
                        git add "node/${SELECTED_NODE}.json"
                    '''

                    int status = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (status == 0) {
                        env.NO_CHANGES = 'true'
                        echo 'No changes detected; PR creation and upload skipped.'
                    } else {
                        env.NO_CHANGES = 'false'
                        sh '''
                            set -eu
                            git config user.name "Jenkins Automation"
                            git config user.email "jenkins-automation@users.noreply.github.com"
                            git commit -m "Update ${SELECTED_ENV}/${SELECTED_NODE} configuration [build ${BUILD_NUMBER}]"
                        '''
                    }
                }
            }
        }

        stage('Push Feature Branch') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        AUTH=$(printf '%s:%s' "$GIT_USER" "$GIT_TOKEN" | base64 | tr -d '\\n')
                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            push origin "$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Find Pull Request') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export PR_TITLE="Config update ${SELECTED_ENV}/${SELECTED_NODE} build ${BUILD_NUMBER}"
                        export PR_BODY="Automated configuration update from Jenkins."

                        python3 - <<'PY'
import json, os, urllib.request, urllib.error

api = os.environ["GITHUB_API"]
token = os.environ["GITHUB_TOKEN"]
branch = os.environ["FEATURE_BRANCH"]
owner = "chvkarthik-87"

def call(url, method="GET", data=None):
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
    }
    body = None if data is None else json.dumps(data).encode()
    if body is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            text = r.read().decode()
            return json.loads(text) if text else {}
    except urllib.error.HTTPError as e:
        raise RuntimeError("GitHub API error {}: {}".format(
            e.code, e.read().decode(errors="replace")))

prs = call(api + "/pulls?state=open&head=" + owner + ":" + branch + "&base=main")
if prs:
    pr = prs[0]
    print("Using existing PR:", pr["html_url"])
else:
    pr = call(api + "/pulls", "POST", {
        "title": os.environ["PR_TITLE"],
        "head": branch,
        "base": "main",
        "body": os.environ["PR_BODY"]
    })
    print("Created PR:", pr["html_url"])

with open("pr-number.txt", "w") as f:
    f.write(str(pr["number"]))
PY
                    '''
                }
                script {
                    env.PR_NUMBER = readFile('pr-number.txt').trim()
                    echo "Pull request number: ${env.PR_NUMBER}"
                }
            }
        }

        stage('Auto Merge Pull Request') {
            when {
                expression { env.NO_CHANGES != 'true' }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        python3 - <<'PY'
import json, os, time, urllib.request, urllib.error

api = os.environ["GITHUB_API"]
token = os.environ["GITHUB_TOKEN"]
number = os.environ["PR_NUMBER"]

def call(url, method="GET", data=None):
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
    }
    body = None if data is None else json.dumps(data).encode()
    if body is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            text = r.read().decode()
            return json.loads(text) if text else {}
    except urllib.error.HTTPError as e:
        raise RuntimeError("GitHub API error {}: {}".format(
            e.code, e.read().decode(errors="replace")))

url = api + "/pulls/" + number
pr = {}
for _ in range(6):
    pr = call(url)
    if pr.get("mergeable") is not None:
        break
    time.sleep(5)

if pr.get("merged"):
    print("Pull request already merged.")
else:
    result = call(url + "/merge", "PUT", {
        "commit_title": "Automated configuration merge",
        "commit_message": "Merged by Jenkins build " + os.environ["BUILD_NUMBER"],
        "merge_method": "squash"
    })
    if not result.get("merged"):
        raise RuntimeError("GitHub did not confirm PR merge.")
    print("Pull request merged successfully.")
PY
                    '''
                }
            }
        }

        stage('Verify Main') {
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    git checkout -B main origin/main
                    git show "origin/main:environment/${SELECTED_ENV}.json"
                    git show "origin/main:node/${SELECTED_NODE}.json"
                '''
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p dist
                    git show "origin/main:environment/${SELECTED_ENV}.json" \
                        > "dist/${SELECTED_ENV}.json"
                    git show "origin/main:node/${SELECTED_NODE}.json" \
                        > "dist/${SELECTED_NODE}-node.json"

                    ZIP_NAME="${ARTIFACT_ID}-${SELECTED_ENV}-${SELECTED_NODE}-${NEW_VERSION}.zip"
                    cd dist
                    zip -q "../${ZIP_NAME}" "${SELECTED_ENV}.json" "${SELECTED_NODE}-node.json"
                    cd ..
                    echo "$ZIP_NAME" > artifact-name.txt
                    ls -lh "$ZIP_NAME"
                '''
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: '*.zip', fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    script {
                        def zipName = readFile('artifact-name.txt').trim()
                        def pomText = """<project xmlns="http://maven.apache.org/POM/4.0.0"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.chvkarthik.devops</groupId>
 <artifactId>jenkins-config-automation</artifactId>
 <version>${env.NEW_VERSION}</version>
 <packaging>zip</packaging>
</project>
"""
                        writeFile file: 'nexus-upload-pom.xml', text: pomText

                        sh """
                            set -eu
                            mvn -B deploy:deploy-file \
                              -Durl="${env.NEXUS_URL}/repository/${env.NEXUS_REPOSITORY}/" \
                              -DrepositoryId=nexus-deploy \
                              -Dfile="${zipName}" \
                              -DpomFile=nexus-upload-pom.xml \
                              -DgeneratePom=false \
                              -Dpackaging=zip
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check Console Output for the first error.'
        }
        always {
            echo "Job: ${env.JOB_NAME}"
            echo "Build: ${env.BUILD_NUMBER}"
            echo "Result: ${currentBuild.currentResult}"
        }
    }
}
