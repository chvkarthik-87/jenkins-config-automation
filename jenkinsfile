pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node configuration'
        )

        string(
            name: 'ENV_APPNAME',
            defaultValue: 'myapp',
            description: 'Application name'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '2.0.0',
            description: 'Application version'
        )

        string(
            name: 'ENV_REPLICAS',
            defaultValue: '1',
            description: 'Number of replicas'
        )

        string(
            name: 'ENV_LOGLEVEL',
            defaultValue: 'INFO',
            description: 'Log level'
        )

        string(
            name: 'NODE_NAME',
            defaultValue: 'node-01',
            description: 'Node name'
        )

        string(
            name: 'NODE_TYPE',
            defaultValue: 'worker',
            description: 'Node type'
        )

        string(
            name: 'NODE_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'NODE_AZ',
            defaultValue: 'us-east-1a',
            description: 'Availability zone'
        )
    }

    environment {
        FEATURE_BRANCH = 'feature/config-update'
    }

    stages {

        stage('Show Parameters') {
            steps {
                echo "======================================"
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Node        : ${params.NODE}"
                echo "App Name    : ${params.ENV_APPNAME}"
                echo "Version     : ${params.ENV_VERSION}"
                echo "Replicas    : ${params.ENV_REPLICAS}"
                echo "Log Level   : ${params.ENV_LOGLEVEL}"
                echo "Node Name   : ${params.NODE_NAME}"
                echo "Node Type   : ${params.NODE_TYPE}"
                echo "Region      : ${params.NODE_REGION}"
                echo "AZ          : ${params.NODE_AZ}"
                echo "======================================"
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git fetch origin main
                    git checkout main
                    git reset --hard origin/main

                    git fetch origin feature/config-update || true

                    if git ls-remote --exit-code --heads origin feature/config-update > /dev/null 2>&1
                    then
                        echo "Feature branch already exists."
                        git checkout -B feature/config-update origin/main
                    else
                        echo "Feature branch does not exist. Creating it..."
                        git checkout -b feature/config-update
                    fi

                    echo "Current branch:"
                    git branch --show-current
                '''
            }
        }

        stage('Update JSON Files') {
            steps {
                sh '''
                    echo "Updating Environment JSON..."

                    envFile="environment/${ENVIRONMENT}.json"

                    sed -i -E 's/^  "environment": "[^"]+",/  "environment": "'${ENVIRONMENT}'",/' "$envFile"

                    sed -i -E 's/^  "appName": "[^"]+",/  "appName": "'${ENV_APPNAME}'",/' "$envFile"

                    sed -i -E 's/^  "version": "[^"]+",/  "version": "'${ENV_VERSION}'",/' "$envFile"

                    sed -i -E 's/^  "replicas": [0-9]+(\\.[0-9]+)?,/  "replicas": '${ENV_REPLICAS}',/' "$envFile"

                    sed -i -E 's/^  "logLevel": "[^"]+",/  "logLevel": "'${ENV_LOGLEVEL}'",/' "$envFile"


                    echo "Updating Node JSON..."

                    nodeFile="node/${NODE}.json"

                    sed -i -E 's/^  "environment": "[^"]+",/  "environment": "'${NODE}'",/' "$nodeFile"

                    sed -i -E 's/^  "nodeName": "[^"]+",/  "nodeName": "'${NODE_NAME}'",/' "$nodeFile"

                    sed -i -E 's/^  "nodeType": "[^"]+",/  "nodeType": "'${NODE_TYPE}'",/' "$nodeFile"

                    sed -i -E 's/^  "region": "[^"]+",/  "region": "'${NODE_REGION}'",/' "$nodeFile"

                    sed -i -E 's/^  "availabilityZone": "[^"]+",/  "availabilityZone": "'${NODE_AZ}'",/' "$nodeFile"


                    echo "Updated Environment File:"
                    cat "$envFile"

                    echo "Updated Node File:"
                    cat "$nodeFile"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {

                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {

                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        stage('Show Changes') {
            steps {
                sh '''
                    echo "Git Status:"
                    git status

                    echo "Git Diff:"
                    git diff
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    git add environment/ node/

                    if git diff --cached --quiet
                    then
                        echo "No changes to commit."
                    else
                        git commit -m "Update ${ENVIRONMENT} and ${NODE} configuration"
                    fi
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    sh '''
                        git remote set-url origin https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/chvkarthik-87/jenkins-config-automation.git

                        git push origin feature/config-update --force
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    script {

                        def prNumber = sh(
                            script: '''
                                curl -s \
                                -u "$GIT_USERNAME:$GIT_PASSWORD" \
                                -H "Accept: application/vnd.github+json" \
                                "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls?head=chvkarthik-87:feature/config-update&base=main" \
                                | grep -o '"number"[[:space:]]*:[[:space:]]*[0-9]*' \
                                | head -1 \
                                | sed 's/[^0-9]//g'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (prNumber) {

                            echo "Existing Pull Request found: #${prNumber}"

                            env.PR_NUMBER = prNumber

                        } else {

                            echo "No existing Pull Request found."
                            echo "Creating new Pull Request..."

                            def response = sh(
                                script: '''
                                    curl -s \
                                    -u "$GIT_USERNAME:$GIT_PASSWORD" \
                                    -X POST \
                                    -H "Accept: application/vnd.github+json" \
                                    -H "Content-Type: application/json" \
                                    -d '{"title":"Automated configuration update","body":"Automated Jenkins configuration update","head":"feature/config-update","base":"main"}' \
                                    "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls"
                                ''',
                                returnStdout: true
                            ).trim()

                            prNumber = sh(
                                script: """
                                    echo '${response}' \
                                    | grep -o '"number"[[:space:]]*:[[:space:]]*[0-9]*' \
                                    | head -1 \
                                    | sed 's/[^0-9]//g'
                                """,
                                returnStdout: true
                            ).trim()

                            if (!prNumber) {
                                error "Failed to create Pull Request."
                            }

                            echo "Created Pull Request: #${prNumber}"

                            env.PR_NUMBER = prNumber
                        }
                    }
                }
            }
        }

        stage('Check Pull Request') {
            steps {
                echo "Pull Request Number: ${env.PR_NUMBER}"
                echo "Pull Request is ready for merge."
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "Merging Pull Request #${PR_NUMBER}..."

                        curl -s \
                        -u "$GIT_USERNAME:$GIT_PASSWORD" \
                        -X PUT \
                        -H "Accept: application/vnd.github+json" \
                        -H "Content-Type: application/json" \
                        -d '{"merge_method":"merge","commit_title":"Automated configuration update"}' \
                        "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}/merge"

                        echo ""
                        echo "Pull Request merge request completed."
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "Fetching latest main branch..."

                        git fetch origin main

                        git checkout main

                        git reset --hard origin/main

                        echo "======================================"
                        echo "MAIN BRANCH CONTENT"
                        echo "======================================"

                        echo "Environment JSON:"
                        cat environment/${ENVIRONMENT}.json

                        echo ""
                        echo "Node JSON:"
                        cat node/${NODE}.json

                        echo ""
                        echo "Latest Commit:"
                        git log -1 --oneline
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "PIPELINE COMPLETED SUCCESSFULLY"
            echo "======================================"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Node        : ${params.NODE}"
            echo "Feature     : ${FEATURE_BRANCH}"
            echo "Main branch updated successfully."
        }

        failure {
            echo "======================================"
            echo "PIPELINE FAILED"
            echo "======================================"
            echo "Please check the Console Output."
        }
    }
}
