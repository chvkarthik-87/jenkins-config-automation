pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node'
        )

        string(name: 'ENV_APPNAME', defaultValue: 'myapp',
               description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.3',
               description: 'New application version')
        string(name: 'ENV_REPLICAS', defaultValue: '1',
               description: 'Number of replicas')
        string(name: 'ENV_LOGLEVEL', defaultValue: 'INFO',
               description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01',
               description: 'Node name')
        string(name: 'NODE_TYPE', defaultValue: 'worker',
               description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1',
               description: 'Node region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a',
               description: 'Availability zone')
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'
        NEXUS_URL = 'http://172.31.36.177:8081'
        NEXUS_REPO = 'maven-releases'
    }

    stages {
        stage('Show Parameters') {
            steps {
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Node: ${params.NODE}"
                echo "Requested version: ${params.ENV_VERSION}"
            }
        }

        stage('Checkout Main') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: "https://github.com/${GITHUB_REPO}.git"

                sh 'git fetch origin main'
                sh 'git checkout -B main origin/main'
            }
        }

        stage('Read Last Updated Version') {
            steps {
                script {
                    def envFile = "environment/${params.ENVIRONMENT}.json"

                    if (!fileExists(envFile)) {
                        error("File not found: ${envFile}")
                    }

                    def json = readJSON file: envFile
                    env.LAST_VERSION = json.version.toString()

                    echo "Last updated version: ${env.LAST_VERSION}"
                    echo "New requested version: ${params.ENV_VERSION}"

                    if (env.LAST_VERSION == params.ENV_VERSION) {
                        error('The requested version is already present. Enter a different version.')
                    }
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {
                    if (!(params.ENV_REPLICAS ==~ /^[0-9]+$/)) {
                        error('ENV_REPLICAS must be a number.')
                    }

                    def envFile = "environment/${params.ENVIRONMENT}.json"
                    def nodeFile = "node/${params.NODE}.json"

                    if (!fileExists(envFile) || !fileExists(nodeFile)) {
                        error('Selected environment or node JSON file does not exist.')
                    }

                    def envJson = readJSON file: envFile
                    envJson.appName = params.ENV_APPNAME
                    envJson.version = params.ENV_VERSION
                    envJson.replicas = params.ENV_REPLICAS.toInteger()
                    envJson.logLevel = params.ENV_LOGLEVEL

                    writeJSON file: envFile, json: envJson, pretty: 4

                    def nodeJson = readJSON file: nodeFile
                    nodeJson.name = params.NODE_NAME
                    nodeJson.type = params.NODE_TYPE
                    nodeJson.region = params.NODE_REGION
                    nodeJson.availabilityZone = params.NODE_AZ

                    writeJSON file: nodeFile, json: nodeJson, pretty: 4

                    echo 'Selected JSON files updated automatically.'
                }
            }
        }

        stage('Validate JSON') {
            steps {
                sh '''
                    python3 -m json.tool environment/${ENVIRONMENT}.json > /dev/null
                    python3 -m json.tool node/${NODE}.json > /dev/null
                    echo "JSON validation successful"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube-Server') {
                    script {
                        def scannerHome = tool 'SonarQube-Scanner'
                        sh """
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    git config user.name "Jenkins Automation"
                    git config user.email "jenkins@example.com"
                    git checkout -B "$FEATURE_BRANCH"
                    git add environment/ node/
                    git diff --cached --check
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    def changes = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (changes == 0) {
                        error('No JSON changes detected. Check the parameter values.')
                    }
                }

                sh '''
                    git commit -m "Update ${ENVIRONMENT}/${NODE} configuration to ${ENV_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set +x
                        ASKPASS_FILE="$(mktemp)"
                        trap 'rm -f "$ASKPASS_FILE"' EXIT

                        cat > "$ASKPASS_FILE" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GIT_USER" ;;
  *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
  *) exit 1 ;;
esac
EOF
                        chmod 700 "$ASKPASS_FILE"
                        export GIT_ASKPASS="$ASKPASS_FILE"
                        export GIT_TERMINAL_PROMPT=0

                        git push -f https://github.com/${GITHUB_REPO}.git \
                            HEAD:${FEATURE_BRANCH}
                    '''
                }
            }
        }

        stage('Create or Find Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    script {
                        def prNumber = sh(
                            script: '''
                                set +x
                                curl -fsS \
                                  -H "Authorization: Bearer $GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=chvkarthik-87:${FEATURE_BRANCH}&base=main" |
                                python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["number"] if d else "")'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!prNumber) {
                            prNumber = sh(
                                script: '''
                                    set +x
                                    curl -fsS -X POST \
                                      -H "Authorization: Bearer $GH_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      https://api.github.com/repos/${GITHUB_REPO}/pulls \
                                      -d "{\"title\":\"Automated configuration update\",\"head\":\"${FEATURE_BRANCH}\",\"base\":\"main\",\"body\":\"Created automatically by Jenkins.\"}" |
                                    python3 -c 'import json,sys; print(json.load(sys.stdin)["number"])'
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        if (!(prNumber ==~ /^[0-9]+$/)) {
                            error("Could not obtain a valid GitHub PR number: ${prNumber}")
                        }

                        env.PR_NUMBER = prNumber
                        echo "Pull request number: ${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set +x
                        RESPONSE="$(mktemp)"
                        trap 'rm -f "$RESPONSE"' EXIT

                        CODE=$(curl -sS -o "$RESPONSE" -w '%{http_code}' \
                          -X PUT \
                          -H "Authorization: Bearer $GH_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                          -d '{"merge_method":"squash"}')

                        cat "$RESPONSE"

                        if [ "$CODE" != "200" ]; then
                            echo "Automatic merge failed. HTTP $CODE"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Verify Main') {
            steps {
                sh '''
                    git fetch origin main
                    git checkout -B main origin/main
                    echo "Latest main commit:"
                    git log -1 --oneline
                    cat environment/${ENVIRONMENT}.json
                    cat node/${NODE}.json
                '''
            }
        }

        stage('Package Configuration Artifact') {
            steps {
                sh '''
                    mkdir -p build-artifact
                    tar -czf "build-artifact/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz" \
                        "environment/${ENVIRONMENT}.json" \
                        "node/${NODE}.json"

                    ls -lh build-artifact/
                '''
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''
                        set +x

                        FILE="build-artifact/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz"

                        HTTP_CODE=$(curl -sS -o nexus-response.txt -w '%{http_code}' \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "${NEXUS_URL}/service/rest/v1/components?repository=${NEXUS_REPO}" \
                          -F "maven2.groupId=com.chvkarthik.config" \
                          -F "maven2.artifactId=config-${ENVIRONMENT}-${NODE}" \
                          -F "maven2.version=${ENV_VERSION}" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@${FILE}" \
                          -F "maven2.asset1.extension=tar.gz")

                        if [ "$HTTP_CODE" != "204" ] &&
                           [ "$HTTP_CODE" != "201" ] &&
                           [ "$HTTP_CODE" != "200" ]; then
                            echo "Nexus upload failed. HTTP $HTTP_CODE"
                            cat nexus-response.txt
                            exit 1
                        fi

                        echo "Artifact uploaded successfully to Nexus."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully."
            echo "Environment: ${params.ENVIRONMENT}"
            echo "Node: ${params.NODE}"
            echo "Previous version: ${env.LAST_VERSION}"
            echo "Updated version: ${params.ENV_VERSION}"
            echo "Pull request: ${env.PR_NUMBER}"
        }

        failure {
            echo 'Pipeline failed. Check Console Output for the failed stage.'
        }
    }
}
