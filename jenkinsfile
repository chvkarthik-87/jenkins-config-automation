import groovy.json.JsonOutput
import groovy.json.JsonSlurperClassic

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        GITHUB_URL  = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        GITHUB_API  = 'https://api.github.com'
        NEXUS_URL   = 'http://172.31.36.177:8081'
        NEXUS_REPO  = 'maven-releases'
        SONAR_NAME  = 'SonarQube-Server'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    def required = [
                        'ENVIRONMENT',
                        'NODE',
                        'ENV_VERSION'
                    ]

                    required.each { key ->
                        if (!params[key]?.toString()?.trim()) {
                            error("Missing required parameter: ${key}")
                        }
                    }

                    if (!(params.ENVIRONMENT in
                        ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid ENVIRONMENT selected.')
                    }

                    if (!(params.NODE in
                        ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid NODE selected.')
                    }

                    if (!(params.ENV_VERSION ==~
                        /\d+\.\d+\.\d+/)) {
                        error('ENV_VERSION must use X.Y.Z format, e.g. 2.0.4')
                    }

                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Node: ${params.NODE}"
                    echo "Requested new version: ${params.ENV_VERSION}"
                }
            }
        }

        stage('Checkout Main') {
            steps {
                deleteDir()

                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: "${GITHUB_URL}"

                sh '''
                    git checkout main
                    git pull origin main
                    git status
                '''
            }
        }

        stage('Read Current Configuration') {
            steps {
                script {
                    def envFile =
                        "environment/${params.ENVIRONMENT}.json"

                    def nodeFile =
                        "node/${params.NODE}.json"

                    if (!fileExists(envFile)) {
                        error("File not found: ${envFile}")
                    }

                    if (!fileExists(nodeFile)) {
                        error("File not found: ${nodeFile}")
                    }

                    def envConfig = readJSON file: envFile
                    def nodeConfig = readJSON file: nodeFile

                    env.OLD_VERSION =
                        envConfig.version?.toString() ?: ''

                    env.OLD_APPNAME =
                        envConfig.appName?.toString() ?: ''

                    env.OLD_REPLICAS =
                        envConfig.replicas?.toString() ?: '1'

                    env.OLD_LOGLEVEL =
                        envConfig.logLevel?.toString() ?: 'INFO'

                    env.OLD_NODE_NAME =
                        nodeConfig.name?.toString() ?: ''

                    env.OLD_NODE_TYPE =
                        nodeConfig.type?.toString() ?: ''

                    env.OLD_NODE_REGION =
                        nodeConfig.region?.toString() ?: ''

                    env.OLD_NODE_AZ =
                        nodeConfig.availabilityZone?.toString() ?: ''

                    echo '========== CURRENT CONFIGURATION =========='
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Current version: ${env.OLD_VERSION}"
                    echo "Application name: ${env.OLD_APPNAME}"
                    echo "Replicas: ${env.OLD_REPLICAS}"
                    echo "Log level: ${env.OLD_LOGLEVEL}"
                    echo "Node name: ${env.OLD_NODE_NAME}"
                    echo "Node type: ${env.OLD_NODE_TYPE}"
                    echo "Node region: ${env.OLD_NODE_REGION}"
                    echo "Node AZ: ${env.OLD_NODE_AZ}"
                    echo "Requested version: ${params.ENV_VERSION}"
                    echo '============================================'

                    if (!(env.OLD_VERSION ==~ /\d+\.\d+\.\d+/)) {
                        error(
                            "Current version '${env.OLD_VERSION}' " +
                            'must use X.Y.Z format.'
                        )
                    }

                    def oldParts = env.OLD_VERSION
                        .split('\\.')
                        .collect { it.toBigInteger() }

                    def newParts = params.ENV_VERSION
                        .split('\\.')
                        .collect { it.toBigInteger() }

                    int comparison = 0

                    for (int i = 0; i < 3; i++) {
                        if (newParts[i] > oldParts[i]) {
                            comparison = 1
                            break
                        }

                        if (newParts[i] < oldParts[i]) {
                            comparison = -1
                            break
                        }
                    }

                    if (comparison == 0) {
                        error('New version must differ from current version.')
                    }

                    if (comparison < 0) {
                        error('Downgrading the version is not allowed.')
                    }
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {
                    def envFile =
                        "environment/${params.ENVIRONMENT}.json"

                    def nodeFile =
                        "node/${params.NODE}.json"

                    def envConfig = readJSON file: envFile
                    def nodeConfig = readJSON file: nodeFile

                    envConfig.version = params.ENV_VERSION.trim()

                    if (params.ENV_APPNAME?.trim()) {
                        envConfig.appName =
                            params.ENV_APPNAME.trim()
                    }

                    if (params.ENV_REPLICAS?.trim()) {
                        if (!(params.ENV_REPLICAS.trim() ==~ /\d+/)) {
                            error('ENV_REPLICAS must be a whole number.')
                        }

                        envConfig.replicas =
                            params.ENV_REPLICAS.trim().toInteger()
                    }

                    if (params.ENV_LOGLEVEL?.trim()) {
                        envConfig.logLevel =
                            params.ENV_LOGLEVEL.trim()
                    }

                    if (params.NODE_NAME?.trim()) {
                        nodeConfig.name = params.NODE_NAME.trim()
                    }

                    if (params.NODE_TYPE?.trim()) {
                        nodeConfig.type = params.NODE_TYPE.trim()
                    }

                    if (params.NODE_REGION?.trim()) {
                        nodeConfig.region = params.NODE_REGION.trim()
                    }

                    if (params.NODE_AZ?.trim()) {
                        nodeConfig.availabilityZone =
                            params.NODE_AZ.trim()
                    }

                    writeJSON file: envFile,
                        json: envConfig,
                        pretty: 4

                    writeJSON file: nodeFile,
                        json: nodeConfig,
                        pretty: 4

                    echo 'Updated environment and node JSON files.'
                }
            }
        }

        stage('Validate JSON') {
            steps {
                sh '''
                    set -eu
                    python3 -m json.tool \
                      "environment/${ENVIRONMENT}.json" \
                      > /dev/null

                    python3 -m json.tool \
                      "node/${NODE}.json" \
                      > /dev/null

                    echo "JSON validation successful."
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome =
                        tool 'SonarQube-Scanner'

                    withSonarQubeEnv("${SONAR_NAME}") {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${params.ENVIRONMENT}-${params.NODE}-${env.BUILD_NUMBER}"

                    sh '''
                        set -eu
                        git checkout -b "$FEATURE_BRANCH"
                        git status
                    '''
                }
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    set -eu

                    git config user.name "Jenkins Automation"
                    git config user.email "jenkins@example.com"

                    git add \
                      "environment/${ENVIRONMENT}.json" \
                      "node/${NODE}.json"

                    git commit -m \
                      "Update ${ENVIRONMENT}/${NODE} to ${ENV_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        cat > "$WORKSPACE/git-askpass.sh" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GH_USER" ;;
  *Password*) printf '%s\\n' "$GH_TOKEN" ;;
  *) exit 1 ;;
esac
ASKPASS

                        chmod 700 "$WORKSPACE/git-askpass.sh"

                        export GIT_ASKPASS="$WORKSPACE/git-askpass.sh"
                        export GIT_TERMINAL_PROMPT=0

                        git push origin "$FEATURE_BRANCH"

                        rm -f "$WORKSPACE/git-askpass.sh"
                    '''
                }
            }
        }

        stage('Create Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    script {
                        def prBody = [
                            title: "Update ${params.ENVIRONMENT}/${params.NODE} to ${params.ENV_VERSION}",
                            head: env.FEATURE_BRANCH,
                            base: 'main',
                            body: """Automated configuration update.

Environment: ${params.ENVIRONMENT}
Node: ${params.NODE}
Previous version: ${env.OLD_VERSION}
New version: ${params.ENV_VERSION}
Jenkins build: ${env.BUILD_NUMBER}
"""
                        ]

                        writeFile(
                            file: 'pr-payload.json',
                            text: JsonOutput.toJson(prBody)
                        )

                        def response = sh(
                            script: '''
                                set +x
                                curl --fail-with-body -sS \
                                  -u "$GH_USER:$GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  -H "Content-Type: application/json" \
                                  -X POST \
                                  --data @pr-payload.json \
                                  "$GITHUB_API/repos/$GITHUB_REPO/pulls"
                            ''',
                            returnStdout: true
                        ).trim()

                        def pr = new JsonSlurperClassic()
                            .parseText(response)

                        if (!pr.number) {
                            error("GitHub did not return a PR number: ${response}")
                        }

                        env.PR_NUMBER = pr.number.toString()
                        env.PR_URL = pr.html_url?.toString() ?: ''

                        echo "Pull request created: ${env.PR_URL}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    script {
                        def mergePayload = [
                            commit_title: "Merge PR #${env.PR_NUMBER}: update configuration",
                            commit_message: "Automated configuration update from Jenkins build ${env.BUILD_NUMBER}",
                            merge_method: 'squash'
                        ]

                        writeFile(
                            file: 'merge-payload.json',
                            text: JsonOutput.toJson(mergePayload)
                        )

                        def response = sh(
                            script: '''
                                set +x
                                curl --fail-with-body -sS \
                                  -u "$GH_USER:$GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  -H "Content-Type: application/json" \
                                  -X PUT \
                                  --data @merge-payload.json \
                                  "$GITHUB_API/repos/$GITHUB_REPO/pulls/$PR_NUMBER/merge"
                            ''',
                            returnStdout: true
                        ).trim()

                        def mergeResult = new JsonSlurperClassic()
                            .parseText(response)

                        if (mergeResult.merged != true) {
                            error("GitHub could not merge PR: ${response}")
                        }

                        echo "PR #${env.PR_NUMBER} merged successfully."
                    }
                }
            }
        }

        stage('Verify Main') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        cat > "$WORKSPACE/git-askpass.sh" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GH_USER" ;;
  *Password*) printf '%s\\n' "$GH_TOKEN" ;;
  *) exit 1 ;;
esac
ASKPASS

                        chmod 700 "$WORKSPACE/git-askpass.sh"
                        export GIT_ASKPASS="$WORKSPACE/git-askpass.sh"
                        export GIT_TERMINAL_PROMPT=0

                        git fetch origin main
                        git checkout -B main origin/main

                        echo "Environment JSON:"
                        cat "environment/${ENVIRONMENT}.json"

                        echo "Node JSON:"
                        cat "node/${NODE}.json"

                        rm -f "$WORKSPACE/git-askpass.sh"
                    '''
                }
            }
        }

        stage('Package Configuration Artifact') {
            steps {
                sh '''
                    set -eu

                    mkdir -p build-artifact

                    tar -czf \
                      "build-artifact/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz" \
                      "environment/${ENVIRONMENT}.json" \
                      "node/${NODE}.json"

                    ls -lh build-artifact/
                '''

                archiveArtifacts(
                    artifacts: 'build-artifact/*.tar.gz',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        ARTIFACT="build-artifact/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz"

                        curl --fail-with-body -sS \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPO" \
                          -F "raw.directory=config/${ENVIRONMENT}/${NODE}" \
                          -F "raw.asset1=@${ARTIFACT}" \
                          -F "raw.asset1.filename=$(basename "$ARTIFACT")"

                        echo "Artifact uploaded to Nexus."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo """
            ==========================================
            PIPELINE COMPLETED SUCCESSFULLY

            Environment : ${params.ENVIRONMENT}
            Node        : ${params.NODE}
            Old version : ${env.OLD_VERSION}
            New version : ${params.ENV_VERSION}
            PR number   : ${env.PR_NUMBER}
            PR URL      : ${env.PR_URL}

            ==========================================
            """
        }

        failure {
            echo 'Pipeline failed. Check Console Output for the exact error.'
        }

        always {
            echo "Build completed: ${env.BUILD_TAG}"
        }
    }
}
