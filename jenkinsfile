pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node configuration'
        )

        string(
            name: 'ENV_APPNAME',
            defaultValue: 'myapp',
            description: 'Application name'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '3.1.0',
            description: 'Application version'
        )

        string(
            name: 'ENV_REPLICAS',
            defaultValue: '1',
            description: 'Number of replicas'
        )

        choice(
            name: 'ENV_LOGLEVEL',
            choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
            description: 'Application log level'
        )

        string(
            name: 'NODE_NAME',
            defaultValue: 'node-01',
            description: 'Node name'
        )

        choice(
            name: 'NODE_TYPE',
            choices: ['worker', 'master'],
            description: 'Node type'
        )

        string(
            name: 'NODE_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'NODE_AZ',
            defaultValue: 'us-east-1a',
            description: 'Availability zone'
        )
    }

    environment {
        GITHUB_OWNER = 'chvkarthik-87'
        REPO_NAME = 'jenkins-config-automation'

        SONARQUBE_NAME = 'SonarQube-Server'
        SONAR_SCANNER = 'SonarQube-Scanner'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'

        ARTIFACT_NAME = 'config-artifact'
    }

    stages {

        stage('Initialize') {
            steps {
                script {
                    env.FEATURE_BRANCH =
                        "feature/config-${params.ENVIRONMENT}-${params.NODE}-${env.BUILD_NUMBER}"

                    env.ARTIFACT_FILE =
                        "config-artifact-${params.ENV_VERSION}.zip"

                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Node: ${params.NODE}"
                    echo "Feature branch: ${env.FEATURE_BRANCH}"
                    echo "Version: ${params.ENV_VERSION}"
                }
            }
        }

        stage('Checkout Main') {
            steps {
                deleteDir()

                git(
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git',
                    branch: 'main',
                    credentialsId: 'github-jenkins-token'
                )

                sh '''
                    set -eu
                    git status --short
                    test -f "environment/$ENVIRONMENT.json"
                    test -f "node/$NODE.json"
                '''
            }
        }

        stage('Update Selected JSON Files') {
            steps {
                writeFile file: 'update_config.py', text: '''
import json
import os

environment = os.environ["ENVIRONMENT"]
node = os.environ["NODE"]

env_file = f"environment/{environment}.json"
node_file = f"node/{node}.json"

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

env_data.update({
    "appName": os.environ["ENV_APPNAME"],
    "version": os.environ["ENV_VERSION"],
    "replicas": int(os.environ["ENV_REPLICAS"]),
    "logLevel": os.environ["ENV_LOGLEVEL"]
})

node_data.update({
    "name": os.environ["NODE_NAME"],
    "type": os.environ["NODE_TYPE"],
    "region": os.environ["NODE_REGION"],
    "availabilityZone": os.environ["NODE_AZ"]
})

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
'''

                withEnv([
                    "ENVIRONMENT=${params.ENVIRONMENT}",
                    "NODE=${params.NODE}",
                    "ENV_APPNAME=${params.ENV_APPNAME}",
                    "ENV_VERSION=${params.ENV_VERSION}",
                    "ENV_REPLICAS=${params.ENV_REPLICAS}",
                    "ENV_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "NODE_NAME=${params.NODE_NAME}",
                    "NODE_TYPE=${params.NODE_TYPE}",
                    "NODE_REGION=${params.NODE_REGION}",
                    "NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh 'python3 update_config.py'
                }

                sh '''
                    set -eu
                    python3 -m json.tool "environment/$ENVIRONMENT.json" >/dev/null
                    python3 -m json.tool "node/$NODE.json" >/dev/null
                    echo "JSON validation successful."
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_SCANNER,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv(env.SONARQUBE_NAME) {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mavenHome = tool(
                            name: 'Maven-3',
                            type: 'hudson.tasks.Maven$MavenInstallation'
                        )

                        sh """
                            set -eu
                            "${mavenHome}/bin/mvn" -B clean package
                        """
                    } else {
                        echo 'No pom.xml found. Maven compilation skipped for this configuration repository.'
                    }
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    set -eu

                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git switch -c "$FEATURE_BRANCH"

                    git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                    if git diff --cached --quiet; then
                        echo "No changes detected."
                        exit 1
                    fi

                    git commit -m "Update $ENVIRONMENT and $NODE configuration"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin "HEAD:refs/heads/$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    writeFile file: 'manage_pr.py', text: '''
import json
import os
import urllib.parse
import urllib.request

owner = os.environ["GITHUB_OWNER"]
repo = os.environ["REPO_NAME"]
branch = os.environ["FEATURE_BRANCH"]
token = os.environ["GH_TOKEN"]

base = f"https://api.github.com/repos/{owner}/{repo}"

def api(path, method="GET", body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if data is not None:
        req.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw = response.read()
            return json.loads(raw) if raw else {}
    except Exception as e:
        raise RuntimeError(f"GitHub API failed for {path}: {e}") from e

query = urllib.parse.urlencode({
    "state": "open",
    "head": f"{owner}:{branch}",
    "base": "main"
})

pulls = api("/pulls?" + query)

if pulls:
    pr = pulls[0]
    print("Using existing PR:", pr["number"])
else:
    pr = api("/pulls", "POST", {
        "title": f"Configuration update: {branch}",
        "head": branch,
        "base": "main",
        "body": "Created automatically by Jenkins."
    })
    print("Created PR:", pr["number"])

with open("pr-number.txt", "w") as f:
    f.write(str(pr["number"]))

print("Pull request URL:", pr["html_url"])
'''

                    sh 'python3 manage_pr.py'
                }
            }
        }

        stage('Automatically Merge Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    writeFile file: 'merge_pr.py', text: '''
import json
import os
import time
import urllib.error
import urllib.request

owner = os.environ["GITHUB_OWNER"]
repo = os.environ["REPO_NAME"]
token = os.environ["GH_TOKEN"]

with open("pr-number.txt") as f:
    number = f.read().strip()

base = f"https://api.github.com/repos/{owner}/{repo}"

def request(path, method="GET", body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")

    if data is not None:
        req.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw = response.read()
            return response.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        raise RuntimeError(f"GitHub returned HTTP {e.code}: {detail}") from e

# Wait for GitHub to calculate PR mergeability.
pr = {}
for attempt in range(12):
    _, pr = request(f"/pulls/{number}")

    if pr.get("merged"):
        print("Pull request is already merged.")
        break

    mergeable = pr.get("mergeable")

    if mergeable is not None:
        break

    print("Waiting for GitHub mergeability calculation...")
    time.sleep(5)

if not pr.get("merged"):
    if pr.get("mergeable") is False:
        raise RuntimeError(
            "PR has merge conflicts. Resolve the conflicts before merging."
        )

    if pr.get("state") != "open":
        raise RuntimeError("Pull request is not open.")

    status, result = request(
        f"/pulls/{number}/merge",
        "PUT",
        {
            "merge_method": "squash",
            "commit_title": f"Merge configuration update PR #{number}"
        }
    )

    if not result.get("merged"):
        raise RuntimeError(
            "GitHub did not merge the PR: " + str(result)
        )

    print("PR merged:", result.get("message"))

print("Automatic merge completed.")
'''

                    sh 'python3 merge_pr.py'
                }
            }
        }

        stage('Checkout Updated Main') {
            steps {
                deleteDir()

                git(
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git',
                    branch: 'main',
                    credentialsId: 'github-jenkins-token'
                )

                sh '''
                    set -eu
                    git log -1 --oneline
                    python3 -m json.tool "environment/$ENVIRONMENT.json" >/dev/null
                    python3 -m json.tool "node/$NODE.json" >/dev/null
                '''
            }
        }

        stage('Package Artifact') {
            steps {
                writeFile file: 'package_artifact.py', text: '''
import os
import zipfile

version = os.environ["ENV_VERSION"]
artifact = f"config-artifact-{version}.zip"

files = []

for folder in ("environment", "node"):
    for root, _, names in os.walk(folder):
        for name in names:
            if name.endswith(".json"):
                files.append(os.path.join(root, name))

if not files:
    raise RuntimeError("No JSON configuration files found.")

with zipfile.ZipFile(artifact, "w", zipfile.ZIP_DEFLATED) as z:
    for path in sorted(files):
        z.write(path)

print("Created artifact:", artifact)
'''

                withEnv(["ENV_VERSION=${params.ENV_VERSION}"]) {
                    sh 'python3 package_artifact.py'
                }

                archiveArtifacts(
                    artifacts: 'config-artifact-*.zip',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    withEnv(["ENV_VERSION=${params.ENV_VERSION}"]) {
                        sh '''
                            set -eu

                            ARTIFACT="config-artifact-${ENV_VERSION}.zip"

                            test -f "$ARTIFACT"

                            URL="${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/com/chvkarthik/config-artifact/${ENV_VERSION}/${ARTIFACT}"

                            curl --fail --show-error --silent \
                                --user "$NEXUS_USER:$NEXUS_PASS" \
                                --upload-file "$ARTIFACT" \
                                "$URL"

                            echo "Artifact uploaded to Nexus."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the first failed stage in Console Output.'
        }

        always {
            echo 'Jenkins pipeline finished.'
        }
    }
}
