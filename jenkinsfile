pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node configuration')
        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Enter any non-empty version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Number of replicas')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Application log level')
        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    tools {
        maven 'Maven-3'
    }

    environment {
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        REPO_URL = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        FEATURE_BRANCH = 'feature/config-update'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()

                git branch: 'main', url: "${REPO_URL}"

                sh '''
                    set -eu
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git fetch origin main
                    git fetch origin feature/config-update
                '''
            }
        }

        stage('Prepare Existing Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" |
                            base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            fetch origin feature/config-update

                        git checkout -B feature/config-update \
                            refs/remotes/origin/feature/config-update

                        git config user.name "Jenkins"
                        git config user.email "jenkins@example.com"

                        echo "Using existing branch: feature/config-update"
                        git status --short
                    '''
                }
            }
        }

        stage('Read Current Version') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENVIRONMENT.toString().trim()
                    env.SELECTED_NODE = params.NODE.toString().trim()
                    env.NEW_VERSION = params.ENV_VERSION.toString().trim()

                    if (!env.NEW_VERSION) {
                        error('ENV_VERSION cannot be empty. Enter any version.')
                    }

                    if (!(env.SELECTED_ENV in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Select a valid environment.')
                    }

                    if (!(env.SELECTED_NODE in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Select a valid node.')
                    }

                    env.OLD_VERSION = sh(
                        script: """
                            set -eu
                            python3 -c "import json; print(json.load(open('environment/${env.SELECTED_ENV}.json'))['version'])"
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo "Old version: ${env.OLD_VERSION}"
                    echo "New version: ${env.NEW_VERSION}"
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_NODE_REGION=${params.NODE_REGION}",
                    "CONFIG_NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 - <<'PY'
import json
import os

environment = os.environ["SELECTED_ENV"]
node_selection = os.environ["SELECTED_NODE"]

env_file = f"environment/{environment}.json"
node_file = f"node/{node_selection}.json"

replicas = int(os.environ["APP_REPLICAS"])
if replicas < 1:
    raise ValueError("Replicas must be at least 1")

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["APP_VERSION"]
env_data["replicas"] = replicas
env_data["logLevel"] = os.environ["APP_LOGLEVEL"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=4)
    f.write("\\n")

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

# Update existing keys without replacing the whole JSON structure.
if "nodeName" in node_data:
    node_data["nodeName"] = os.environ["CONFIG_NODE_NAME"]
if "name" in node_data:
    node_data["name"] = os.environ["CONFIG_NODE_NAME"]

if "nodeType" in node_data:
    node_data["nodeType"] = os.environ["CONFIG_NODE_TYPE"]
if "type" in node_data:
    node_data["type"] = os.environ["CONFIG_NODE_TYPE"]

node_data["region"] = os.environ["CONFIG_NODE_REGION"]
node_data["availabilityZone"] = os.environ["CONFIG_NODE_AZ"]

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=4)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
print("Version saved:", os.environ["APP_VERSION"])
PY
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                sh '''
                    set -eu

                    if [ -f pom.xml ]; then
                        mvn -B clean package
                    else
                        echo "No pom.xml found; skipping Maven compilation."
                    fi
                '''
            }
        }

        stage('Review Changes') {
            steps {
                sh '''
                    set -eu
                    git diff --check
                    git diff -- environment node
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    set -eu

                    git add "environment/${SELECTED_ENV}.json"
                    git add "node/${SELECTED_NODE}.json"

                    if git diff --cached --quiet; then
                        echo "No configuration changes detected."
                        exit 1
                    fi

                    git commit -m "Update ${SELECTED_ENV}/${SELECTED_NODE} to ${NEW_VERSION}"
                '''
            }
        }

        stage('Push Existing Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" |
                            base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            push origin HEAD:refs/heads/feature/config-update
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: '''
                                set -eu
                                set +x

                                curl -fsS -G \
                                  -H "Authorization: Bearer $GITHUB_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  --data-urlencode "state=open" \
                                  --data-urlencode "head=chvkarthik-87:feature/config-update" \
                                  --data-urlencode "base=main" \
                                  "$GITHUB_API/pulls" |
                                python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['number'] if d else '')"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.PR_NUMBER) {
                            writeFile(
                                file: 'pr-payload.json',
                                text: groovy.json.JsonOutput.toJson([
                                    title: "Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}",
                                    head: 'feature/config-update',
                                    base: 'main',
                                    body: "Automated configuration update from Jenkins build ${env.BUILD_NUMBER}."
                                ])
                            )

                            env.PR_NUMBER = sh(
                                script: '''
                                    set -eu
                                    set +x

                                    curl -fsS -X POST \
                                      -H "Authorization: Bearer $GITHUB_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "X-GitHub-Api-Version: 2022-11-28" \
                                      -H "Content-Type: application/json" \
                                      "$GITHUB_API/pulls" \
                                      --data-binary @pr-payload.json |
                                    python3 -c "import json,sys; print(json.load(sys.stdin)['number'])"
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        echo "Pull request number: ${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        API="$GITHUB_API/pulls/$PR_NUMBER"

                        echo "Checking PR #$PR_NUMBER"

                        PR_JSON=$(curl -fsS \
                            -H "Authorization: Bearer $GITHUB_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "X-GitHub-Api-Version: 2022-11-28" \
                            "$API")

                        printf '%s' "$PR_JSON" | python3 -c '
import json, sys
p = json.load(sys.stdin)
print("PR state:", p.get("state"))
print("Already merged:", p.get("merged"))
print("Draft:", p.get("draft"))
print("Mergeable:", p.get("mergeable"))
print("Mergeable state:", p.get("mergeable_state"))
print("Head:", p.get("head", {}).get("ref"))
print("Base:", p.get("base", {}).get("ref"))
'

                        STATE=$(printf '%s' "$PR_JSON" |
                            python3 -c 'import json,sys; print(json.load(sys.stdin).get("state",""))')

                        MERGED=$(printf '%s' "$PR_JSON" |
                            python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("merged",False)).lower())')

                        DRAFT=$(printf '%s' "$PR_JSON" |
                            python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("draft",False)).lower())')

                        MERGEABLE=$(printf '%s' "$PR_JSON" |
                            python3 -c 'import json,sys; v=json.load(sys.stdin).get("mergeable"); print("null" if v is None else str(v).lower())')

                        if [ "$MERGED" = "true" ]; then
                            echo "Pull request is already merged."
                            exit 0
                        fi

                        if [ "$STATE" != "open" ]; then
                            echo "Pull request is not open. State: $STATE"
                            exit 1
                        fi

                        if [ "$DRAFT" = "true" ]; then
                            echo "Pull request is a draft. Mark it ready for review."
                            exit 1
                        fi

                        if [ "$MERGEABLE" = "null" ]; then
                            echo "GitHub has not finished calculating mergeability."
                            echo "Wait briefly and rerun the build."
                            exit 1
                        fi

                        if [ "$MERGEABLE" != "true" ]; then
                            echo "Pull request has conflicts or is not mergeable."
                            exit 1
                        fi

                        HTTP_CODE=$(curl -sS \
                            -o merge-response.json \
                            -w '%{http_code}' \
                            -X PUT \
                            -H "Authorization: Bearer $GITHUB_TOKEN" \
                            -H "Accept: application/vnd.github+json" \
                            -H "X-GitHub-Api-Version: 2022-11-28" \
                            -H "Content-Type: application/json" \
                            "$API/merge" \
                            -d '{"merge_method":"squash"}')

                        echo "GitHub merge response:"
                        cat merge-response.json
                        echo
                        echo "HTTP status: $HTTP_CODE"

                        if [ "$HTTP_CODE" != "200" ]; then
                            echo "Automatic merge was not successful."
                            echo "Check GitHub branch protection, required checks, and token permissions."
                            exit 1
                        fi

                        python3 -c '
import json
with open("merge-response.json") as f:
    data = json.load(f)
if not data.get("merged"):
    raise SystemExit("GitHub did not confirm a successful merge.")
print("PR merged successfully.")
print("Merge commit:", data.get("sha"))
'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" |
                            base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            fetch origin main

                        echo "Checking merged environment configuration:"
                        git show "origin/main:environment/${SELECTED_ENV}.json"

                        echo "Checking merged node configuration:"
                        git show "origin/main:node/${SELECTED_NODE}.json"
                    '''
                }
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" |
                            base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            fetch origin main

                        rm -rf artifact config-artifact.zip
                        mkdir -p artifact/environment artifact/node

                        git show "origin/main:environment/${SELECTED_ENV}.json" \
                            > "artifact/environment/${SELECTED_ENV}.json"

                        git show "origin/main:node/${SELECTED_NODE}.json" \
                            > "artifact/node/${SELECTED_NODE}.json"

                        cd artifact
                        zip -r ../config-artifact.zip .
                    '''
                }

                archiveArtifacts(
                    artifacts: 'config-artifact.zip',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        curl -fsS \
