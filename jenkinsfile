pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Node')
        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replicas')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Log level')
        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'Region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    tools {
        maven 'Maven-3'
    }

    environment {
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        REPO_URL = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        FEATURE_BRANCH = 'feature/config-update'
        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        GROUP_ID = 'com.chvkarthik.config'
        ARTIFACT_ID = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main', url: "${REPO_URL}"
            }
        }

        stage('Checkout Existing Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        AUTH=\\$(printf '%s' "\\$GITHUB_USER:\\$GITHUB_TOKEN" | base64 | tr -d '\\\\n')

                        git config user.name "Jenkins"
                        git config user.email "jenkins@example.com"

                        git -c http.extraheader="AUTHORIZATION: basic \\$AUTH" fetch origin main
                        git -c http.extraheader="AUTHORIZATION: basic \\$AUTH" fetch origin feature/config-update

                        git checkout -B feature/config-update origin/feature/config-update
                    """
                }
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.ENV_VERSION?.trim()) {
                        error('ENV_VERSION cannot be empty')
                    }

                    if (!(params.ENV_REPLICAS ==~ /[1-9][0-9]*/)) {
                        error('ENV_REPLICAS must be a positive integer')
                    }

                    env.SELECTED_ENV = params.ENVIRONMENT
                    env.SELECTED_NODE = params.NODE
                    env.NEW_VERSION = params.ENV_VERSION.trim()

                    echo "Environment: ${env.SELECTED_ENV}"
                    echo "Node: ${env.SELECTED_NODE}"
                    echo "Version: ${env.NEW_VERSION}"
                }
            }
        }

        stage('Update Configuration JSON') {
            steps {
                withEnv([
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_NODE_REGION=${params.NODE_REGION}",
                    "CONFIG_NODE_AZ=${params.NODE_AZ}"
                ]) {
                    sh """
                        set -eu

                        python3 - <<'PY'
import json
import os

env_name = os.environ["SELECTED_ENV"]
node_name = os.environ["SELECTED_NODE"]

env_file = "environment/" + env_name + ".json"
node_file = "node/" + node_name + ".json"

with open(env_file, encoding="utf-8") as f:
    env_data = json.load(f)

env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["APP_VERSION"]
env_data["replicas"] = int(os.environ["APP_REPLICAS"])
env_data["logLevel"] = os.environ["APP_LOGLEVEL"]

with open(env_file, "w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with open(node_file, encoding="utf-8") as f:
    node_data = json.load(f)

node_data["region"] = os.environ["CONFIG_NODE_REGION"]
node_data["availabilityZone"] = os.environ["CONFIG_NODE_AZ"]

if "nodeName" in node_data:
    node_data["nodeName"] = os.environ["CONFIG_NODE_NAME"]
if "name" in node_data:
    node_data["name"] = os.environ["CONFIG_NODE_NAME"]
if "nodeType" in node_data:
    node_data["nodeType"] = os.environ["CONFIG_NODE_TYPE"]
if "type" in node_data:
    node_data["type"] = os.environ["CONFIG_NODE_TYPE"]

with open(node_file, "w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated:", env_file)
print("Updated:", node_file)
PY
                    """
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                sh """
                    set -eu

                    if [ -f pom.xml ]; then
                        mvn -B clean package
                    else
                        echo "No pom.xml found; Maven compilation skipped."
                    fi
                """
            }
        }

        stage('Validate JSON and Review Changes') {
            steps {
                sh """
                    set -eu
                    git diff --check

                    python3 - <<'PY'
import json
import os

paths = [
    "environment/" + os.environ["SELECTED_ENV"] + ".json",
    "node/" + os.environ["SELECTED_NODE"] + ".json"
]

for path in paths:
    with open(path, encoding="utf-8") as f:
        json.load(f)
    print("Valid JSON:", path)
PY

                    git diff -- environment node
                """
            }
        }

        stage('Commit Changes') {
            steps {
                sh """
                    set -eu

                    git add "environment/\\$SELECTED_ENV.json"
                    git add "node/\\$SELECTED_NODE.json"

                    if git diff --cached --quiet; then
                        echo "No configuration changes to commit."
                        exit 1
                    fi

                    git commit -m "Update \\$SELECTED_ENV/\\$SELECTED_NODE to \\$NEW_VERSION"
                """
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        AUTH=\\$(printf '%s' "\\$GITHUB_USER:\\$GITHUB_TOKEN" | base64 | tr -d '\\\\n')

                        git -c http.extraheader="AUTHORIZATION: basic \\$AUTH" \
                            push origin HEAD:refs/heads/feature/config-update
                    """
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: """
                                set -eu
                                set +x

                                curl -fsS -G \
                                  -H "Authorization: Bearer \\$GITHUB_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "X-GitHub-Api-Version: 2022-11-28" \
                                  --data-urlencode "state=open" \
                                  --data-urlencode "head=chvkarthik-87:feature/config-update" \
                                  --data-urlencode "base=main" \
                                  "\\$GITHUB_API/pulls" |
                                python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["number"] if d else "")'
                            """,
                            returnStdout: true
                        ).trim()

                        if (!env.PR_NUMBER) {
                            writeFile(
                                file: 'pr-payload.json',
                                text: groovy.json.JsonOutput.toJson([
                                    title: "Update ${env.SELECTED_ENV}/${env.SELECTED_NODE} to ${env.NEW_VERSION}",
                                    head: 'feature/config-update',
                                    base: 'main',
                                    body: "Automated update from Jenkins build ${env.BUILD_NUMBER}"
                                ])
                            )

                            env.PR_NUMBER = sh(
                                script: """
                                    set -eu
                                    set +x

                                    curl -fsS -X POST \
                                      -H "Authorization: Bearer \\$GITHUB_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "X-GitHub-Api-Version: 2022-11-28" \
                                      -H "Content-Type: application/json" \
                                      "\\$GITHUB_API/pulls" \
                                      --data-binary @pr-payload.json |
                                    python3 -c 'import json,sys; print(json.load(sys.stdin)["number"])'
                                """,
                                returnStdout: true
                            ).trim()
                        }

                        echo "Pull request number: ${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Automatic PR Merge') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        API="\\$GITHUB_API/pulls/\\$PR_NUMBER"
                        ATTEMPT=1
                        MAX_ATTEMPTS=6
                        MERGEABLE="null"

                        while [ "\\$ATTEMPT" -le "\\$MAX_ATTEMPTS" ]; do
                            echo "Checking PR #\\$PR_NUMBER, attempt \\$ATTEMPT/\\$MAX_ATTEMPTS"

                            curl -fsS \
                              -H "Authorization: Bearer \\$GITHUB_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "\\$API" > pr-status.json

                            STATE=\\$(python3 -c 'import json; print(json.load(open("pr-status.json")).get("state",""))')
                            MERGED=\\$(python3 -c 'import json; print(str(json.load(open("pr-status.json")).get("merged",False)).lower())')
                            DRAFT=\\$(python3 -c 'import json; print(str(json.load(open("pr-status.json")).get("draft",False)).lower())')
                            MERGEABLE=\\$(python3 -c 'import json; p=json.load(open("pr-status.json")); v=p.get("mergeable"); print("null" if v is None else str(v).lower())')

                            echo "PR state: \\$STATE"
                            echo "Merged: \\$MERGED"
                            echo "Draft: \\$DRAFT"
                            echo "Mergeable: \\$MERGEABLE"

                            if [ "\\$MERGED" = "true" ]; then
                                echo "PR is already merged."
                                exit 0
                            fi

                            if [ "\\$STATE" != "open" ]; then
                                echo "ERROR: PR is not open."
                                exit 1
                            fi

                            if [ "\\$DRAFT" = "true" ]; then
                                echo "ERROR: PR is still a draft."
                                exit 1
                            fi

                            if [ "\\$MERGEABLE" = "true" ]; then
                                break
                            fi

                            if [ "\\$MERGEABLE" = "false" ]; then
                                echo "ERROR: PR has conflicts or is not mergeable."
                                exit 1
                            fi

                            if [ "\\$ATTEMPT" -lt "\\$MAX_ATTEMPTS" ]; then
                                echo "Mergeability is not ready; waiting 10 seconds."
                                sleep 10
                            fi

                            ATTEMPT=\\$((ATTEMPT + 1))
                        done

                        if [ "\\$MERGEABLE" != "true" ]; then
                            echo "ERROR: GitHub mergeability stayed unknown after retries."
                            exit 1
                        fi

                        HTTP_CODE=\\$(curl -sS \
                          -o merge-response.json \
                          -w '%{http_code}' \
                          -X PUT \
                          -H "Authorization: Bearer \\$GITHUB_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -H "Content-Type: application/json" \
                          "\\$API/merge" \
                          -d '{"merge_method":"squash"}')

                        cat merge-response.json
                        echo
                        echo "HTTP status: \\$HTTP_CODE"

                        if [ "\\$HTTP_CODE" != "200" ]; then
                            echo "ERROR: GitHub rejected the merge. Check token permissions and branch protection."
                            exit 1
                        fi

                        python3 - <<'PY'
import json

with open("merge-response.json", encoding="utf-8") as f:
    result = json.load(f)

if not result.get("merged"):
    raise SystemExit("GitHub did not confirm a successful merge.")

print("PR merged successfully:", result.get("sha"))
PY
                    """
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        AUTH=\\$(printf '%s' "\\$GITHUB_USER:\\$GITHUB_TOKEN" | base64 | tr -d '\\\\n')

                        git -c http.extraheader="AUTHORIZATION: basic \\$AUTH" fetch origin main

                        git show "origin/main:environment/\\$SELECTED_ENV.json" > verified-environment.json
                        git show "origin/main:node/\\$SELECTED_NODE.json" > verified-node.json

                        python3 - <<'PY'
import json
for path in ("verified-environment.json", "verified-node.json"):
    with open(path, encoding="utf-8") as f:
        json.load(f)
    print("Verified:", path)
PY
                    """
                }
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        AUTH=\\$(printf '%s' "\\$GITHUB_USER:\\$GITHUB_TOKEN" | base64 | tr -d '\\\\n')
                        git -c http.extraheader="AUTHORIZATION: basic \\$AUTH" fetch origin main

                        rm -rf artifact config-artifact.zip
                        mkdir -p artifact/environment artifact/node

                        git show "origin/main:environment/\\$SELECTED_ENV.json" \
                          > "artifact/environment/\\$SELECTED_ENV.json"

                        git show "origin/main:node/\\$SELECTED_NODE.json" \
                          > "artifact/node/\\$SELECTED_NODE.json"

                        zip -r config-artifact.zip artifact
                    """
                }

                archiveArtifacts(
                    artifacts: 'config-artifact.zip',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh """
                        set -eu
                        set +x

                        curl -fsS \
                          -u "\\$NEXUS_USER:\\$NEXUS_PASSWORD" \
                          -X POST \
                          "\\$NEXUS_URL/service/rest/v1/components?repository=\\$NEXUS_REPOSITORY" \
                          -F "maven2.groupId=\\$GROUP_ID" \
                          -F "maven2.artifactId=\\$ARTIFACT_ID" \
                          -F "maven2.version=\\$NEW_VERSION" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@config-artifact.zip" \
                          -F "maven2.asset1.extension=zip"
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the first failed stage in
