pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )
        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node configuration'
        )

        string(name: 'ENV_APPNAME', defaultValue: 'myapp',
               description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '',
               description: 'Enter NEW version, e.g. 2.3.4')
        string(name: 'ENV_REPLICAS', defaultValue: '1',
               description: 'Replica count')
        string(name: 'ENV_LOGLEVEL', defaultValue: 'INFO',
               description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01',
               description: 'Node name')
        string(name: 'NODE_TYPE', defaultValue: 'worker',
               description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1',
               description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a',
               description: 'Availability zone')
    }

    environment {
        REPO_URL = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        FEATURE_BRANCH = 'feature/config-update'
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPO = 'maven-releases'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main', url: "${REPO_URL}"
                sh '''
                    set -eu
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"
                    git fetch origin main
                '''
            }
        }

        stage('Read Current Version') {
            steps {
                script {
                    env.OLD_VERSION = sh(
                        script: """
                            git show origin/main:environment/${params.ENVIRONMENT}.json |
                            python3 -c "import json,sys; print(json.load(sys.stdin)['version'])"
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Node: ${params.NODE}"
                    echo "Current version in main: ${env.OLD_VERSION}"
                    echo "Requested version: ${params.ENV_VERSION}"

                    if (!params.ENV_VERSION?.trim()) {
                        error("ENV_VERSION is required. Enter a new version.")
                    }

                    if (!(params.ENV_VERSION ==~ /^[0-9]+\\.[0-9]+\\.[0-9]+$/)) {
                        error("Use version format X.Y.Z, for example 2.3.4")
                    }

                    if (params.ENV_VERSION.trim() == env.OLD_VERSION) {
                        error("New version must differ from current version ${env.OLD_VERSION}")
                    }
                }
            }
        }

        stage('Checkout Existing Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Authenticate Git fetch/push without putting the token
                        # in the repository URL.
                        AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')
                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            fetch origin feature/config-update

                        # Reuse the existing feature branch, not a new branch.
                        git checkout -B feature/config-update \
                            refs/remotes/origin/feature/config-update

                        git status --short
                    '''
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                withEnv([
                    "SEL_ENV=${params.ENVIRONMENT}",
                    "SEL_NODE=${params.NODE}",
                    "APP_NAME=${params.ENV_APPNAME}",
                    "NEW_VERSION=${params.ENV_VERSION}",
                    "REPLICAS=${params.ENV_REPLICAS}",
                    "LOG_LEVEL=${params.ENV_LOGLEVEL}",
                    "NODE_NAME_VALUE=${params.NODE_NAME}",
                    "NODE_TYPE_VALUE=${params.NODE_TYPE}",
                    "NODE_REGION_VALUE=${params.NODE_REGION}",
                    "NODE_AZ_VALUE=${params.NODE_AZ}"
                ]) {
                    sh '''
                        set -eu

                        python3 <<'PY'
import json
import os

env_file = f"environment/{os.environ['SEL_ENV']}.json"
node_file = f"node/{os.environ['SEL_NODE']}.json"

def load_json(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save_json(path, data):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\\n")

# Update selected environment configuration
env_data = load_json(env_file)
env_data["appName"] = os.environ["APP_NAME"]
env_data["version"] = os.environ["NEW_VERSION"]
env_data["replicas"] = int(os.environ["REPLICAS"])
env_data["logLevel"] = os.environ["LOG_LEVEL"]
save_json(env_file, env_data)

# Update selected node configuration, preserving other existing keys
node_data = load_json(node_file)
node_data["name"] = os.environ["NODE_NAME_VALUE"]
node_data["type"] = os.environ["NODE_TYPE_VALUE"]
node_data["region"] = os.environ["NODE_REGION_VALUE"]
node_data["availabilityZone"] = os.environ["NODE_AZ_VALUE"]

# Also maintain these keys if the repository uses the legacy names
for key, value in {
    "nodeName": os.environ["NODE_NAME_VALUE"],
    "nodeType": os.environ["NODE_TYPE_VALUE"],
    "nodeRegion": os.environ["NODE_REGION_VALUE"],
    "nodeAZ": os.environ["NODE_AZ_VALUE"]
}.items():
    if key in node_data:
        node_data[key] = value

save_json(node_file, node_data)

print("Updated:", env_file)
print("Updated:", node_file)
PY

                        git diff --check
                        git diff -- environment node
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    if (fileExists('sonar-project.properties')) {
                        def scannerHome = tool 'SonarQube-Scanner'
                        withSonarQubeEnv('SonarQube-Server') {
                            sh "\"${scannerHome}/bin/sonar-scanner\""
                        }
                    } else {
                        echo 'No sonar-project.properties found; skipping SonarQube analysis.'
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        withEnv(["PATH+MAVEN=${tool 'Maven-3'}/bin"]) {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'No pom.xml found; skipping Maven compilation.'
                    }
                }
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    sh '''
                        set -eu
                        git add "environment/${SEL_ENV:-dev}.json" 2>/dev/null || true
                    '''
                    // Stage only the files selected by the parameters.
                    sh """
                        set -eu
                        git add 'environment/${params.ENVIRONMENT}.json'
                        git add 'node/${params.NODE}.json'

                        if git diff --cached --quiet; then
                            echo "No changes to commit."
                        else
                            git commit -m "Update ${params.ENVIRONMENT}/${params.NODE} configuration to ${params.ENV_VERSION}"
                        fi
                    """
                }
            }
        }

        stage('Push Existing Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')
                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            push origin HEAD:refs/heads/feature/config-update
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: '''
                                set -eu
                                set +x
                                curl -fsS -G \
                                  -H "Authorization: Bearer $GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  --data-urlencode "state=open" \
                                  --data-urlencode "head=chvkarthik-87:feature/config-update" \
                                  --data-urlencode "base=main" \
                                  "$GITHUB_API/pulls" |
                                python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['number'] if d else '')"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.PR_NUMBER) {
                            env.PR_NUMBER = sh(
                                script: '''
                                    set -eu
                                    set +x
                                    curl -fsS -X POST \
                                      -H "Authorization: Bearer $GH_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      "$GITHUB_API/pulls" \
                                      -d '{"title":"Jenkins configuration update","head":"feature/config-update","base":"main","body":"Automated configuration update from Jenkins."}' |
                                    python3 -c "import json,sys; print(json.load(sys.stdin)['number'])"
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        echo "Using Pull Request #${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Merge the PR. GitHub repository settings and token
                        # permissions must allow this operation.
                        curl -fsS -X PUT \
                          -H "Authorization: Bearer $GH_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          "$GITHUB_API/pulls/$PR_NUMBER/merge" \
                          -d '{"merge_method":"squash"}'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        AUTH=$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')
                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \
                            fetch origin main
                        git checkout -B main origin/main

                        python3 -c "import json; d=json.load(open('environment/${SEL_ENV:-dev}.json')); print('Merged version:', d['version'])"
                        git status --short
                    '''
                }
            }
        }

        stage('Create ZIP Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p artifacts
                    zip -j "artifacts/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.zip" \
                        "environment/${ENVIRONMENT}.json" \
                        "node/${NODE}.json"
                    ls -lh artifacts/
                '''
                archiveArtifacts artifacts: 'artifacts/*.zip', fingerprint: true
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        FILE="artifacts/config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.zip"
                        DEST="$NEXUS_URL/repository/$NEXUS_REPO/com/chvkarthik/config-automation/$ENV_VERSION/$(basename "$FILE")"

                        curl --fail --show-error \
                          --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                          --upload-file "$FILE" \
                          "$DEST"

                        echo "Artifact uploaded to Nexus."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the first error in Console Output.'
        }
        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
