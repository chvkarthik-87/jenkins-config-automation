pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '',
            description: 'Enter NEW version. Old version is read automatically from the selected environment JSON.'
        )

        string(name: 'ENV_APPNAME', defaultValue: 'myapp',
               description: 'Application name')
        string(name: 'ENV_REPLICAS', defaultValue: '1',
               description: 'Number of replicas')
        string(name: 'ENV_LOGLEVEL', defaultValue: 'INFO',
               description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01',
               description: 'Node name')
        string(name: 'NODE_TYPE', defaultValue: 'worker',
               description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1',
               description: 'Node region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a',
               description: 'Availability zone')
    }

    environment {
        GITHUB_REPO = 'chvkarthik-87/jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'
        NEXUS_URL = 'http://172.31.36.177:8081'
        NEXUS_REPO = 'maven-releases'
    }

    stages {
        stage('Show Parameters') {
            steps {
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Node: ${params.NODE}"
                echo "Requested new version: ${params.ENV_VERSION}"
            }
        }

        stage('Checkout Main') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-jenkins-token',
                    url: "https://github.com/${GITHUB_REPO}.git"

                sh '''
                    git fetch origin main
                    git checkout -B main origin/main
                '''
            }
        }

        stage('Read Old Version and Validate New Version') {
            steps {
                script {
                    def envFile =
                        "environment/${params.ENVIRONMENT}.json"

                    if (!fileExists(envFile)) {
                        error("Environment file not found: ${envFile}")
                    }

                    def config = readJSON(file: envFile)

                    if (config.version == null) {
                        error("Version field missing in ${envFile}")
                    }

                    env.LAST_VERSION = config.version.toString()
                    env.NEW_VERSION = params.ENV_VERSION.trim()

                    echo '===================================='
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Old Version : ${env.LAST_VERSION}"
                    echo "New Version : ${env.NEW_VERSION}"
                    echo '===================================='

                    if (!env.NEW_VERSION) {
                        error('Enter the new version in Build with Parameters.')
                    }

                    if (!(env.NEW_VERSION ==~ /^\d+\.\d+\.\d+$/)) {
                        error('Enter version in format X.Y.Z, for example 2.0.3')
                    }

                    if (env.LAST_VERSION == env.NEW_VERSION) {
                        error("New version is already ${env.LAST_VERSION}. Enter another version.")
                    }

                    def oldParts = env.LAST_VERSION.tokenize('.')
                    def newParts = env.NEW_VERSION.tokenize('.')

                    if (oldParts.size() == 3 &&
                        oldParts.every { it ==~ /^\d+$/ }) {
                        def oldNums = oldParts.collect { it.toInteger() }
                        def newNums = newParts.collect { it.toInteger() }

                        def comparison = 0
                        for (int i = 0; i < 3; i++) {
                            if (newNums[i] > oldNums[i]) {
                                comparison = 1
                                break
                            }
                            if (newNums[i] < oldNums[i]) {
                                comparison = -1
                                break
                            }
                        }

                        if (comparison < 0) {
                            error("Version downgrade blocked: current ${env.LAST_VERSION}, requested ${env.NEW_VERSION}")
                        }
                    }
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                script {
                    if (!(params.ENV_REPLICAS ==~ /^[0-9]+$/) ||
                        params.ENV_REPLICAS.toInteger() < 1) {
                        error('ENV_REPLICAS must be a positive integer.')
                    }

                    def envFile =
                        "environment/${params.ENVIRONMENT}.json"
                    def nodeFile =
                        "node/${params.NODE}.json"

                    if (!fileExists(nodeFile)) {
                        error("Node file not found: ${nodeFile}")
                    }

                    def envJson = readJSON(file: envFile)
                    envJson.appName = params.ENV_APPNAME
                    envJson.version = env.NEW_VERSION
                    envJson.replicas = params.ENV_REPLICAS.toInteger()
                    envJson.logLevel = params.ENV_LOGLEVEL

                    writeJSON(
                        file: envFile,
                        json: envJson,
                        pretty: 4
                    )

                    def nodeJson = readJSON(file: nodeFile)
                    nodeJson.name = params.NODE_NAME
                    nodeJson.type = params.NODE_TYPE
                    nodeJson.region = params.NODE_REGION
                    nodeJson.availabilityZone = params.NODE_AZ

                    writeJSON(
                        file: nodeFile,
                        json: nodeJson,
                        pretty: 4
                    )

                    echo 'Environment and node JSON updated.'
                }
            }
        }

        stage('Validate JSON') {
            steps {
                sh '''
                    set -eu
                    python3 -m json.tool "environment/${ENVIRONMENT}.json" > /dev/null
                    python3 -m json.tool "node/${NODE}.json" > /dev/null
                    echo "JSON validation successful"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube-Server') {
                    script {
                        def scannerHome = tool 'SonarQube-Scanner'

                        sh """
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=environment,node \
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    set -eu
                    git config user.name "Jenkins Automation"
                    git config user.email "jenkins@example.com"

                    git checkout -B "$FEATURE_BRANCH"
                    git add environment/ node/
                    git diff --cached --check
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    def status = sh(
                        script: 'git diff --cached --quiet',
                        returnStatus: true
                    )

                    if (status == 0) {
                        error('No changes detected in selected JSON files.')
                    }

                    if (status != 1) {
                        error('Could not check staged changes.')
                    }
                }

                sh '''
                    git commit -m "Update ${ENVIRONMENT}/${NODE} to ${NEW_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        ASKPASS_FILE=$(mktemp)
                        trap 'rm -f "$ASKPASS_FILE"' EXIT

                        cat > "$ASKPASS_FILE" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GIT_USER" ;;
  *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
  *) exit 1 ;;
esac
EOF
                        chmod 700 "$ASKPASS_FILE"

                        export GIT_ASKPASS="$ASKPASS_FILE"
                        export GIT_TERMINAL_PROMPT=0

                        git push -f \
                          "https://github.com/${GITHUB_REPO}.git" \
                          "HEAD:${FEATURE_BRANCH}"
                    '''
                }
            }
        }

        stage('Create or Find Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    script {
                        def existingPR = sh(
                            script: '''
                                set -eu
                                RESPONSE=$(mktemp)
                                trap 'rm -f "$RESPONSE"' EXIT

                                CODE=$(curl -sS -o "$RESPONSE" -w '%{http_code}' \
                                  -H "Authorization: Bearer $GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=chvkarthik-87%3A${FEATURE_BRANCH}&base=main")

                                if [ "$CODE" != "200" ]; then
                                    cat "$RESPONSE"
                                    echo "PR lookup failed. HTTP $CODE"
                                    exit 1
                                fi

                                python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d[0]["number"] if d else "")' "$RESPONSE"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (existingPR) {
                            env.PR_NUMBER = existingPR
                            echo "Existing PR: #${env.PR_NUMBER}"
                        } else {
                            def newPR = sh(
                                script: '''
                                    set -eu
                                    RESPONSE=$(mktemp)
                                    trap 'rm -f "$RESPONSE"' EXIT

                                    PAYLOAD=$(python3 -c 'import json,os; print(json.dumps({"title":"Automated configuration update","head":os.environ["FEATURE_BRANCH"],"base":"main","body":"Created automatically by Jenkins."}))')

                                    CODE=$(curl -sS -o "$RESPONSE" -w '%{http_code}' \
                                      -X POST \
                                      -H "Authorization: Bearer $GH_TOKEN" \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "Content-Type: application/json" \
                                      "https://api.github.com/repos/${GITHUB_REPO}/pulls" \
                                      --data "$PAYLOAD")

                                    if [ "$CODE" != "201" ]; then
                                        cat "$RESPONSE"
                                        echo "PR creation failed. HTTP $CODE"
                                        exit 1
                                    fi

                                    python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["number"])' "$RESPONSE"
                                ''',
                                returnStdout: true
                            ).trim()

                            env.PR_NUMBER = newPR
                            echo "Created PR: #${env.PR_NUMBER}"
                        }

                        if (!(env.PR_NUMBER ==~ /^[0-9]+$/)) {
                            error('Invalid pull request number returned by GitHub.')
                        }
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        RESPONSE=$(mktemp)
                        trap 'rm -f "$RESPONSE"' EXIT

                        CODE=$(curl -sS -o "$RESPONSE" -w '%{http_code}' \
                          -X PUT \
                          -H "Authorization: Bearer $GH_TOKEN" \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                          --data '{"merge_method":"squash"}')

                        if [ "$CODE" != "200" ]; then
                            cat "$RESPONSE"
                            echo "PR merge failed. HTTP $CODE"
                            exit 1
                        fi

                        echo "Pull request merged successfully."
                    '''
                }
            }
        }

        stage('Verify Main') {
            steps {
                sh '''
                    set -eu
                    git fetch origin main
                    git checkout -B main origin/main

                    echo "Latest main commit:"
                    git log -1 --oneline

                    echo "Updated environment JSON:"
                    cat "environment/${ENVIRONMENT}.json"

                    echo "Updated node JSON:"
                    cat "node/${NODE}.json"
                '''
            }
        }

        stage('Package Configuration Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p build-artifact

                    tar -czf \
                      "build-artifact/config-${ENVIRONMENT}-${NODE}-${NEW_VERSION}.tar.gz" \
                      "environment/${ENVIRONMENT}.json" \
                      "node/${NODE}.json"

                    ls -lh build-artifact/
                '''

                archiveArtifacts(
                    artifacts: 'build-artifact/*.tar.gz',
                    fingerprint: true
                )
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        FILE="build-artifact/config-${ENVIRONMENT}-${NODE}-${NEW_VERSION}.tar.gz"
                        RESPONSE=$(mktemp)
                        trap 'rm -f "$RESPONSE"' EXIT

                        CODE=$(curl -sS -o "$RESPONSE" -w '%{http_code}' \
                          -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                          -X POST \
                          "${NEXUS_URL}/service/rest/v1/components?repository=${NEXUS_REPO}" \
                          -F "maven2.groupId=com.chvkarthik.config" \
                          -F "maven2.artifactId=config-${ENVIRONMENT}-${NODE}" \
                          -F "maven2.version=${NEW_VERSION}" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@${FILE}" \
                          -F "maven2.asset1.extension=tar.gz")

                        if [ "$CODE" != "204" ] &&
                           [ "$CODE" != "201" ] &&
                           [ "$CODE" != "200" ]; then
                            cat "$RESPONSE"
                            echo "Nexus upload failed. HTTP $CODE"
                            exit 1
                        fi

                        echo "Artifact uploaded to Nexus successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
            echo "Environment: ${params.ENVIRONMENT}"
            echo "Node: ${params.NODE}"
            echo "Old version: ${env.LAST_VERSION}"
            echo "New version: ${env.NEW_VERSION}"
            echo "Pull request: ${env.PR_NUMBER}"
        }

        failure {
            echo 'Pipeline failed. Check Console Output for the first error.'
        }
    }
}
