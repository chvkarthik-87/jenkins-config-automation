pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Node configuration')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '2.0.0', description: 'Application version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replica count')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        GITHUB_OWNER = 'chvkarthik-87'
        REPO_NAME = 'jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'

        SONAR_PROJECT_KEY = 'jenkins-config-automation'

        NEXUS_URL = 'http://98.83.162.0:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        ARTIFACT_GROUP = 'com.chvkarthik.config'
        ARTIFACT_NAME = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout Main') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/chvkarthik-87/jenkins-config-automation.git'

                sh 'git status --short'
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" fetch origin main
                        git checkout -B "$FEATURE_BRANCH" origin/main

                        git config user.name "$GH_USER"
                        git config user.email "$GH_USER@users.noreply.github.com"
                    '''
                }
            }
        }

        stage('Update Selected JSON Files') {
            steps {
                writeFile file: 'update_config.py', text: '''
import json
import os
from pathlib import Path

env_name = os.environ["ENVIRONMENT"]
node_name = os.environ["NODE"]

env_file = Path("environment") / (env_name + ".json")
node_file = Path("node") / (node_name + ".json")

for path in (env_file, node_file):
    if not path.is_file():
        raise SystemExit("Missing required file: " + str(path))

def load_object(path):
    with path.open(encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict):
        raise ValueError(str(path) + " must contain a JSON object")
    return data

env_data = load_object(env_file)
node_data = load_object(node_file)

replicas = int(os.environ["ENV_REPLICAS"])
if replicas < 1:
    raise ValueError("ENV_REPLICAS must be at least 1")

env_data["appName"] = os.environ["ENV_APPNAME"]
env_data["version"] = os.environ["ENV_VERSION"]
env_data["replicas"] = replicas
env_data["logLevel"] = os.environ["ENV_LOGLEVEL"]

node_data["name"] = os.environ["NODE_NAME"]
node_data["type"] = os.environ["NODE_TYPE"]
node_data["region"] = os.environ["NODE_REGION"]
node_data["availabilityZone"] = os.environ["NODE_AZ"]

with env_file.open("w", encoding="utf-8") as f:
    json.dump(env_data, f, indent=2)
    f.write("\\n")

with node_file.open("w", encoding="utf-8") as f:
    json.dump(node_data, f, indent=2)
    f.write("\\n")

print("Updated", env_file)
print("Updated", node_file)
'''

                sh 'python3 update_config.py'
            }
        }

        stage('Validate JSON') {
            steps {
                writeFile file: 'validate_json.py', text: '''
import json
from pathlib import Path

files = list(Path("environment").glob("*.json"))
files += list(Path("node").glob("*.json"))

if not files:
    raise SystemExit("No JSON configuration files found")

for path in files:
    with path.open(encoding="utf-8") as f:
        json.load(f)
    print("VALID:", path)
'''

                sh 'python3 validate_json.py'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        withEnv(["SCANNER_HOME=${scannerHome}"]) {
                            sh '''
                                set -eu

                                "$SCANNER_HOME/bin/sonar-scanner" \
                                  -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                  -Dsonar.projectName=jenkins-config-automation \
                                  -Dsonar.sources=environment,node
                            '''
                        }
                    }
                }
            }
        }

        stage('Maven Compilation') {
            steps {
                script {
                    if (fileExists('pom.xml')) {
                        def mavenHome = tool 'Maven-3'

                        withEnv(["PATH+MAVEN=${mavenHome}/bin"]) {
                            sh 'mvn -B clean package'
                        }
                    } else {
                        echo 'No pom.xml found. Skipping Maven for this JSON configuration repository.'
                    }
                }
            }
        }

        stage('Commit and Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        git add "environment/$ENVIRONMENT.json" "node/$NODE.json"

                        if ! git diff --cached --quiet; then
                            git commit -m "Update $ENVIRONMENT and $NODE configuration"
                        else
                            echo "No configuration changes to commit."
                        fi

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                            push origin "HEAD:$FEATURE_BRANCH"
                    '''
                }
            }
        }

        stage('Create or Reuse Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    writeFile file: 'manage_pr.py', text: '''
import json
import os
import urllib.parse
import urllib.request

owner = os.environ["GITHUB_OWNER"]
repo = os.environ["REPO_NAME"]
branch = os.environ["FEATURE_BRANCH"]
token = os.environ["GH_TOKEN"]

base = "https://api.github.com/repos/" + owner + "/" + repo

def api(path, method="GET", body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=30) as response:
        raw = response.read()
        return json.loads(raw) if raw else {}

query = urllib.parse.urlencode({
    "state": "open",
    "head": owner + ":" + branch,
    "base": "main"
})

pulls = api("/pulls?" + query)

if pulls:
    pr = pulls[0]
    print("Reusing open pull request:", pr["number"])
else:
    pr = api("/pulls", "POST", {
        "title": "Automated configuration update",
        "head": branch,
        "base": "main",
        "body": "Created automatically by Jenkins."
    })
    print("Created pull request:", pr["number"])

with open("pr-number.txt", "w") as f:
    f.write(str(pr["number"]))
'''

                    sh 'python3 manage_pr.py'
                }
            }
        }

        stage('Automatically Merge Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    writeFile file: 'merge_pr.py', text: '''
import json
import os
import time
import urllib.error
import urllib.request

owner = os.environ["GITHUB_OWNER"]
repo = os.environ["REPO_NAME"]
token = os.environ["GH_TOKEN"]

with open("pr-number.txt") as f:
    number = f.read().strip()

base = "https://api.github.com/repos/" + owner + "/" + repo

def request(path, method="GET", body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw = response.read()
            return response.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            detail = json.loads(raw)
        except Exception:
            detail = {"message": raw}
        return e.code, detail

for attempt in range(1, 11):
    status, pr = request("/pulls/" + number)

    if status != 200:
        raise SystemExit("Cannot read PR: " + json.dumps(pr))

    if pr.get("merged"):
        print("Pull request is already merged.")
        break

    if pr.get("state") != "open":
        raise SystemExit("Pull request is not open: " + pr.get("state", "unknown"))

    mergeable = pr.get("mergeable")

    if mergeable is False:
        raise SystemExit("PR has merge conflicts. Resolve them before merging.")

    if mergeable is None:
        print("GitHub is calculating mergeability. Attempt", attempt)
        time.sleep(5)
        continue

    status, result = request(
        "/pulls/" + number + "/merge",
        "PUT",
        {"merge_method": "squash"}
    )

    if status == 200 and result.get("merged"):
        print("Pull request merged successfully.")
        break

    print("Merge attempt response:", status, json.dumps(result))

    if status not in (405, 409, 422):
        raise SystemExit("GitHub merge request failed.")

    time.sleep(5)
else:
    raise SystemExit(
        "Automatic merge did not finish. Check branch protection, required "
        "reviews/checks, conflicts, and GitHub token permissions."
    )

status, pr = request("/pulls/" + number)
if status != 200 or not pr.get("merged"):
    raise SystemExit("Could not verify that the pull request was merged.")
'''

                    sh 'python3 merge_pr.py'
                }
            }
        }

        stage('Checkout Updated Main') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        AUTH_HEADER="$(printf '%s' "$GH_USER:$GH_TOKEN" | base64 | tr -d '\\n')"

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" fetch origin main
                        git checkout -B main origin/main

                        git log -1 --oneline
                    '''
                }
            }
        }

        stage('Package Artifact') {
            steps {
                writeFile file: 'package_config.py', text: '''
import os
import zipfile
from pathlib import Path

env_file = Path("environment") / (os.environ["ENVIRONMENT"] + ".json")
node_file = Path("node") / (os.environ["NODE"] + ".json")

for path in (env_file, node_file):
    if not path.is_file():
        raise SystemExit("Missing configuration on main: " + str(path))

with zipfile.ZipFile("config-artifact.zip", "w", zipfile.ZIP_DEFLATED) as archive:
    archive.write(env_file, str(env_file))
    archive.write(node_file, str(node_file))

print("Created config-artifact.zip")
'''

                sh 'python3 package_config.py'
                archiveArtifacts artifacts: 'config-artifact.zip', fingerprint: true
            }
        }

        stage('Upload to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-admin-new',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    withEnv(["UPLOAD_VERSION=${params.ENV_VERSION}-${env.BUILD_NUMBER}"]) {
                        sh '''
                            set -eu

                            curl --fail-with-body -sS \
                              -u "$NEXUS_USER:$NEXUS_PASSWORD" \
                              -X POST \
                              "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                              -F "maven2.groupId=$ARTIFACT_GROUP" \
                              -F "maven2.artifactId=$ARTIFACT_NAME" \
                              -F "maven2.version=$UPLOAD_VERSION" \
                              -F "maven2.asset1=@config-artifact.zip" \
                              -F "maven2.asset1.extension=zip"

                            echo "Artifact uploaded to Nexus."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the first failed stage in Console Output.'
        }
        always {
            echo 'Jenkins pipeline finished.'
        }
    }
}
