pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select node configuration'
        )

        string(
            name: 'ENV_APPNAME',
            defaultValue: 'myapp',
            description: 'Application name'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '2.0.0',
            description: 'New application version'
        )

        string(
            name: 'ENV_REPLICAS',
            defaultValue: '1',
            description: 'Number of replicas'
        )

        string(
            name: 'ENV_LOGLEVEL',
            defaultValue: 'INFO',
            description: 'Log level'
        )

        string(
            name: 'NODE_NAME',
            defaultValue: 'node-01',
            description: 'Node name'
        )

        string(
            name: 'NODE_TYPE',
            defaultValue: 'worker',
            description: 'Node type'
        )

        string(
            name: 'NODE_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'NODE_AZ',
            defaultValue: 'us-east-1a',
            description: 'Availability zone'
        )
    }

    environment {
        FEATURE_BRANCH = 'feature/config-update'
        GITHUB_REPO = 'https://github.com/chvkarthik-87/jenkins-config-automation.git'
        NEXUS_URL = 'http://172.31.36.177:8081'
        NEXUS_REPOSITORY = 'maven-releases'
    }

    stages {

        stage('Show Parameters') {
            steps {
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Node        : ${params.NODE}"
                echo "App Name    : ${params.ENV_APPNAME}"
                echo "New Version : ${params.ENV_VERSION}"
                echo "Replicas    : ${params.ENV_REPLICAS}"
                echo "Log Level   : ${params.ENV_LOGLEVEL}"
                echo "Node Name   : ${params.NODE_NAME}"
                echo "Node Type   : ${params.NODE_TYPE}"
                echo "Region      : ${params.NODE_REGION}"
                echo "AZ          : ${params.NODE_AZ}"
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git fetch origin main
                    git checkout main
                    git reset --hard origin/main

                    git checkout -B "$FEATURE_BRANCH" origin/main

                    echo "Prepared feature branch: $FEATURE_BRANCH"
                '''
            }
        }

        stage('Get Last Updated Version') {
            steps {
                script {
                    def envFile =
                        "environment/${params.ENVIRONMENT}.json"

                    env.LAST_VERSION = sh(
                        script: """
                            sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' '${envFile}' | head -1
                        """,
                        returnStdout: true
                    ).trim()

                    if (!env.LAST_VERSION) {
                        error "Could not read version from ${envFile}"
                    }

                    echo "======================================"
                    echo "LAST UPDATED VERSION: ${env.LAST_VERSION}"
                    echo "NEW REQUESTED VERSION: ${params.ENV_VERSION}"
                    echo "======================================"

                    if (env.LAST_VERSION == params.ENV_VERSION) {
                        error "Version is unchanged: ${params.ENV_VERSION}"
                    }
                }
            }
        }

        stage('Confirm Version Update') {
            steps {
                script {
                    input(
                        message: """VERSION UPDATE CONFIRMATION

Environment: ${params.ENVIRONMENT}
Last updated version: ${env.LAST_VERSION}
New version: ${params.ENV_VERSION}

Continue with this version update?""",
                        ok: 'Confirm Version Update'
                    )

                    echo "Version update confirmed."
                }
            }
        }

        stage('Update JSON Files') {
            steps {
                sh '''
                    set -eu

                    ENV_FILE="environment/${ENVIRONMENT}.json"
                    NODE_FILE="node/${NODE}.json"

                    test -f "$ENV_FILE"
                    test -f "$NODE_FILE"

                    # Validate parameter formats before editing.
                    case "$ENV_REPLICAS" in
                        ''|*[!0-9]*)
                            echo "ERROR: Replicas must be a whole number."
                            exit 1
                            ;;
                    esac

                    # Update environment configuration.
                    sed -i -E \
                      's/^  "environment": "[^"]+",/  "environment": "'"$ENVIRONMENT"'",/' \
                      "$ENV_FILE"

                    sed -i -E \
                      's/^  "appName": "[^"]+",/  "appName": "'"$ENV_APPNAME"'",/' \
                      "$ENV_FILE"

                    sed -i -E \
                      's/^  "version": "[^"]+",/  "version": "'"$ENV_VERSION"'",/' \
                      "$ENV_FILE"

                    sed -i -E \
                      's/^  "replicas": [0-9]+,?/  "replicas": '"$ENV_REPLICAS"',/' \
                      "$ENV_FILE"

                    sed -i -E \
                      's/^  "logLevel": "[^"]+",/  "logLevel": "'"$ENV_LOGLEVEL"'",/' \
                      "$ENV_FILE"

                    # Update node configuration.
                    sed -i -E \
                      's/^  "environment": "[^"]+",/  "environment": "'"$NODE"'",/' \
                      "$NODE_FILE"

                    sed -i -E \
                      's/^  "nodeName": "[^"]+",/  "nodeName": "'"$NODE_NAME"'",/' \
                      "$NODE_FILE"

                    sed -i -E \
                      's/^  "nodeType": "[^"]+",/  "nodeType": "'"$NODE_TYPE"'",/' \
                      "$NODE_FILE"

                    sed -i -E \
                      's/^  "region": "[^"]+",/  "region": "'"$NODE_REGION"'",/' \
                      "$NODE_FILE"

                    sed -i -E \
                      's/^  "availabilityZone": "[^"]+",/  "availabilityZone": "'"$NODE_AZ"'",/' \
                      "$NODE_FILE"

                    echo "Updated environment JSON:"
                    cat "$ENV_FILE"

                    echo "Updated node JSON:"
                    cat "$NODE_FILE"
                '''
            }
        }

        stage('Validate JSON Files') {
            steps {
                sh '''
                    set -eu

                    python3 -m json.tool \
                      "environment/${ENVIRONMENT}.json" > /dev/null

                    python3 -m json.tool \
                      "node/${NODE}.json" > /dev/null

                    echo "Both JSON files are valid."
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    env.SONAR_SCANNER_HOME = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh '''
                            "$SONAR_SCANNER_HOME/bin/sonar-scanner" \
                              -Dsonar.projectKey=jenkins-config-automation \
                              -Dsonar.projectName=jenkins-config-automation \
                              -Dsonar.sources=.
                        '''
                    }
                }
            }
        }

        stage('Show Changes') {
            steps {
                sh '''
                    echo "Git status:"
                    git status --short

                    echo "Git diff:"
                    git diff
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    set -eu

                    git add environment/ node/

                    if git diff --cached --quiet; then
                        echo "No configuration changes found."
                        exit 1
                    fi

                    git commit -m "Update ${ENVIRONMENT} and ${NODE} configuration to version ${ENV_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        ASKPASS="$WORKSPACE/.git-askpass.sh"

                        trap 'rm -f "$ASKPASS"' EXIT

                        cat > "$ASKPASS" <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\\n' "$GIT_USERNAME" ;;
    *Password*) printf '%s\\n' "$GIT_PASSWORD" ;;
    *) exit 1 ;;
esac
EOF

                        chmod 700 "$ASKPASS"

                        GIT_ASKPASS="$ASKPASS" \
                        GIT_TERMINAL_PROMPT=0 \
                        git push \
                          "https://github.com/chvkarthik-87/jenkins-config-automation.git" \
                          "HEAD:refs/heads/$FEATURE_BRANCH" \
                          --force
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    script {
                        def prNumber = sh(
                            script: '''
                                curl -fsS \
                                  -u "$GIT_USERNAME:$GIT_PASSWORD" \
                                  -H "Accept: application/vnd.github+json" \
                                  "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls?head=chvkarthik-87:feature/config-update&base=main&state=open" \
                                | grep -m1 -E '"number"[[:space:]]*:' \
                                | grep -oE '[0-9]+' || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!prNumber) {
                            prNumber = sh(
                                script: '''
                                    curl -fsS \
                                      -u "$GIT_USERNAME:$GIT_PASSWORD" \
                                      -X POST \
                                      -H "Accept: application/vnd.github+json" \
                                      -H "Content-Type: application/json" \
                                      -d '{"title":"Automated configuration update","body":"Configuration update created by Jenkins","head":"feature/config-update","base":"main"}' \
                                      "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls" \
                                    | grep -m1 -E '"number"[[:space:]]*:' \
                                    | grep -oE '[0-9]+'
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        if (!prNumber) {
                            error "Could not find or create the GitHub Pull Request."
                        }

                        env.PR_NUMBER = prNumber
                        echo "Pull Request: #${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-jenkins-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Requesting merge for PR #${PR_NUMBER}"

                        HTTP_CODE=$(curl -sS \
                          -o "$WORKSPACE/merge-response.json" \
                          -w '%{http_code}' \
                          -u "$GIT_USERNAME:$GIT_PASSWORD" \
                          -X PUT \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          -d '{"merge_method":"merge","commit_title":"Automated configuration update"}' \
                          "https://api.github.com/repos/chvkarthik-87/jenkins-config-automation/pulls/${PR_NUMBER}/merge")

                        if [ "$HTTP_CODE" != "200" ]; then
                            echo "GitHub merge failed. HTTP: $HTTP_CODE"
                            cat "$WORKSPACE/merge-response.json"
                            exit 1
                        fi

                        echo "Pull Request merged successfully."
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                sh '''
                    set -eu

                    git fetch origin main
                    git checkout main
                    git reset --hard origin/main

                    echo "Updated environment JSON:"
                    cat "environment/${ENVIRONMENT}.json"

                    echo "Updated node JSON:"
                    cat "node/${NODE}.json"

                    echo "Latest main commit:"
                    git log -1 --oneline
                '''
            }
        }

        stage('Package Configuration Artifact') {
            steps {
                sh '''
                    set -eu

                    mkdir -p artifacts

                    ARTIFACT_NAME="config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz"

                    tar -czf "artifacts/$ARTIFACT_NAME" \
                      "environment/${ENVIRONMENT}.json" \
                      "node/${NODE}.json"

                    echo "Artifact created:"
                    ls -lh "artifacts/$ARTIFACT_NAME"
                '''
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-admin-new',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        ARTIFACT_NAME="config-${ENVIRONMENT}-${NODE}-${ENV_VERSION}.tar.gz"
                        ARTIFACT_FILE="$WORKSPACE/artifacts/$ARTIFACT_NAME"

                        test -f "$ARTIFACT_FILE"

                        echo "Uploading artifact to Nexus..."

                        HTTP_CODE=$(curl -sS \
                          -o "$WORKSPACE/nexus-upload-response.txt" \
                          -w '%{http_code}' \
                          -u "$NEXUS_USERNAME:$NEXUS_PASSWORD" \
                          -X POST \
                          "${NEXUS_URL}/service/rest/v1/components?repository=${NEXUS_REPOSITORY}" \
                          -F "maven2.groupId=com.chvkarthik.config" \
                          -F "maven2.artifactId=config-${ENVIRONMENT}-${NODE}" \
                          -F "maven2.version=${ENV_VERSION}" \
                          -F "maven2.generate-pom=true" \
                          -F "maven2.asset1=@${ARTIFACT_FILE}" \
                          -F "maven2.asset1.extension=tar.gz")

                        case "$HTTP_CODE" in
                            200|201|204)
                                echo "Nexus upload successful."
                                ;;
                            *)
                                echo "Nexus upload failed. HTTP: $HTTP_CODE"
                                cat "$WORKSPACE/nexus-upload-response.txt"
                                exit 1
                                ;;
                        esac

                        echo "Artifact: $ARTIFACT_NAME"
                        echo "Repository: $NEXUS_REPOSITORY"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "PIPELINE COMPLETED SUCCESSFULLY"
            echo "======================================"
            echo "Environment: ${params.ENVIRONMENT}"
            echo "Node: ${params.NODE}"
            echo "Previous version: ${env.LAST_VERSION}"
            echo "New version: ${params.ENV_VERSION}"
            echo "PR number: ${env.PR_NUMBER}"
            echo "Artifact uploaded to Nexus."
        }

        failure {
            echo "======================================"
            echo "PIPELINE FAILED"
            echo "======================================"
            echo "Check Console Output for the failed stage."
        }
    }
}
