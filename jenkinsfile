pipeline {
    agent any

    options {
        skipDefaultCheckout(false)
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select environment')
        choice(name: 'NODE', choices: ['dev', 'stage', 'uat', 'prod'], description: 'Select node configuration')

        string(name: 'ENV_APPNAME', defaultValue: 'myapp', description: 'Application name')
        string(name: 'ENV_VERSION', defaultValue: '3.0.1', description: 'New version; must be greater than current version')
        string(name: 'ENV_REPLICAS', defaultValue: '1', description: 'Replica count')
        choice(name: 'ENV_LOGLEVEL', choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'], description: 'Log level')

        string(name: 'NODE_NAME', defaultValue: 'node-01', description: 'Node name')
        choice(name: 'NODE_TYPE', choices: ['worker', 'master'], description: 'Node type')
        string(name: 'NODE_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'NODE_AZ', defaultValue: 'us-east-1a', description: 'Availability zone')
    }

    environment {
        GITHUB_API = 'https://api.github.com/repos/chvkarthik-87/jenkins-config-automation'
        FEATURE_BRANCH = 'feature/config-update'
        SONAR_PROJECT_KEY = 'jenkins-config-automation'
    }

    stages {
        stage('Show Parameters') {
            steps {
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Node        : ${params.NODE}"
                echo "App Name    : ${params.ENV_APPNAME}"
                echo "Version     : ${params.ENV_VERSION}"
                echo "Replicas    : ${params.ENV_REPLICAS}"
                echo "Log Level   : ${params.ENV_LOGLEVEL}"
                echo "Node Name   : ${params.NODE_NAME}"
                echo "Node Type   : ${params.NODE_TYPE}"
                echo "Region      : ${params.NODE_REGION}"
                echo "AZ          : ${params.NODE_AZ}"
            }
        }

        stage('Prepare Feature Branch') {
            steps {
                sh '''
                    set -eu
                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"
                    git fetch origin main
                    git checkout -B "$FEATURE_BRANCH" origin/main
                    echo "Current branch: $(git branch --show-current)"
                '''
            }
        }

        stage('Update JSON Files') {
            steps {
                sh '''
                    set -eu

                    ENV_FILE="environment/${ENVIRONMENT}.json"
                    NODE_FILE="node/${NODE}.json"

                    test -f "$ENV_FILE"
                    test -f "$NODE_FILE"

                    python3 - "$ENV_FILE" "$NODE_FILE" \
                      "$ENVIRONMENT" "$NODE" \
                      "$ENV_APPNAME" "$ENV_VERSION" "$ENV_REPLICAS" "$ENV_LOGLEVEL" \
                      "$NODE_NAME" "$NODE_TYPE" "$NODE_REGION" "$NODE_AZ" <<'PY'
import json
import re
import sys
from pathlib import Path

(env_path, node_path, env_name, node_name,
 app_name, new_version, replicas, log_level,
 configured_node_name, node_type, region, az) = sys.argv[1:]

def version_tuple(value):
    if not re.fullmatch(r'\\d+(\\.\\d+)*', value):
        raise ValueError(f"Invalid version: {value}")
    return tuple(int(x) for x in value.split('.'))

env_file = Path(env_path)
node_file = Path(node_path)

with env_file.open() as f:
    env_data = json.load(f)

with node_file.open() as f:
    node_data = json.load(f)

old_version = str(env_data.get("version", "0"))

if version_tuple(new_version) <= version_tuple(old_version):
    raise SystemExit(
        f"New version {new_version} must be greater than existing version {old_version}"
    )

if not re.fullmatch(r'\\d+', replicas):
    raise SystemExit("Replicas must be a whole number.")

env_data["environment"] = env_name
env_data["appName"] = app_name
env_data["version"] = new_version
env_data["replicas"] = int(replicas)
env_data["logLevel"] = log_level

node_data["environment"] = node_name
node_data["nodeName"] = configured_node_name
node_data["nodeType"] = node_type
node_data["region"] = region
node_data["availabilityZone"] = az
node_data["name"] = configured_node_name
node_data["type"] = node_type

with env_file.open("w") as f:
    json.dump(env_data, f, indent=4)
    f.write("\\n")

with node_file.open("w") as f:
    json.dump(node_data, f, indent=4)
    f.write("\\n")

print(f"Environment version: {old_version} -> {new_version}")
print(f"Updated: {env_path}")
print(f"Updated: {node_path}")
PY

                    python3 -m json.tool "$ENV_FILE" >/dev/null
                    python3 -m json.tool "$NODE_FILE" >/dev/null

                    echo "Updated Environment JSON:"
                    cat "$ENV_FILE"
                    echo "Updated Node JSON:"
                    cat "$NODE_FILE"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube-Scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            set -eu
                            '${scannerHome}/bin/sonar-scanner' \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName=${SONAR_PROJECT_KEY} \
                              -Dsonar.sources=environment,node \
                              -Dsonar.scm.disabled=false
                        """
                    }
                }
            }
        }

        stage('Show Changes') {
            steps {
                sh '''
                    echo "Git Status:"
                    git status --short
                    echo "Git Diff:"
                    git diff -- environment node
                '''
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    set -eu
                    git add "environment/${ENVIRONMENT}.json" "node/${NODE}.json"

                    if git diff --cached --quiet; then
                        echo "No JSON changes found."
                        exit 1
                    fi

                    git commit -m "Update ${ENVIRONMENT}/${NODE} to ${ENV_VERSION}"
                '''
            }
        }

        stage('Push Feature Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        AUTH=$(printf '%s:%s' "$GIT_USERNAME" "$GIT_PASSWORD" | base64 -w 0)

                        git -c "http.extraheader=AUTHORIZATION: basic $AUTH" \
                          push origin "HEAD:${FEATURE_BRANCH}" --force
                    '''
                }
            }
        }

        stage('Create or Get Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    script {
                        sh '''
                            set -eu

                            curl --fail --silent --show-error \
                              -u "$GIT_USERNAME:$GIT_PASSWORD" \
                              -H "Accept: application/vnd.github+json" \
                              "${GITHUB_API}/pulls?state=open&head=chvkarthik-87:${FEATURE_BRANCH}&base=main" \
                              -o existing-pr.json

                            python3 -c '
import json
with open("existing-pr.json") as f:
    prs = json.load(f)
print(prs[0]["number"] if prs else "")
' > pr-number.txt

                            PR_NUMBER=$(cat pr-number.txt)

                            if [ -z "$PR_NUMBER" ]; then
                                python3 -c '
import json
with open("pr-body.json", "w") as f:
    json.dump({
        "title": "Automated configuration update",
        "body": "Created automatically by Jenkins.",
        "head": "feature/config-update",
        "base": "main"
    }, f)
'

                                curl --fail --silent --show-error \
                                  -u "$GIT_USERNAME:$GIT_PASSWORD" \
                                  -X POST \
                                  -H "Accept: application/vnd.github+json" \
                                  -H "Content-Type: application/json" \
                                  --data-binary @pr-body.json \
                                  "${GITHUB_API}/pulls" \
                                  -o created-pr.json

                                python3 -c '
import json
with open("created-pr.json") as f:
    print(json.load(f)["number"])
' > pr-number.txt
                            fi

                            echo "Pull Request number: $(cat pr-number.txt)"
                        '''

                        env.PR_NUMBER = readFile('pr-number.txt').trim()

                        if (!env.PR_NUMBER) {
                            error('GitHub did not return a Pull Request number.')
                        }
                    }
                }
            }
        }

        stage('Check Pull Request') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        curl --fail --silent --show-error \
                          -u "$GIT_USERNAME:$GIT_PASSWORD" \
                          -H "Accept: application/vnd.github+json" \
                          "${GITHUB_API}/pulls/${PR_NUMBER}" \
                          -o pr-details.json

                        python3 -c '
import json
with open("pr-details.json") as f:
    pr = json.load(f)
print("PR state:", pr["state"])
print("PR mergeable:", pr.get("mergeable"))
if pr["state"] != "open":
    raise SystemExit("Pull Request is not open.")
'
                    '''
                }
            }
        }

        stage('Merge Pull Request Automatically') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''
                        set -eu

                        python3 - "$PR_NUMBER" <<'PY'
import json
import sys

with open("merge-body.json", "w") as f:
    json.dump({
        "commit_title": "Merge automated configuration update",
        "commit_message": "Merged by Jenkins pipeline",
        "merge_method": "squash"
    }, f)
PY

                        HTTP_CODE=$(curl --silent --show-error \
                          -u "$GIT_USERNAME:$GIT_PASSWORD" \
                          -X PUT \
                          -H "Accept: application/vnd.github+json" \
                          -H "Content-Type: application/json" \
                          --data-binary @merge-body.json \
                          -o merge-result.json \
                          -w '%{http_code}' \
                          "${GITHUB_API}/pulls/${PR_NUMBER}/merge")

                        cat merge-result.json
                        echo "GitHub merge HTTP status: $HTTP_CODE"

                        if [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
                            echo "Automatic merge failed. Check GitHub token permissions and branch protection."
                            exit 1
                        fi

                        python3 -c '
import json
with open("merge-result.json") as f:
    result = json.load(f)
if not result.get("merged"):
    raise SystemExit("GitHub did not confirm the merge.")
print("Merge confirmed:", result.get("message"))
'
                    '''
                }
            }
        }

        stage('Verify Main Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-jenkins-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_PASSWORD'
                )]) {
                    sh '''
                        set -eu

                        git fetch origin main
                        git show "origin/main:environment/${ENVIRONMENT}.json" > verify-env.json
                        git show "origin/main:node/${NODE}.json" > verify-node.json

                        python3 - "$ENV_VERSION" <<'PY'
import json
import sys

expected = sys.argv[1]

with open("verify-env.json") as f:
    env = json.load(f)

with open("verify-node.json") as f:
    node = json.load(f)

print("Main environment version:", env.get("version"))
print("Main node:", node.get("nodeName"))

if str(env.get("version")) != expected:
    raise SystemExit("Main branch version does not match requested version.")
PY
                    '''
                }
            }
        }

        stage('Archive Configuration Artifact') {
            steps {
                sh '''
                    set -eu
                    mkdir -p artifacts

                    python3 - "$ENVIRONMENT" "$NODE" "$ENV_VERSION" <<'PY'
import json
import sys
import zipfile
from pathlib import Path

environment, node, version = sys.argv[1:]
artifact = Path("artifacts/config-" + environment + "-" + node + "-" + version + ".zip")

with zipfile.ZipFile(artifact, "w", zipfile.ZIP_DEFLATED) as z:
    z.write("environment/" + environment + ".json")
    z.write("node/" + node + ".json")

print("Created artifact:", artifact)
PY
                '''
                archiveArtifacts artifacts: 'artifacts/*.zip', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'PIPELINE SUCCESS: JSON updated, SonarQube analysis completed, PR merged, main verified, artifact archived.'
        }

        failure {
            echo 'PIPELINE FAILED: Check the first failed stage in Console Output.'
        }

        always {
            sh 'rm -f existing-pr.json created-pr.json pr-number.txt pr-details.json merge-result.json pr-body.json merge-body.json verify-env.json verify-node.json || true'
        }
    }
}
